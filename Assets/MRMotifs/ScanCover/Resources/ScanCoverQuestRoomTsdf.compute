// ScanCover QuestRoom candidate: projective TSDF integration.
// Architecture and convergence policy adapted from QuestRoomScan
// (https://github.com/arghyasur1991/QuestRoomScan, MIT License).
#pragma kernel Clear
#pragma kernel Integrate
#pragma kernel Prune
#pragma kernel InitDilation
#pragma kernel DilationStep

RWTexture3D<float2> _Volume;
// Read-only diagnostic sidecar for the surface extractor.  It never feeds
// back into the production TSDF value or weight:
//   x = accepted writes close to the measured surface
//   y = integration ordinal of the most recent accepted free-space write
//   z = accepted writes in the rear truncation band
//   w = integration ordinal of the most recent direct-surface write
RWTexture3D<float4> _EvidenceVolume;
Texture2D<float4> _WorldPosition;
Texture2D<float4> _WorldNormal;
Texture2D<float4> _ObservationMeta;
// Dilation ping-pong textures for occlusion gating (QRS
// VolumeIntegration.compute DilationInit/DilationStep).
RWTexture2D<float4> _DilationSrc;
RWTexture2D<float4> _DilationDst;
// Rejection census (read-only diagnostic, never feeds back into fusion):
//   0=入射(过ndc/头排) 1=meta门 2=深度范围 3=零法线 4=遮挡门
//   5=后截断 6=facing门 7=种子质量 8=接受写入
RWStructuredBuffer<uint> _RejectStats;

int3 _VoxelCount;
float _VoxelSize;
float _TruncationDistance;
float _MinimumDepth;
float _MaximumDepth;
float _MinimumConfidence;
float _MinimumNormalDot;
float _BlendRate;
float _Stability;
float _WeightGrowth;
float _MaximumWeight;
float _EvidenceSurfaceBand;
int _EvidenceIntegrationOrdinal;
float4 _SourceSize;
float4 _EyeWorldPosition;
float4x4 _WorldToClip;
float4x4 _VolumeLocalToWorld;
// Occlusion gating parameters (QRS VolumeIntegration.compute).
int _DilationStepSize;
float _DilationFocalLength;
float _DepthDisparityThreshold;
int _EnableOcclusionGating;

// QRS head-exclusion zone (VolumeIntegration.compute EXCLUSION_* constants):
// never integrate the operator's own body. A cylinder around the eye,
// 0.6m radius, from 0.25m above to 1.7m below the head.
static const float HEAD_EXCLUSION_RADIUS = 0.6;
static const float HEAD_EXCLUSION_TOP = 0.25;
static const float HEAD_EXCLUSION_BOTTOM = 1.7;
// QRS free-space carve reach: voxels this far (or farther) in front of the
// measured surface bypass the normal-facing gate so stale geometry at
// grazing angles still gets carved (QRS: empty = sDist >= 1.0).
static const float FAR_FREE_SPACE_DISTANCE = 1.0;

float3 VoxelToLocal(uint3 id)
{
    return ((float3)id + 0.5 - (float3)_VoxelCount * 0.5) * _VoxelSize;
}

[numthreads(4, 4, 4)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_VoxelCount)) return;
    _Volume[id] = float2(1.0, 0.0);
    _EvidenceVolume[id] = float4(0.0, -1.0, 0.0, -1.0);
}

// QRS periodic prune (VolumeIntegration.compute:69-81): reset voxels that
// were seeded but never confirmed (weight in (0, 0.05)) back to empty so
// they cannot form ghost geometry. Driven every 3s by the pipeline.
[numthreads(4, 4, 4)]
void Prune(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_VoxelCount)) return;
    float weight = _Volume[id].y;
    if (weight > 0.0 && weight < 0.05)
    {
        _Volume[id] = float2(1.0, 0.0);
        _EvidenceVolume[id] = float4(0.0, -1.0, 0.0, -1.0);
    }
}

void RecordAcceptedEvidence(uint3 id, float rayDistanceDelta)
{
    float4 evidence = _EvidenceVolume[id];
    float band = max(_EvidenceSurfaceBand, 1e-4);
    if (abs(rayDistanceDelta) <= band)
    {
        evidence.x = min(evidence.x + 1.0, 2048.0);
        evidence.w = (float)_EvidenceIntegrationOrdinal;
    }
    else if (rayDistanceDelta > band)
    {
        evidence.y = (float)_EvidenceIntegrationOrdinal;
    }
    else
    {
        evidence.z = min(evidence.z + 1.0, 2048.0);
    }
    _EvidenceVolume[id] = evidence;
}

[numthreads(4, 4, 4)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_VoxelCount)) return;

    float3 voxelWorld = mul(_VolumeLocalToWorld, float4(VoxelToLocal(id), 1.0)).xyz;

    // QRS head-exclusion: skip the operator's own body volume.
    float2 headDiff = voxelWorld.xz - _EyeWorldPosition.xz;
    if (dot(headDiff, headDiff) < HEAD_EXCLUSION_RADIUS * HEAD_EXCLUSION_RADIUS &&
        voxelWorld.y < _EyeWorldPosition.y + HEAD_EXCLUSION_TOP &&
        voxelWorld.y > _EyeWorldPosition.y - HEAD_EXCLUSION_BOTTOM)
        return;

    float4 clip = mul(_WorldToClip, float4(voxelWorld, 1.0));
    if (abs(clip.w) < 1e-6) return;

    float3 ndc = clip.xyz / clip.w;
    if (any(ndc.xy < -0.985) || any(ndc.xy > 0.985)) return;

    float2 uv = ndc.xy * 0.5 + 0.5;
    int2 pixel = int2(saturate(uv) * max(_SourceSize.xy - 1.0, 0.0));
    float4 meta = _ObservationMeta.Load(int3(pixel, 0));
    InterlockedAdd(_RejectStats[0], 1);
    if (meta.x < 0.5 || meta.w < 0.5 || meta.y < _MinimumConfidence)
    {
        InterlockedAdd(_RejectStats[1], 1);
        return;
    }
    if (meta.z < _MinimumDepth || meta.z > _MaximumDepth)
    {
        InterlockedAdd(_RejectStats[2], 1);
        return;
    }

    float3 surfaceWorld = _WorldPosition.Load(int3(pixel, 0)).xyz;
    float3 surfaceNormal = _WorldNormal.Load(int3(pixel, 0)).xyz;
    float normalLengthSq = dot(surfaceNormal, surfaceNormal);
    if (normalLengthSq < 1e-5)
    {
        InterlockedAdd(_RejectStats[3], 1);
        return;
    }
    surfaceNormal *= rsqrt(normalLengthSq);

    float3 eyeToSurface = surfaceWorld - _EyeWorldPosition.xyz;
    float surfaceDistance = length(eyeToSurface);
    if (surfaceDistance < 1e-4) return;
    float3 rayDirection = eyeToSurface / surfaceDistance;
    float facing = saturate(-dot(rayDirection, surfaceNormal));

    float voxelDistance = distance(voxelWorld, _EyeWorldPosition.xyz);

    // Occlusion gating (QRS VolumeIntegration.compute:59-66): reject voxels
    // behind the dilated depth surface.  The dilated texture propagates the
    // NEAREST observed depth outward by (truncation + voxelSize), so any
    // voxel deeper than the dilated value is occluded by a closer surface
    // from this viewpoint.
    if (_EnableOcclusionGating != 0)
    {
        float dilatedDepth = _DilationSrc.Load(int3(pixel, 0)).z;
        if (dilatedDepth > 0.0)
        {
            bool acceptableDisparity =
                surfaceDistance < dilatedDepth + _DepthDisparityThreshold;
            bool unoccluded = voxelDistance < dilatedDepth || acceptableDisparity;
            if (!unoccluded)
            {
                InterlockedAdd(_RejectStats[4], 1);
                return;
            }
        }
    }

    float rayDistanceDelta = surfaceDistance - voxelDistance;
    float signedDistance = rayDistanceDelta * facing;
    if (signedDistance < -_TruncationDistance)
    {
        InterlockedAdd(_RejectStats[5], 1);
        return;
    }
    // QRS (validSurfaceNormal = empty || normDot > MIN_DOT): the facing gate
    // only guards the surface band. Far free-space voxels are carved without
    // it -- otherwise stale shells at grazing angles can never be cleaned.
    if (signedDistance < FAR_FREE_SPACE_DISTANCE && facing < _MinimumNormalDot)
    {
        InterlockedAdd(_RejectStats[6], 1);
        return;
    }
    float normalizedDistance = min(signedDistance / _TruncationDistance, 1.0);

    float rangeQuality = saturate(1.0 - surfaceDistance / _MaximumDepth);
    float quality = max(0.05, rangeQuality * facing * saturate(meta.y));
    float q2 = quality * quality;
    float2 oldValue = _Volume[id];
    float oldWeight = max(0.0, oldValue.y);

    if (oldWeight < 0.001)
    {
        if (quality >= 0.20)
        {
            _Volume[id] = float2(normalizedDistance, 0.10);
            RecordAcceptedEvidence(id, rayDistanceDelta);
            InterlockedAdd(_RejectStats[8], 1);
        }
        else
        {
            InterlockedAdd(_RejectStats[7], 1);
        }
        return;
    }

    float blend = clamp(q2 * _BlendRate / (1.0 + oldWeight * _Stability), 0.005, 0.70);
    float updatedTsdf = lerp(oldValue.x, normalizedDistance, blend);
    float updatedWeight = min(oldWeight + q2 * _WeightGrowth, _MaximumWeight);
    _Volume[id] = float2(updatedTsdf, updatedWeight);
    RecordAcceptedEvidence(id, rayDistanceDelta);
    InterlockedAdd(_RejectStats[8], 1);
}

// ---------------------------------------------------------------------------
// Jump-flood depth dilation (QRS occlusion gating,
// VolumeIntegration.compute DilationInit/DilationStep).  Propagates the
// NEAREST observed depth outward so that voxels behind the closest surface
// can be identified and rejected during integration.
// ---------------------------------------------------------------------------

[numthreads(8, 8, 1)]
void InitDilation(uint2 coord : SV_DispatchThreadID)
{
    float4 meta = _ObservationMeta.Load(int3(coord, 0));
    bool valid = meta.x > 0.5 && meta.z > 0.0;
    float depth = valid ? meta.z : 0.0;
    float4 val = float4((float2)coord, depth, 0);
    _DilationSrc[coord] = val;
    _DilationDst[coord] = val;
}

static const int2 kDilationOffsets[8] =
{
    int2(1, 0), int2(1, 1), int2(0, 1), int2(-1, 1),
    int2(-1, 0), int2(-1, -1), int2(0, -1), int2(1, -1)
};

[numthreads(8, 8, 1)]
void DilationStep(uint2 coord : SV_DispatchThreadID)
{
    float4 val = _DilationSrc[coord];

    [unroll]
    for (int i = 0; i < 8; i++)
    {
        int2 srcCoord = (int2)coord + kDilationOffsets[i] * _DilationStepSize;
        if (srcCoord.x < 0 || srcCoord.y < 0 ||
            srcCoord.x >= (int)_SourceSize.x || srcCoord.y >= (int)_SourceSize.y)
            continue;

        float4 srcVal = _DilationSrc[(uint2)srcCoord];
        if (srcVal.z <= 0.0) continue;

        // Pixel size in world units at the candidate's depth.
        float pixelSize = 2.0 * srcVal.z /
            (_DilationFocalLength * _SourceSize.x);
        float radiusMeters = _TruncationDistance + _VoxelSize;
        float radiusPixels = radiusMeters / max(pixelSize, 1e-6);

        float2 diff = srcVal.xy - (float2)coord;
        bool withinRadius = dot(diff, diff) < radiusPixels * radiusPixels;
        bool newMinimum = srcVal.z < val.z;

        if (withinRadius && newMinimum)
            val = srcVal;
    }

    _DilationDst[coord] = val;
}
