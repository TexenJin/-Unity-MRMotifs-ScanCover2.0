// Genesis RoomScan - TSDF volume integration compute shader
// Volume format: RG8_SNorm — R = signed distance, G = confidence weight
//   weight > 0 = unfrozen, weight < 0 = frozen (abs = real weight), 0 = empty
// Color volume: RGBA8_UNorm — RGB = accumulated color, A = coverage weight
//
// Uses quality^2 modulated running average with slow weight growth.
// Camera projection uses direct pinhole model (matching Meta PCA samples)
// instead of VP matrix, avoiding Z-convention and resolution mismatch bugs.
#include "DepthKit.hlsl"
#include "VolumeHelpers.hlsl"

RWTexture3D<float2> gsVolumeRW;
RWTexture3D<float4> gsColorVolumeRW;
RWStructuredBuffer<uint> _CarveStats; // 矛盾票普查：0票投出 1排除区拦 2法线闸拦 3遮挡闸拦 4带外拦 5排内抹
float gsDepthDispThresh;
float gsMaxUpdateDist;
float gsMinUpdateDist;        // 近距采样闸：测量距离小于此值的深度样本整票作废（0=关闭，由 VolumeIntegrator.rejectNearSamples 控制）
float gsCarveInsideExclusion; // 排除区不对称：1=排除区内只拦写（播种/增长）不拦抹（矛盾扣减放行）

#define EXCLUSION_TOP 0.25
#define EXCLUSION_BOTTOM 1.7
#define MIN_DOT 0.3

float gsExclusionRadius; // 排除区半径（原写死 0.6，现由 VolumeIntegrator.exclusionRadius 下发）

#define MIN_QUALITY_SEED 0.25
#define SEED_WEIGHT 0.10
#define PRUNE_WEIGHT 0.05
#define COLOR_SURFACE_BAND 0.5

float gsBlendRate;
float gsStability;
float gsWeightGrowth;
float gsMaxWeight;
float gsCarveGain;

Texture2D<float4> gsCamRGB;
int gsCamAvailable;
float3 gsCamPos;
float4x4 gsCamInvRot;
float2 gsCamFocalLen;
float2 gsCamPrincipalPt;
float2 gsCamSensorRes;
float2 gsCamCurrentRes;
float gsCamExposure;

float2 ProjectToCameraUV(float3 worldPos)
{
    float3 localPos = mul(gsCamInvRot, float4(worldPos - gsCamPos, 1.0)).xyz;
    if (localPos.z <= 0.001) return float2(-1, -1);

    float2 sensorPt = float2(
        (localPos.x / localPos.z) * gsCamFocalLen.x + gsCamPrincipalPt.x,
        (localPos.y / localPos.z) * gsCamFocalLen.y + gsCamPrincipalPt.y);

    float2 scaleFactor = gsCamCurrentRes / gsCamSensorRes;
    scaleFactor /= max(scaleFactor.x, scaleFactor.y);
    float2 cropMin = gsCamSensorRes * (1.0 - scaleFactor) * 0.5;
    float2 cropSize = gsCamSensorRes * scaleFactor;
    float2 uv = (sensorPt - cropMin) / cropSize;

    return uv;
}

#pragma kernel Clear

[numthreads(4, 4, 4)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    gsVolumeRW[id] = float2(GS_EMPTY_VOXEL, 0);
    gsColorVolumeRW[id] = float4(0, 0, 0, 0);
}

#pragma kernel Prune

[numthreads(4, 4, 4)]
void Prune(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 val = gsVolumeRW[id];
    if (val.y > 0 && val.y < PRUNE_WEIGHT)
    {
        gsVolumeRW[id] = float2(GS_EMPTY_VOXEL, 0);
        gsColorVolumeRW[id] = float4(0, 0, 0, 0);
    }
}

#pragma kernel Integrate

[numthreads(64, 1, 1)]
void Integrate(uint id : SV_DispatchThreadID)
{
    float3 vLocalPos = gsFrustumVolume[id];
    float3 vWorldPos = mul(gsDepthViewInv[0], float4(vLocalPos, 1)).xyz;
    uint3 coord = gsWorldToVoxel(vWorldPos);
    float3 voxPos = gsVoxelToWorld(coord);

    float3 eyePos = gsDepthEyePos();
    float3 eyeToVox = voxPos - eyePos;
    float voxEyeDist = length(eyeToVox);

    float3 voxView = mul(gsDepthView[0], float4(voxPos, 1)).xyz;
    if (voxView.z > -0.05) return;

    float3 voxNDC = gsDepthWorldToNDC(voxPos);

    if (voxNDC.x < 0.01 || voxNDC.x > 0.99 || voxNDC.y < 0.01 || voxNDC.y > 0.99)
        return;

    float depthNDC = gsDepthSample(voxNDC.xy);
    float3 depthNorm = gsDepthNormalSample(voxNDC.xy).xyz;
    float3 depthPos = gsDepthNDCtoWorld(float3(voxNDC.xy, depthNDC));

    float3 eyeToDepth = depthPos - eyePos;
    float depthEyeDist = length(eyeToDepth);
    // 近距采样闸：近距深度噪声大，且胸口/手臂等身体观测会反向加固身前幽灵
    //（背景比幽灵更近 → sDist<0 → 按固体增长，幽灵越盯越牢）。minUpdateDist 原本只闸
    // 视锥体素（VolumeIntegrator.SetupFrustumVolume:636），此处对齐到采样侧；0=关闭。
    if (depthEyeDist < gsMinUpdateDist) return;
    float normDot = -dot(eyeToVox, depthNorm) / voxEyeDist;

    float sDist = depthEyeDist - voxEyeDist;
    sDist *= saturate(normDot);

    bool empty = sDist >= 1.0;
    float sDistNorm = min(sDist / gsVoxDist, 1);
    bool withinBand = sDistNorm >= -gsVoxMin / gsVoxSize;

    float dilatedDepthNDC = gsSampleDilatedDepth(voxNDC.xy);
    float dilatedDepthLinear = gsDepthNDCToLinear(dilatedDepthNDC);
    float depthLinear = gsDepthNDCToLinear(depthNDC);
    bool acceptableDepthDisparity = depthLinear < dilatedDepthLinear + gsDepthDispThresh;
    bool unoccludedByDilation = abs(voxView.z) < dilatedDepthLinear || acceptableDepthDisparity;
    bool validSurfaceNormal = empty || normDot > MIN_DOT;

    bool outsideExclusions = true;
    for (int p = 0; p < gsNumExclusions; p++)
    {
        float3 headPos = gsExclusionHeads[p];
        float2 diff = vWorldPos.xz - headPos.xz;
        if (dot(diff, diff) < gsExclusionRadius * gsExclusionRadius &&
            vWorldPos.y < headPos.y + EXCLUSION_TOP &&
            vWorldPos.y > headPos.y - EXCLUSION_BOTTOM)
        {
            outsideExclusions = false;
        }
    }

bool valid = withinBand & outsideExclusions & validSurfaceNormal & unoccludedByDilation;

    // 矛盾票普查：不论门禁是否放行，先记录"本可投反对票"（新观测比存量更空>0.2）的体素流向。
    // 只统计有存量的体素（y>0.001），空体素无所谓矛盾。
    float2 oldCensus = gsVolumeRW[coord];
    bool contradictedCensus = oldCensus.y > 0.001 && sDistNorm > oldCensus.x + 0.2;
    // 排除区不对称放行（治"排除区双向封锁"）：排除圆柱内只拦写不拦抹——播种/增长照旧禁止
    //（防手入网），但矛盾扣减放行。幽灵落进头周圆柱会被冻结永驻（实机：手挥到身体前方留下
    // 的幽灵永不消，右半画面伸展手臂留下的能消——中线分界=手臂伸展/回收决定的圆柱内外）。
    // 区内本就种不进合法几何，扣减只杀"头曾在别处时溜进来"的存量，零误伤。
    bool exclCarve = gsCarveInsideExclusion > 0.5 && !outsideExclusions;
    if (contradictedCensus)
    {
        if (valid)                      InterlockedAdd(_CarveStats[0], 1); // 票投出
        else if (exclCarve)             InterlockedAdd(_CarveStats[5], 1); // 排内抹（不对称放行，实际扣减）
        else if (!outsideExclusions)    InterlockedAdd(_CarveStats[1], 1); // 排除区拦（不对称开关关闭时）
        else if (!validSurfaceNormal)   InterlockedAdd(_CarveStats[2], 1); // 法线闸拦（掠射）
        else if (!unoccludedByDilation) InterlockedAdd(_CarveStats[3], 1); // 遮挡闸拦
        else                            InterlockedAdd(_CarveStats[4], 1); // 截断带外拦
    }

    // 排除区内矛盾体素：跳过全部写路径，只扣信心不动 TSDF（与 blend 地板分支同语义，
    // 同样保底 1 个 R8G8_SNorm 量化步长防吞票）
    if (!valid && exclCarve && contradictedCensus)
    {
        float exDistF = saturate(1.0 - voxEyeDist / gsMaxUpdateDist);
        float exAngF = saturate(normDot);
        float exQ2 = exDistF * exDistF * exAngF * exAngF;
        float exStep = max(exQ2 * gsCarveGain, 1.0 / 127.0);
        gsVolumeRW[coord] = float2(oldCensus.x, max(oldCensus.y - exStep, 0.0));
        return;
    }

    if (!valid) return;

    float distFactor = saturate(1.0 - voxEyeDist / gsMaxUpdateDist);
    float angleFactor = saturate(normDot);
    float quality = distFactor * angleFactor;
    float q2 = quality * quality;

    float2 old = gsVolumeRW[coord];
    if (old.y < 0) return; // frozen voxel — skip integration
    float oldVal = old.x;
    float weight = max(old.y, 0);
    bool wasEmpty = weight < 0.001;

    if (wasEmpty)
    {
        if (quality >= MIN_QUALITY_SEED)
        {
            gsVolumeRW[coord] = float2(sDistNorm, SEED_WEIGHT);

            if (gsCamAvailable && abs(sDistNorm) < COLOR_SURFACE_BAND)
            {
                float2 uv = ProjectToCameraUV(voxPos);
                if (uv.x > 0.02 && uv.x < 0.98 && uv.y > 0.02 && uv.y < 0.98)
                {
                    float4 camColor = gsCamRGB.SampleLevel(gsBilinearClampSampler, uv, 0);
                    float3 boosted = saturate(camColor.rgb * gsCamExposure);
                    gsColorVolumeRW[coord] = float4(boosted, quality * 0.1);
                }
            }
        }
        return;
    }

    // 矛盾扣减（投票制反对票）：新观测认为该体素比存量"更空"（超出 0.2≈3cm 噪声带）
    // → 直接扣信心 weight -= carveStep，不走 blend 地板——q 再小也照扣，
    // 把"低质量方向永不可抹"变成"慢但必然"。weight 跌破 minMeshWeight 网格消失，
    // 跌破 PRUNE_WEIGHT 被周期 Prune 回收，完成新陈代谢闭环。
    // 注意必须 clamp 到 0：负 weight 是 frozen 编码，不能误入。
    // v2 修复两个吞票缺陷：
    //  ① 矛盾帧不再加赞成增长（否则 -0.075q2 被同帧 +0.025q2 稀释）；
    //  ② carveStep 保底 1 个量化步长——体积是 R8G8_SNorm，weight 步长 1/127≈0.0079，
    //     Δw 小于半步(≈0.004)会被四舍五入归零，反对票投了但写盘无效（实机：普查"投"涨而幽灵不动）。
    bool contradicted = sDistNorm > oldVal + 0.2;
    float carveStep = max(q2 * gsCarveGain, 1.0 / 127.0);
    float carvedWeight = contradicted ? max(weight - carveStep, 0.0) : weight;

    float blend = q2 * gsBlendRate / (1.0 + weight * gsStability);
    blend = clamp(blend, 0.0, 0.7);
    if (blend < 0.005)
    {
        // 赞成票太弱不配改写 TSDF，但反对票仍然生效（只扣信心，不动距离值）
        if (contradicted)
            gsVolumeRW[coord] = float2(oldVal, carvedWeight);
        return;
    }

    float newTsdf = lerp(oldVal, sDistNorm, blend);
    // 矛盾帧只扣不增：反对票与赞成票同帧抵消是设计缺陷（v2 修复①）
    float newWeight = contradicted ? carvedWeight : min(weight + q2 * gsWeightGrowth, gsMaxWeight);
    gsVolumeRW[coord] = float2(newTsdf, newWeight);

    if (gsCamAvailable && abs(sDistNorm) < COLOR_SURFACE_BAND)
    {
        float2 uv = ProjectToCameraUV(voxPos);
        if (uv.x > 0.02 && uv.x < 0.98 && uv.y > 0.02 && uv.y < 0.98)
        {
            float4 camColor = gsCamRGB.SampleLevel(gsBilinearClampSampler, uv, 0);
            float3 boosted = saturate(camColor.rgb * gsCamExposure);

            float4 oldColor = gsColorVolumeRW[coord];
            float colorBlend = quality * 0.3;
            float3 rgb = oldColor.a < 0.01 ? boosted : lerp(oldColor.rgb, boosted, colorBlend);
            float newAlpha = min(oldColor.a + quality * 0.05, 1.0);
            gsColorVolumeRW[coord] = float4(rgb, newAlpha);
        }
    }
}

#pragma kernel BakeRelocation
#pragma kernel FreezeInFrustum
#pragma kernel UnfreezeInFrustum

[numthreads(4, 4, 4)]
void FreezeInFrustum(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 vol = gsVolumeRW[id];
    if (vol.y <= 0) return; // empty or already frozen

    float3 worldPos = gsVoxelToWorld(id);
    float2 uv = ProjectToCameraUV(worldPos);
    if (uv.x < 0.01 || uv.x > 0.99 || uv.y < 0.01 || uv.y > 0.99)
        return;

    gsVolumeRW[id] = float2(vol.x, -vol.y);
}

[numthreads(4, 4, 4)]
void UnfreezeInFrustum(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 vol = gsVolumeRW[id];
    if (vol.y >= 0) return; // not frozen

    float3 worldPos = gsVoxelToWorld(id);
    float2 uv = ProjectToCameraUV(worldPos);
    if (uv.x < 0.01 || uv.x > 0.99 || uv.y < 0.01 || uv.y > 0.99)
        return;

    gsVolumeRW[id] = float2(vol.x, -vol.y);
}

// ──────────────────────────────────────────────────────────────────
//  CountSurfaceCoverage: periodically count surface/frozen/colored
//  voxels for scan progress metrics. NOT dispatched every frame.
// ──────────────────────────────────────────────────────────────────

#pragma kernel CountSurfaceCoverage

RWStructuredBuffer<uint> _CoverageCounters; // [0]=surface, [1]=frozen, [2]=colored

Texture3D<float4> gsColorVolumeRead;

[numthreads(4, 4, 4)]
void CountSurfaceCoverage(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 tsdf = gsVolumeRW[id];
    float weight = tsdf.y;
    bool isFrozen = weight < 0;
    float absWeight = abs(weight);
    bool isSurface = absWeight > PRUNE_WEIGHT && abs(tsdf.x) < 0.3;

    if (isSurface)
    {
        InterlockedAdd(_CoverageCounters[0], 1);
        if (isFrozen)
            InterlockedAdd(_CoverageCounters[1], 1);
        float4 color = gsColorVolumeRead[id];
        if (color.a > 0.1)
            InterlockedAdd(_CoverageCounters[2], 1);
    }
}

// ──────────────────────────────────────────────────────────────────
//  BakeRelocation: resample TSDF+color from old grid into current
//  identity grid so volumeToWorld can be reset to I after loading.
// ──────────────────────────────────────────────────────────────────

Texture3D<float2> gsBakeSrcTsdf;
Texture3D<float4> gsBakeSrcColor;
float4x4 gsBakeInvRelocation;

[numthreads(4, 4, 4)]
void BakeRelocation(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;

    float3 dstLocal = ((float3)id + 0.5 - (float3)gsVoxCount / 2.0) * gsVoxSize;
    float3 srcLocal = mul(gsBakeInvRelocation, float4(dstLocal, 1)).xyz;

    float3 srcGrid = srcLocal / gsVoxSize + (float3)gsVoxCount / 2.0;
    float3 uvw = srcGrid / (float3)gsVoxCount;

    bool oob = any(uvw < 0.0) || any(uvw > 1.0);
    gsVolumeRW[id]      = oob ? float2(GS_EMPTY_VOXEL, 0) : gsBakeSrcTsdf.SampleLevel(gsVolLinearClampSampler, uvw, 0);
    gsColorVolumeRW[id] = oob ? float4(0, 0, 0, 0)        : gsBakeSrcColor.SampleLevel(gsVolLinearClampSampler, uvw, 0);
}
