// Genesis RoomScan - TSDF volume integration compute shader
// Volume format: RG8_SNorm — R = signed distance, G = confidence weight
//   weight > 0 = unfrozen, weight < 0 = frozen (abs = real weight), 0 = empty
// Color volume: RGBA8_UNorm — RGB = accumulated color, A = coverage weight
//
// Uses quality^2 modulated running average with slow weight growth.
// Camera projection uses direct pinhole model (matching Meta PCA samples)
// instead of VP matrix, avoiding Z-convention and resolution mismatch bugs.
#include "DepthKit.hlsl"
#include "VolumeHelpers.hlsl"

RWTexture3D<float2> gsVolumeRW;
RWTexture3D<float4> gsColorVolumeRW;
RWTexture3D<float> gsAdmissionTraceRW;
Texture2DArray<uint> gsEdgeReasonTex;
RWStructuredBuffer<uint> _DirtyChunkEpochs;
RWStructuredBuffer<uint> _DirtyBoundaryEpochs;
uint3 gsDirtyChunkCount;
uint gsDirtyChunkSize;
uint gsTrackDirtyChunks;
uint gsDirtyChunkEpoch;
uint gsDirtyBoundaryHalo;
float gsDirtyTsdfThreshold;
float gsDirtySurfaceBand;
float gsDirtyMinWeight;
// ── 逐块可逆冻结 ─────────────────────────────────────────────
// 冻结单元 = gsFrozenChunkSize 块（默认 32³≈1.6m，独立于脏账本 64³ 提取网格）。
// weight 翻符号即冻结，提取层 abs(weight) 对符号透明 → 冻结/解冻都不标脏、不重提网格。
RWStructuredBuffer<uint> _ChunkFreezeSetMask;   // 位图：本批待冻结块（1 位/块）
RWStructuredBuffer<uint> _ChunkFreezeClearMask; // 位图：本批待解冻块（同批票箱清零）
RWStructuredBuffer<uint2> _FrozenChunkVotes;    // 每块穿越票：x=自由空间票 y=遮挡票
RWStructuredBuffer<uint4> _ChunkMaturity;       // 每块成熟度：x=surface体素数 y=其中已冻结
float gsFrozenBlockEnable;     // 总开关：0=穿越票/成熟度普查停（掩码冻结仍可用）
float gsFrozenVoteQualityMin;  // 穿越票最低质量（防低质掠射噪声买票解冻）
float gsFrozenVoteMargin;      // 穿越票矛盾杆（归一化单位，1=截断距离），随距离自适应放大
uint3 gsFrozenChunkCount;      // 冻结块网格（独立于脏账本块——可更细，v1=32³≈1.6m）
uint gsFrozenChunkSize;        // 冻结块边长（体素）；0=冻结系统关闭
float gsFrozenMatureWeight;    // 长熟体素权重门槛：成熟度普查只数 abs(weight)≥此值 的体素。
                               // 必须远高于种子出生权重 0.06——否则毛坯脚手架与长熟墙在普查里
                               // 同数"稳定"，块一冻权重永停出生值（实机：天棚冻在 0.06 卡黄死锁）
RWStructuredBuffer<uint> _CarveStats; // 0..9=矛盾/延拦；10..27=现有只读账；28..44=膨胀供体出生证明（只读）
// Projective TSDF A/B controls. The production pass keeps both at 0/1;
// the read-only KinectFusion-style shadow pass sets raw=1, writeColor=0.
float gsUseRawProjectiveSdf;
float gsWriteColor;
float gsWriteAdmissionTrace;
int gsPruneZOffset;
int gsPruneZCount;
float gsDepthDispThresh;
float gsMaxUpdateDist;
float gsMinUpdateDist;        // 近距采样闸：测量距离小于此值的深度样本整票作废（0=关闭，由 VolumeIntegrator.rejectNearSamples 控制）
float gsCarveInsideExclusion; // 排除区不对称：1=排除区内只拦写（播种/增长）不拦抹（矛盾扣减放行）
float gsCarveBypassDilation;  // 膨胀闸不对称：1=被膨胀足迹罩住的体素只拦写不拦抹（矛盾扣减绕行，治缝隙幽灵永驻）
float gsCarveBypassNormal;    // 法线闸不对称：1=掠射观测只拦写不拦抹（强裕量矛盾扣减绕行，治斜视时反对票被法线闸全拦）
float gsCarveBypassMargin;    // 法绕抹专用矛盾裕量（带宽单位，1=gsVoxDist）：掠射深度噪声大，要求新观测比存量空出更多才扣减
float gsCarveBypassBoost;     // 绕行扣减独立倍率（默认 1）：绕行通道自带双重保险（被闸拦+强裕量），可加力清尸体而不动 carveGain 护真面
float gsAbstainSeedGuard;     // 弃权邻域写闸：1=弃权像素周边 1px 只拦写（播种/增长）不拦抹（矛盾扣减照常），治帘锚点漏网裙边零星复种
float gsRawSeedGate;          // 平面外推闸：投影后近表面、但原始沿视线距离已离开 TSDF 窄带时只拦写不拦抹
float gsRawSeedBand;          // 双向原始沿视线允许带宽，单位=gsVoxDist
float gsDiagDepthGapBase;     // 深度断层阈值下限（米）：诊断与膨胀路径闸共用
float gsDiagDepthGapScale;    // 随距离增长系数；阈值=max(base, depth*scale)
float gsDilationProductionGate; // 膨胀供料生产闸：危险路径只拦写、不拦矛盾扣减
float gsDilationBlockRelay;     // 1=两跳及以上接力供料不得播种/增长
float gsDilationBlockSparse;    // 1=路径探针间距过大的长距供料不得播种/增长
float gsProvisionalSeedWeight;  // 新表面暂存权重，必须低于正式出网阈值
float gsFormalSurfaceWeight;    // 与 Surface Nets _MinWeight 对齐的正式表面阈值
float gsDiagnosticAngularSpeed; // 只读：当前深度位姿的平滑头部角速度（deg/s）

#define EXCLUSION_TOP 0.25
#define EXCLUSION_BOTTOM 1.7
#define MIN_DOT 0.3

float gsExclusionRadius; // 排除区半径（原写死 0.6，现由 VolumeIntegrator.exclusionRadius 下发）

#define MIN_QUALITY_SEED 0.25
// 08-18 降门槛实验已回滚（当日晚）：实机判定深色床/远处=无深度数据区长不出网，
// 降阈无效且白加三角形（多三角形=光栅化负载，帧率敏感）。三层水位回 0.08/0.06/0.05。
#define PRUNE_WEIGHT 0.05
#define COLOR_SURFACE_BAND 0.5
#define DILATION_PATH_PROBES 12

// 块线性索引：脏账本/冻结位图/穿越票/成熟度共用同一套块网格（gsDirtyChunkSize）。
uint ChunkIndexFromCoord(uint3 coord)
{
    uint3 chunk = min(coord / gsDirtyChunkSize, gsDirtyChunkCount - 1u);
    return chunk.x + gsDirtyChunkCount.x * (chunk.y + gsDirtyChunkCount.y * chunk.z);
}

// 冻结块线性索引：独立于脏账本网格（冻结粒度可细于提取粒度）。
uint FrozenChunkIndexFromCoord(uint3 coord)
{
    uint3 chunk = min(coord / gsFrozenChunkSize, gsFrozenChunkCount - 1u);
    return chunk.x + gsFrozenChunkCount.x * (chunk.y + gsFrozenChunkCount.y * chunk.z);
}

// Persistent extraction scheduling ledger.  This is deliberately independent
// from TSDF admission: it only records chunks whose extractable geometry may
// have changed.  Weight accumulation above the mesh threshold is not dirty.
void MarkDirtyChunk(uint3 coord, float2 before, float2 after)
{
    if (gsTrackDirtyChunks == 0 || gsDirtyChunkSize == 0) return;

    // Negative weight is the existing "frozen" encoding.  Frozen geometry is
    // still observed geometry and must participate in the extraction ledger.
    bool beforeObserved = abs(before.y) >= gsDirtyMinWeight;
    bool afterObserved = abs(after.y) >= gsDirtyMinWeight;
    bool beforeSurface = beforeObserved && abs(before.x) <= gsDirtySurfaceBand;
    bool afterSurface = afterObserved && abs(after.x) <= gsDirtySurfaceBand;
    bool signChanged = beforeObserved && afterObserved && ((before.x < 0.0) != (after.x < 0.0));
    bool distanceChanged = beforeSurface && afterSurface &&
                           abs(after.x - before.x) >= gsDirtyTsdfThreshold;

    if (beforeSurface == afterSurface && !signChanged && !distanceChanged) return;

    uint3 chunk = min(coord / gsDirtyChunkSize, gsDirtyChunkCount - 1u);
    uint chunkIndex = ChunkIndexFromCoord(coord);
    InterlockedMax(_DirtyChunkEpochs[chunkIndex], gsDirtyChunkEpoch);

    // A changed voxel only invalidates a neighbouring extraction chunk when
    // it lies in that exact shared-face halo. This replaces the old CPU rule
    // that rebuilt all six neighbours for every change in the owner chunk.
    uint3 chunkStart = chunk * gsDirtyChunkSize;
    uint3 chunkEnd = min(chunkStart + gsDirtyChunkSize, gsVoxCount);
    uint3 local = coord - chunkStart;
    uint3 upper = (chunkEnd - 1u) - coord;
    uint halo = max(gsDirtyBoundaryHalo, 1u);
    uint faceBase = chunkIndex * 6u;
    if (chunk.x > 0u && local.x < halo)
        InterlockedMax(_DirtyBoundaryEpochs[faceBase + 0u], gsDirtyChunkEpoch);
    if (chunk.x + 1u < gsDirtyChunkCount.x && upper.x < halo)
        InterlockedMax(_DirtyBoundaryEpochs[faceBase + 1u], gsDirtyChunkEpoch);
    if (chunk.y > 0u && local.y < halo)
        InterlockedMax(_DirtyBoundaryEpochs[faceBase + 2u], gsDirtyChunkEpoch);
    if (chunk.y + 1u < gsDirtyChunkCount.y && upper.y < halo)
        InterlockedMax(_DirtyBoundaryEpochs[faceBase + 3u], gsDirtyChunkEpoch);
    if (chunk.z > 0u && local.z < halo)
        InterlockedMax(_DirtyBoundaryEpochs[faceBase + 4u], gsDirtyChunkEpoch);
    if (chunk.z + 1u < gsDirtyChunkCount.z && upper.z < halo)
        InterlockedMax(_DirtyBoundaryEpochs[faceBase + 5u], gsDirtyChunkEpoch);
}

void WriteTrackedTsdf(uint3 coord, float2 value)
{
    float2 before = gsVolumeRW[coord];
    gsVolumeRW[coord] = value;
    MarkDirtyChunk(coord, before, value);
}

// Persistent, diagnostic-only packed provenance. One compact R8 sidecar holds
// the complete voxel-lifetime audit signature without changing production TSDF
// decisions:
//   bits 0..1 = immutable admission source for this voxel lifetime
//               0 untracked, 1 self, 2 direct fill, 3 relay fill
//   bit 2     = current geometry has received a receiver-side raw-depth
//               confirmation consistent with the stored TSDF
//   bit 3     = at least one accepted write used grazing-plane rescue
//   bit 4     = at least one accepted write was next to an abstaining pixel
//   bit 5     = seed frame occurred above 60 deg/s (birth-frozen: written only
//               at seed time, never OR-accumulated by later growth frames)
//   bit 6     = retired (was edge-cleaner signature; saturated to ~100% at
//               triangle level and carried no actionable signal)
//   bit 7     = the provisional voxel crossed the formal threshold through the
//               explicit second-consistent-raw fast promotion
// Source is a birth certificate and is never OR-merged with later observations.
// Confirmation is a geometric state, not a synonym for "raw pixel existed".
uint DecodeAdmissionTrace(float encoded)
{
    return (uint)clamp((int)round(saturate(encoded) * 255.0), 0, 255);
}

float EncodeAdmissionTrace(uint packed)
{
    return saturate((float)(packed & 255u) / 255.0);
}

// Donor-to-receiver path classification. The exact same result feeds both the
// diagnostic ledger and the production positive-write gate, preventing the
// old failure mode where the HUD reported a crossed edge but TSDF still wrote.
uint ClassifyDilationDonorPath(int2 donorPx, int2 receiverPx, float donorDistancePx)
{
    int2 pmax = int2(gsDepthTexSize) - 1;
    int probes = clamp((int)ceil(donorDistancePx * 0.5), 2, DILATION_PATH_PROBES);
    float sampleSpacingPx = donorDistancePx / max((float)probes, 1.0);
    bool crossedKnownEdge = false;
    bool crossedInvalid = false;
    bool crossedDepthJump = false;

    int2 startPx = clamp(donorPx, int2(0, 0), pmax);
    float startNdc = gsDepthTex[uint3(uint2(startPx), 0)];
    bool previousValid = startNdc > 0.0;
    float previousLinear = previousValid ? gsDepthNDCToLinear(startNdc) : 0.0;

    [loop]
    for (int i = 1; i <= DILATION_PATH_PROBES; i++)
    {
        if (i > probes) break;
        float t = (float)i / (float)probes;
        int2 pathPx = clamp(
            int2(round(lerp(float2(donorPx), float2(receiverPx), t))),
            int2(0, 0), pmax);

        uint pathReason = gsEdgeReasonTex[uint3(uint2(pathPx), 0)];
        if ((pathReason & (1u << 7)) != 0)
            crossedKnownEdge = true;

        float pathNdc = gsDepthTex[uint3(uint2(pathPx), 0)];
        bool currentValid = pathNdc > 0.0;
        if (!currentValid)
        {
            crossedInvalid = true;
            previousValid = false;
            continue;
        }

        float currentLinear = gsDepthNDCToLinear(pathNdc);
        if (previousValid)
        {
            float jumpLimit = max(gsDiagDepthGapBase, currentLinear * gsDiagDepthGapScale)
                            * max(sampleSpacingPx, 1.0);
            if (abs(currentLinear - previousLinear) > jumpLimit)
                crossedDepthJump = true;
        }

        previousLinear = currentLinear;
        previousValid = true;
    }

    if (crossedKnownEdge) return 1u;
    if (crossedInvalid) return 2u;
    if (crossedDepthJump) return 3u;
    if (sampleSpacingPx > 2.0) return 4u;
    return 0u;
}

float gsBlendRate;
float gsStability;
float gsWeightGrowth;
float gsMaxWeight;
float gsCarveGain;
// 自由空间对称扣减倍率：只乘主矛盾通道（valid 全通过的正式反对票），新鲜正式面
// （weight≈0.087）在典型质量下 2~3 票扣死；成熟面权重基数大，同等倍率只擦皮。
// 不动 carveGain 本体、不动胀绕/法绕/弃权旁路（它们自带 gsCarveBypassBoost）。
float gsFreeSpaceCarveBoost;
// 救援样本播种资格审查改用距离分（默认 1）：边缘清洗的同平面背书已替代本地法线
// 可信度，掠射角不再重复计罚。0 = 关回（救援样本按真实 quality 过 0.25 播种线）。
float gsRescueSeedDistOnly;
// 运动种子闸（°/s，默认 60）：角速度超阈的帧只长不种——假面 77% 出生于 60~90°/s
// 放行带，而整帧停笔（C# 闸 90）会把天棚覆盖所需的慢扫帧一起掐死（种子绝育复发）。
// 两级分工：C# 整帧闸 90 防涂抹；本闸 60 只断假面出生口，增长/矛盾扣减照常。
float gsMotionSeedBlock;

Texture2D<float4> gsCamRGB;
int gsCamAvailable;
float3 gsCamPos;
float4x4 gsCamInvRot;
float2 gsCamFocalLen;
float2 gsCamPrincipalPt;
float2 gsCamSensorRes;
float2 gsCamCurrentRes;
float gsCamExposure;

float2 ProjectToCameraUV(float3 worldPos)
{
    float3 localPos = mul(gsCamInvRot, float4(worldPos - gsCamPos, 1.0)).xyz;
    if (localPos.z <= 0.001) return float2(-1, -1);

    float2 sensorPt = float2(
        (localPos.x / localPos.z) * gsCamFocalLen.x + gsCamPrincipalPt.x,
        (localPos.y / localPos.z) * gsCamFocalLen.y + gsCamPrincipalPt.y);

    float2 scaleFactor = gsCamCurrentRes / gsCamSensorRes;
    scaleFactor /= max(scaleFactor.x, scaleFactor.y);
    float2 cropMin = gsCamSensorRes * (1.0 - scaleFactor) * 0.5;
    float2 cropSize = gsCamSensorRes * scaleFactor;
    float2 uv = (sensorPt - cropMin) / cropSize;

    return uv;
}

#pragma kernel Clear

[numthreads(4, 4, 4)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    gsVolumeRW[id] = float2(GS_EMPTY_VOXEL, 0);
    if (gsWriteColor > 0.5)
        gsColorVolumeRW[id] = float4(0, 0, 0, 0);
    if (gsWriteAdmissionTrace > 0.5)
        gsAdmissionTraceRW[id] = 0.0;
}

#pragma kernel Prune

[numthreads(4, 4, 4)]
void Prune(uint3 id : SV_DispatchThreadID)
{
    if (id.z >= (uint)gsPruneZCount) return;
    uint3 volumeId = uint3(id.x, id.y, id.z + (uint)gsPruneZOffset);
    if (any(volumeId >= gsVoxCount)) return;
    float2 val = gsVolumeRW[volumeId];
    if (val.y > 0 && val.y < PRUNE_WEIGHT)
    {
        WriteTrackedTsdf(volumeId, float2(GS_EMPTY_VOXEL, 0));
        if (gsWriteColor > 0.5)
            gsColorVolumeRW[volumeId] = float4(0, 0, 0, 0);
        if (gsWriteAdmissionTrace > 0.5)
            gsAdmissionTraceRW[volumeId] = 0.0;
    }
}

#pragma kernel Integrate

[numthreads(64, 1, 1)]
void Integrate(uint id : SV_DispatchThreadID)
{
    float3 vLocalPos = gsFrustumVolume[id];
    float3 vWorldPos = mul(gsDepthViewInv[0], float4(vLocalPos, 1)).xyz;
    uint3 coord = gsWorldToVoxel(vWorldPos);
    float3 voxPos = gsVoxelToWorld(coord);

    float3 eyePos = gsDepthEyePos();
    float3 eyeToVox = voxPos - eyePos;
    float voxEyeDist = length(eyeToVox);

    float3 voxView = mul(gsDepthView[0], float4(voxPos, 1)).xyz;
    if (voxView.z > -0.05) return;

    float3 voxNDC = gsDepthWorldToNDC(voxPos);

    if (voxNDC.x < 0.01 || voxNDC.x > 0.99 || voxNDC.y < 0.01 || voxNDC.y > 0.99)
        return;

    float depthNDC = gsDepthSample(voxNDC.xy);
    float3 depthNorm = gsDepthNormalSample(voxNDC.xy).xyz;
    float3 depthPos = gsDepthNDCtoWorld(float3(voxNDC.xy, depthNDC));

    float3 eyeToDepth = depthPos - eyePos;
    float depthEyeDist = length(eyeToDepth);
    // 近距采样闸：近距深度噪声大，且胸口/手臂等身体观测会反向加固身前幽灵
    //（背景比幽灵更近 → sDist<0 → 按固体增长，幽灵越盯越牢）。minUpdateDist 原本只闸
    // 视锥体素（VolumeIntegrator.SetupFrustumVolume:636），此处对齐到采样侧；0=关闭。
    if (depthEyeDist < gsMinUpdateDist) return;
    float normDot = -dot(eyeToVox, depthNorm) / voxEyeDist;

    // 弃权邻域写闸（第四不对称：只拦写不拦抹）：边缘清洗的弃权像素（0=近端）周边 1px 内的样本
    // 不许播种/增长——帘锚点旁的漏网裙边（双眼扇面重合、③e 证伪盲区）必紧贴弃权带。
    // 真折角切口旁的体素晚一两帧种上（视角一晃投影就挪出邻域），代价可忽略。
    // 8 邻域（含对角）：裙边样本常落在弃权像素的 45° 对角位，4 邻域管不到。
    int2 depthPixel = int2(voxNDC.xy * float2(gsDepthTexSize));
    int2 depthPixelMax = int2((int)gsDepthTexSize.x - 1, (int)gsDepthTexSize.y - 1);
    depthPixel = clamp(depthPixel, int2(0, 0), depthPixelMax);
    uint receiverEdgeReason = gsEdgeReasonTex[uint3(uint2(depthPixel), 0)];
    bool grazingPlaneRescued = (receiverEdgeReason & (1u << 10)) != 0;
    bool nearAbstainNeighbour = false;
    // Always measure the context for the forensic ledger. The production gate
    // still honours gsAbstainSeedGuard below, so disabling it remains byte-for-
    // byte equivalent for TSDF admission.
    if (gsDepthTex[uint3(uint2(clamp(depthPixel + int2( 1, 0), int2(0, 0), depthPixelMax)), 0)] == 0) nearAbstainNeighbour = true;
    if (gsDepthTex[uint3(uint2(clamp(depthPixel + int2(-1, 0), int2(0, 0), depthPixelMax)), 0)] == 0) nearAbstainNeighbour = true;
    if (gsDepthTex[uint3(uint2(clamp(depthPixel + int2( 0, 1), int2(0, 0), depthPixelMax)), 0)] == 0) nearAbstainNeighbour = true;
    if (gsDepthTex[uint3(uint2(clamp(depthPixel + int2( 0,-1), int2(0, 0), depthPixelMax)), 0)] == 0) nearAbstainNeighbour = true;
    if (gsDepthTex[uint3(uint2(clamp(depthPixel + int2( 1, 1), int2(0, 0), depthPixelMax)), 0)] == 0) nearAbstainNeighbour = true;
    if (gsDepthTex[uint3(uint2(clamp(depthPixel + int2( 1,-1), int2(0, 0), depthPixelMax)), 0)] == 0) nearAbstainNeighbour = true;
    if (gsDepthTex[uint3(uint2(clamp(depthPixel + int2(-1, 1), int2(0, 0), depthPixelMax)), 0)] == 0) nearAbstainNeighbour = true;
    if (gsDepthTex[uint3(uint2(clamp(depthPixel + int2(-1,-1), int2(0, 0), depthPixelMax)), 0)] == 0) nearAbstainNeighbour = true;

    float rawProjectiveSdf = depthEyeDist - voxEyeDist;
    float sDist = grazingPlaneRescued
        ? rawProjectiveSdf
        : lerp(rawProjectiveSdf * saturate(normDot),
               rawProjectiveSdf,
               saturate(gsUseRawProjectiveSdf));

    bool empty = sDist >= 1.0;
    float sDistNorm = min(sDist / gsVoxDist, 1);
    bool withinBand = sDistNorm >= -gsVoxMin / gsVoxSize;
    // 标准 TSDF 窄带约束：法线投影只能改变融合权重/方向语义，不能把原始射线上已经
    // 远离观测表面的体素压成“近零交叉”。前表面(+raw)与后表面(-raw)必须双向约束。
    // 只阻止播种/增长，下面的矛盾扣减通道仍可清理既有错误。
    float rawSeedLimit = gsRawSeedBand * gsVoxDist;
    bool rawGateBlock = gsRawSeedGate > 0.5 &&
                        abs(sDistNorm) < 0.5 &&
                        abs(rawProjectiveSdf) > rawSeedLimit;
    bool rawGateFront = rawProjectiveSdf > rawSeedLimit;

    float dilatedDepthNDC = gsSampleDilatedDepth(voxNDC.xy);
    float dilatedDepthLinear = gsDepthNDCToLinear(dilatedDepthNDC);
    float depthLinear = gsDepthNDCToLinear(depthNDC);
    bool acceptableDepthDisparity = depthLinear < dilatedDepthLinear + gsDepthDispThresh;
    bool unoccludedByDilation = abs(voxView.z) < dilatedDepthLinear || acceptableDepthDisparity;
    // DepthEdgeClean bit 10 is only written after coherent same-plane support
    // and after skirt/cross-eye/depth-cluster vetoes have had priority.  Honour
    // that evidence here instead of rescuing the pixel visually and then
    // rejecting the very same sample at the integration normal gate.
    bool validSurfaceNormal = empty || normDot > MIN_DOT || grazingPlaneRescued;

    bool outsideExclusions = true;
    for (int p = 0; p < gsNumExclusions; p++)
    {
        float3 headPos = gsExclusionHeads[p];
        float2 diff = vWorldPos.xz - headPos.xz;
        if (dot(diff, diff) < gsExclusionRadius * gsExclusionRadius &&
            vWorldPos.y < headPos.y + EXCLUSION_TOP &&
            vWorldPos.y > headPos.y - EXCLUSION_BOTTOM)
        {
            outsideExclusions = false;
        }
    }

bool valid = withinBand & outsideExclusions & validSurfaceNormal & unoccludedByDilation;

    // 膨胀闸不对称（与排除区不对称同哲学）：被近表面膨胀足迹罩住的体素，播种/增长仍拦（防隔物写字），
    // 但当帧原始深度确实看穿它（sDist>0 且超存量 0.2 已是矛盾前提）时反对票放行。
    // 治：缝隙区（柜边↔侧墙）整个被罩进前景膨胀足迹 → 幽灵一旦种入永不收反对票 → 桥只长不消。
    // validCarve 与 valid 唯一差别就是摘掉膨胀闸；!valid && validCarve ⇒ 仅被膨胀闸拦。
    bool validCarve = withinBand & outsideExclusions & validSurfaceNormal;
    bool dilationBypass = gsCarveBypassDilation > 0.5 && !valid && validCarve;

    // 法线闸不对称（第三不对称通道）：掠射观测的深度位置噪声大所以拦写有理，
    // 但"射线沿途为空"的证据与表面朝向无关 → 拦抹没道理。实机普查：法拦1.6万 vs 投1853。
    // 防误抹真面：此通道要求更强矛盾裕量（gsCarveBypassMargin，默认 0.6 带宽≈9cm，普通通道 0.2≈3cm），
    // 掠射深度抖动几厘米翻不过这道槛，而桥后墙隔着几十厘米轻松翻过。
    // 裕量随距离放大（1.5m 内不变，之外按 voxEyeDist/1.5 线性加宽）：远距掠射噪声 5~10cm
    // 与固定裕量同量级，会把真地板自己的噪声采样误判成"看穿尸体"→ 法绕误啃地板出裂口（实机）。
    bool validCarveLoose = withinBand & outsideExclusions;
    bool normalBypass = gsCarveBypassNormal > 0.5 && !valid && validCarveLoose && !validSurfaceNormal;
    float nrMargin = gsCarveBypassMargin * max(voxEyeDist / 1.5, 1.0);

    // 矛盾票普查：不论门禁是否放行，先记录"本可投反对票"（新观测比存量更空>0.2）的体素流向。
    // 只统计有存量的体素（y>0.001），空体素无所谓矛盾。
    float2 oldCensus = gsVolumeRW[coord];
    bool contradictedCensus = oldCensus.y > 0.001 && sDistNorm > oldCensus.x + 0.2;
    // 排除区不对称放行（治"排除区双向封锁"）：排除圆柱内只拦写不拦抹——播种/增长照旧禁止
    //（防手入网），但矛盾扣减放行。幽灵落进头周圆柱会被冻结永驻（实机：手挥到身体前方留下
    // 的幽灵永不消，右半画面伸展手臂留下的能消——中线分界=手臂伸展/回收决定的圆柱内外）。
    // 区内本就种不进合法几何，扣减只杀"头曾在别处时溜进来"的存量，零误伤。
    bool exclCarve = gsCarveInsideExclusion > 0.5 && !outsideExclusions;
    if (contradictedCensus)
    {
        if (valid)                      InterlockedAdd(_CarveStats[0], 1); // 票投出
        else if (exclCarve)             InterlockedAdd(_CarveStats[5], 1); // 排内抹（不对称放行，实际扣减）
        else if (!outsideExclusions)    InterlockedAdd(_CarveStats[1], 1); // 排除区拦（不对称开关关闭时）
        else if (!validSurfaceNormal)
        {
            if (normalBypass && sDistNorm > oldCensus.x + nrMargin)
                InterlockedAdd(_CarveStats[7], 1); // 法绕抹（法线闸不对称放行，强裕量，实际扣减）
            else
                InterlockedAdd(_CarveStats[2], 1); // 法线闸拦（掠射）
        }
        else if (!unoccludedByDilation)
        {
            // 胀绕同样走强裕量（与法绕共用 nrMargin）：腿/脚等近物的膨胀足迹 25cm 永久罩住周边真地板，
            // 被罩体素只扣不长；0.2 普通裕量下地板噪声读深 3cm 就假矛盾→真地板永被啃出洞（实机 胀绕3966）。
            // 真目标（缝隙幽灵）墙隔几十厘米照样翻过。
            if (dilationBypass && sDistNorm > oldCensus.x + nrMargin)
                InterlockedAdd(_CarveStats[6], 1); // 胀绕抹（膨胀闸不对称放行，强裕量，实际扣减）
            else                        InterlockedAdd(_CarveStats[3], 1); // 遮挡闸拦
        }
        else                            InterlockedAdd(_CarveStats[4], 1); // 截断带外拦
    }

    // 排除区内矛盾体素：跳过全部写路径，只扣信心不动 TSDF（与 blend 地板分支同语义，
    // 同样保底 1 个 R8G8_SNorm 量化步长防吞票）
    if (!valid && exclCarve && contradictedCensus)
    {
        float exDistF = saturate(1.0 - voxEyeDist / gsMaxUpdateDist);
        float exAngF = saturate(normDot);
        float exQ2 = exDistF * exDistF * exAngF * exAngF;
        float exStep = max(exQ2 * gsCarveGain, 1.0 / 127.0);
        WriteTrackedTsdf(coord, float2(oldCensus.x, max(oldCensus.y - exStep, 0.0)));
        return;
    }

    // 膨胀闸绕行扣减：只扣信心不动 TSDF，保底 1 量化步长。强裕量（nrMargin，距离自适应）——
    // 适用对象=缝隙区被前景膨胀足迹罩住、但当帧原始深度确实看穿且墙明确在存量后方的体素。
    if (!valid && dilationBypass && oldCensus.y > 0.001 && sDistNorm > oldCensus.x + nrMargin)
    {
        float byDistF = saturate(1.0 - voxEyeDist / gsMaxUpdateDist);
        float byAngF = saturate(normDot);
        float byQ2 = byDistF * byDistF * byAngF * byAngF;
        float byStep = max(byQ2 * gsCarveGain * gsCarveBypassBoost, 1.0 / 127.0);
        WriteTrackedTsdf(coord, float2(oldCensus.x, max(oldCensus.y - byStep, 0.0)));
        return;
    }

    // 法线闸绕行扣减（强裕量版）：角因子不计（法线不可信正是被拦原因），距离因子+保底步长慢速必达。
    if (!valid && normalBypass && oldCensus.y > 0.001 && sDistNorm > oldCensus.x + nrMargin)
    {
        float nrDistF = saturate(1.0 - voxEyeDist / gsMaxUpdateDist);
        float nrStep = max(nrDistF * nrDistF * gsCarveGain * gsCarveBypassBoost, 1.0 / 127.0);
        WriteTrackedTsdf(coord, float2(oldCensus.x, max(oldCensus.y - nrStep, 0.0)));
        return;
    }

    if (!valid) return;

    float distFactor = saturate(1.0 - voxEyeDist / gsMaxUpdateDist);
    // 救援降级③：救援样本不再享受 0.5 角度地板。混合斜坡是多帧一致的系统性伪造品，
    // 给它角度地板等于让最不可信的掠射观测以正视待遇播种/增长。救援只豁免法线闸
    // 准入（上方 validSurfaceNormal），质量分必须按真实入射角诚实计算——掠射就是
    // 低质量，低质量就是慢生慢长，靠后续正视观测自然转正。
    float angleFactor = saturate(normDot);
    float quality = distFactor * angleFactor;
    float q2 = quality * quality;
    // 救援样本的播种资格审查用距离分而非角度质量分：救援标记本身意味着上游
    // 边缘清洗已用同平面连贯性+双眼支持给该像素背书，本地法线在掠射时测不准
    // （这正是它被救援的原因），播种闸再罚一次角度=重复计罚——实机：天棚远场
    // normDot 0.2~0.3 × distFactor 永远够不到 0.25，种子落不下，点阵集体卡黄。
    // 增长/扣减仍按真实 quality 计算（假桥慢生慢长、反对票照扣），防假桥三道门
    // （不享快速转正/弃权组合失效/运动闸）一个不动。gsRescueSeedDistOnly=0 关回。
    float seedGateQuality = (grazingPlaneRescued && gsRescueSeedDistOnly > 0.5)
        ? distFactor : quality;

    // Classify the source that allowed this voxel through the dilation gate.
    // This is provenance of admission only; sDist itself still comes from raw depth.
    int2 admissionPx = depthPixel;
    float4 admissionDonorRecord = gsDilatedDepth.Load(int3(admissionPx, 0));
    int2 admissionDonorPx = clamp(int2(admissionDonorRecord.xy + 0.5),
                                  int2(0, 0), int2(gsDepthTexSize) - 1);
    float admissionDonorDistancePx = length(float2(admissionDonorPx - admissionPx));
    uint admissionDonorHops = (uint)round(max(admissionDonorRecord.w, 0.0));

    // Ledger A records the source that first admitted this voxel. Ledger B is
    // evaluated only after an accepted write and additionally requires the raw
    // receiver measurement to agree with the local zero-crossing geometry.
    // gsDepthTex is Texture2DArray<float>: xy, array slice, mip level.
    float receiverRawDepthNdc = gsDepthTex.Load(int4(admissionPx, 0, 0));
    bool receiverOwnsRawDepth = receiverRawDepthNdc > 0.0;
    uint admissionSource = receiverOwnsRawDepth ? 1u :
                           (admissionDonorDistancePx <= 0.5 ? 1u :
                           (admissionDonorHops <= 1u ? 2u : 3u));
    uint admissionPathClass = admissionDonorDistancePx > 0.5
        ? ClassifyDilationDonorPath(admissionDonorPx, admissionPx, admissionDonorDistancePx)
        : 0u;
    bool admissionDirectFill = admissionDonorHops <= 1u;
    bool admissionPathBarrier = admissionPathClass >= 1u && admissionPathClass <= 3u;
    bool admissionPathSparse = admissionPathClass == 4u;
    // Donor provenance is only authoritative when the receiver actually lacks
    // its own cleaned depth.  A valid receiver measurement supplies sDist itself
    // and must not be rejected because an unrelated dilation donor crossed a
    // barrier on the way to the same screen pixel.
    bool reliesOnBorrowedDepth = !receiverOwnsRawDepth && admissionDonorDistancePx > 0.5;
    bool dilationBlockedByBarrier = reliesOnBorrowedDepth && admissionPathBarrier;
    bool dilationBlockedByRelay = reliesOnBorrowedDepth &&
                                  gsDilationBlockRelay > 0.5 && !admissionDirectFill;
    bool dilationBlockedBySparse = reliesOnBorrowedDepth &&
                                   gsDilationBlockSparse > 0.5 && admissionPathSparse;
    bool dilationPositiveWriteBlocked = gsDilationProductionGate > 0.5 &&
        (dilationBlockedByBarrier || dilationBlockedByRelay || dilationBlockedBySparse);
    bool rawGeometryConfirmed = receiverOwnsRawDepth && !rawGateBlock &&
                                abs(rawProjectiveSdf) <= rawSeedLimit &&
                                abs(sDistNorm) <= 0.5;
    // The 3x3 abstain expansion protects only borrowed/dilated supply.  Direct
    // cleaned measurements have already survived their own centre-pixel hard
    // edge decision and should not inherit a neighbouring pixel's abstention.
    // 救援降级②：豁免不叠加——救援样本（本身已是掠射豁免准入）若再落在弃权邻域，
    // 不再享受"自身有原始深度"的豁免，照常只扣不种/不长。
    bool nearAbstain = gsAbstainSeedGuard > 0.5 &&
                       (!receiverOwnsRawDepth || grazingPlaneRescued) && nearAbstainNeighbour;
    // Voxel-lifetime forensic signature. These flags are carried beside the
    // immutable birth source and later OR-reduced onto emitted triangles. They
    // are observations only: none of them participate in a production gate.
    // (64u edge-signature bit retired: triangle-level saturation made it noise.)
    uint currentAuditFlags = (grazingPlaneRescued ? 8u : 0u) |
                             (nearAbstainNeighbour ? 16u : 0u) |
                             (gsDiagnosticAngularSpeed > 60.0 ? 32u : 0u);

    // 只读供料分账：只统计“现有生产规则本来就会允许写入”的近零候选，绝不参与任何闸门。
    // 原始射线距离拆成内半带/外半带；当前深度与膨胀近景的差值用于判断是否贴着深度断层。
    bool supplyLedgerCandidate = !nearAbstain && !rawGateBlock &&
                                 seedGateQuality >= MIN_QUALITY_SEED &&
                                 abs(sDistNorm) < 0.5 &&
                                 abs(rawProjectiveSdf) <= rawSeedLimit;
    if (supplyLedgerCandidate)
    {
        float rawRatio = abs(rawProjectiveSdf) / max(rawSeedLimit, 1e-5);
        InterlockedAdd(_CarveStats[rawRatio <= 0.5 ? 10 : 11], 1);

        float localDepthGap = max(depthLinear - dilatedDepthLinear, 0.0);
        uint gapSlot = localDepthGap <= 0.05 ? 12 :
                       (localDepthGap <= 0.15 ? 13 :
                       (localDepthGap <= 0.30 ? 14 : 15));
        InterlockedAdd(_CarveStats[gapSlot], 1);

        // 自适应深度断层闸只读影子：严格复用 DepthEdgeClean 的距离阈值形式，
        // 但此处只记账、不改变 valid/播种/增长/矛盾扣减。按入射角拆账，用来识别
        // 候选闸是否主要命中危险的掠射供料，还是会大量误伤正视的真实表面。
        float adaptiveGapLimit = max(gsDiagDepthGapBase,
                                     depthLinear * gsDiagDepthGapScale);
        if (localDepthGap <= adaptiveGapLimit)
        {
            InterlockedAdd(_CarveStats[16], 1);
        }
        else if (normDot < 0.5)
        {
            InterlockedAdd(_CarveStats[17], 1);
        }
        else if (normDot < 0.7)
        {
            InterlockedAdd(_CarveStats[18], 1);
        }
        else
        {
            InterlockedAdd(_CarveStats[19], 1);
        }

        // Read-only cross-ledger. Slots 20..25/27 are exclusive and therefore sum to
        // the accepted near-zero supply population. Slot 26 is an overlap alarm: the
        // cleaner marked the exact source pixel killed but fusion still saw it as supply.
        int2 reasonPx = admissionPx;
        uint edgeReason = gsEdgeReasonTex[uint3(uint2(reasonPx), 0)];
        bool rKilled = (edgeReason & (1u << 7)) != 0;
        bool rSkirt = (edgeReason & (1u << 2)) != 0;
        bool rCrossEye = (edgeReason & (1u << 6)) != 0;
        bool rGrazing = (edgeReason & (1u << 4)) != 0;
        bool rDual = (edgeReason & (1u << 5)) != 0;
        bool rPlane = (edgeReason & (1u << 3)) != 0;
        bool rSpanOrGap = (edgeReason & ((1u << 0) | (1u << 1) | (1u << 8))) != 0;
        uint reasonSlot = rSkirt ? 22 :
                          (rCrossEye ? 25 :
                          (rGrazing ? 24 :
                          (rDual ? 23 :
                          (rPlane ? 21 :
                          (rSpanOrGap ? 27 : 20)))));
        InterlockedAdd(_CarveStats[reasonSlot], 1);
        if (rKilled) InterlockedAdd(_CarveStats[26], 1);

        // 膨胀供体“出生证明”只读分账。
        // Jump Flood 的 float4 本来就保存了 donor.xy + donorDepth；这里仅追溯它，
        // 不改变 production 使用的 dilatedDepth、valid、TSDF 写入或网格提取。
        float4 donorRecord = admissionDonorRecord;
        int2 donorPx = admissionDonorPx;
        float donorDistancePx = admissionDonorDistancePx;
        uint donorDistanceSlot = donorDistancePx <= 0.5 ? 28 :
                                 (donorDistancePx <= 2.0 ? 29 :
                                 (donorDistancePx <= 4.0 ? 30 :
                                 (donorDistancePx <= 8.0 ? 31 : 32)));
        InterlockedAdd(_CarveStats[donorDistanceSlot], 1);

        // 只有真正从邻像素传播来的供料才进入“供体差/供体来源”两本账。
        // 33..36 是互斥深度差桶；37..44 是互斥供体原因桶，二者各自求和
        // 都应等于传播供料总数，可用于检查统计链是否自洽。
        if (donorDistancePx > 0.5)
        {
            uint donorGapSlot = localDepthGap <= 0.05 ? 33 :
                                (localDepthGap <= 0.15 ? 34 :
                                (localDepthGap <= 0.30 ? 35 : 36));
            InterlockedAdd(_CarveStats[donorGapSlot], 1);

            uint donorReason = gsEdgeReasonTex[uint3(uint2(donorPx), 0)];
            bool dKilled = (donorReason & (1u << 7)) != 0;
            bool dSkirt = (donorReason & (1u << 2)) != 0;
            bool dCrossEye = (donorReason & (1u << 6)) != 0;
            bool dGrazing = (donorReason & (1u << 4)) != 0;
            bool dDual = (donorReason & (1u << 5)) != 0;
            bool dPlane = (donorReason & (1u << 3)) != 0;
            bool dSpanOrGap = (donorReason & ((1u << 0) | (1u << 1) | (1u << 8))) != 0;

            // 优先把“已杀却仍成为供体”单列为报警，其余原因保持互斥。
            uint donorReasonSlot = dKilled ? 44 :
                                   (dSkirt ? 40 :
                                   (dCrossEye ? 43 :
                                   (dGrazing ? 41 :
                                   (dDual ? 42 :
                                   (dPlane ? 38 :
                                   (dSpanOrGap ? 39 : 37))))));
            InterlockedAdd(_CarveStats[donorReasonSlot], 1);

            // 45..49 are mutually exclusive and should sum to propagated
            // donors (29..32): clean / known edge / invalid / jump / sparse.
            uint pathClass = admissionPathClass;
            InterlockedAdd(_CarveStats[45 + pathClass], 1);

            // 50..59 split long-range dilation by its actual jump-flood
            // provenance rather than inferring relay from endpoint distance.
            // One hop is a direct raw-depth fill candidate; two or more hops
            // reused an already-dilated result and are relay candidates.
            uint donorHops = admissionDonorHops;
            bool directFill = admissionDirectFill;
            bool pathBarrier = pathClass >= 1u && pathClass <= 3u;
            bool pathSparse = pathClass == 4u;
            if (directFill)
            {
                InterlockedAdd(_CarveStats[50], 1); // direct total
                InterlockedAdd(_CarveStats[pathSparse ? 53 : (pathBarrier ? 52 : 51)], 1);
            }
            else
            {
                InterlockedAdd(_CarveStats[54], 1); // relay total
                InterlockedAdd(_CarveStats[pathSparse ? 57 : (pathBarrier ? 56 : 55)], 1);
                InterlockedAdd(_CarveStats[donorHops == 2u ? 58 : 59], 1);
            }

            // 60..65 是生产闸命中归因。原因允许重叠：例如一个多跳供体也可能
            // 穿过无效带；60 是唯一总数，61..65 用来解释总数由什么构成。
            if (dilationPositiveWriteBlocked)
            {
                InterlockedAdd(_CarveStats[60], 1);
                if (admissionPathClass == 1u) InterlockedAdd(_CarveStats[61], 1);
                if (admissionPathClass == 2u) InterlockedAdd(_CarveStats[62], 1);
                if (admissionPathClass == 3u) InterlockedAdd(_CarveStats[63], 1);
                if (dilationBlockedByRelay) InterlockedAdd(_CarveStats[64], 1);
                if (dilationBlockedBySparse) InterlockedAdd(_CarveStats[65], 1);
            }
        }
    }

    float2 old = gsVolumeRW[coord];
    if (old.y < 0)
    {
        // 冻结体素穿越票：积分全停，但新观测若与存量几何矛盾，记进所属块票箱，
        // CPU 双门槛（票过阈且连续两窗过阈）解冻修复。判据与主矛盾通道同款 0.2
        // 噪声带：sDistNorm 在存量后方=自由空间票（真面被搬空），前方=遮挡票
        // （新家具挡进来）。质量门槛防低质掠射噪声买票；与扣减通道同理，rawGate
        // 拦写不拦票——射线明确反证存量时票照记。
        // 矛盾杆距离自适应：固定 0.2 归一化≈3cm，2m 外深度噪声（随距离增长）日常
        // 踩破它——纯噪声把票箱刷热、冻-解振荡（实机：解=冻的 2~3 倍）。与法绕
        // nrMargin 同款教训：裕量必须随距离放大。家具级真矛盾 ≥30cm，杆抬到
        // 5m≈10cm 也不误伤解冻修复。
        if (gsFrozenBlockEnable > 0.5 && gsFrozenChunkSize != 0 &&
            quality >= gsFrozenVoteQualityMin)
        {
            float frozenDelta = sDistNorm - old.x;
            float voteMargin = gsFrozenVoteMargin * max(depthEyeDist / 1.5, 1.0);
            if (abs(frozenDelta) > voteMargin)
            {
                uint frozenChunk = FrozenChunkIndexFromCoord(coord);
                if (frozenDelta > 0.0)
                    InterlockedAdd(_FrozenChunkVotes[frozenChunk].x, 1u); // 自由空间票
                else
                    InterlockedAdd(_FrozenChunkVotes[frozenChunk].y, 1u); // 遮挡票
            }
        }
        return; // frozen voxel — skip integration
    }
    float oldVal = old.x;
    float weight = max(old.y, 0);
    bool wasEmpty = weight < 0.001;

    // 弃权邻域写闸执行：只扣（矛盾成立时）不种/不长——切断帘锚点的零星复种
    if (nearAbstain)
    {
        bool c0 = sDistNorm > oldVal + 0.2;
        if (!wasEmpty && c0)
        {
            float abstainWeight = max(weight - max(q2 * gsCarveGain, 1.0 / 127.0), 0.0);
            WriteTrackedTsdf(coord, float2(oldVal, abstainWeight));
            if (gsWriteAdmissionTrace > 0.5)
            {
                uint oldTrace = DecodeAdmissionTrace(gsAdmissionTraceRW[coord]);
                gsAdmissionTraceRW[coord] = abstainWeight > 0.001
                    ? EncodeAdmissionTrace(oldTrace & ~4u)
                    : 0.0;
            }
        }
        return;
    }

    if (wasEmpty)
    {
        // 运动种子闸：快转帧不种新体素（假面出生口），但已存在的体素增长/扣减
        // 不受此闸影响（上面 wasEmpty 才进得来，空手 voxel 无扣减对象，直接返回
        // 无损）。60 阈断假面出生带，90 阈（C# 整帧闸）防涂抹，天棚慢扫帧大多
        // 落在 60 以下，生产力不受误伤。
        if (gsMotionSeedBlock > 0.0 && gsDiagnosticAngularSpeed > gsMotionSeedBlock)
        {
            InterlockedAdd(_CarveStats[90], 1); // 运动种子闸拦截
            return;
        }
        if (seedGateQuality >= MIN_QUALITY_SEED && !rawGateBlock && !dilationPositiveWriteBlocked)
        {
            // v2.1 生命周期：首次观测只建立不可出网的 provisional 状态。
            // 至少保留一个 R8 量化步长高于 prune，又至少一个量化步长低于
            // 正式表面阈值，确保它既能等下一帧晋升，也不会单帧直接成桥。
            float provisionalWeight = clamp(
                gsProvisionalSeedWeight,
                PRUNE_WEIGHT + 1.0 / 127.0,
                max(PRUNE_WEIGHT + 1.0 / 127.0,
                    gsFormalSurfaceWeight - 1.0 / 127.0));
            WriteTrackedTsdf(coord, float2(sDistNorm, provisionalWeight));
            InterlockedAdd(_CarveStats[68], 1);
            InterlockedAdd(_CarveStats[70u + admissionSource], 1u); // 71..73 seed source
            if (grazingPlaneRescued) InterlockedAdd(_CarveStats[74], 1u);
            if (nearAbstainNeighbour) InterlockedAdd(_CarveStats[75], 1u);
            if (gsDiagnosticAngularSpeed > 60.0) InterlockedAdd(_CarveStats[76], 1u);
            // Diagnostic sidecar follows every accepted TSDF write.  Restricting it
            // to the colour band leaves many Surface-Nets cell corners unclassified
            // even though those corners genuinely participated in the zero crossing.
            if (gsWriteAdmissionTrace > 0.5)
            {
                uint seedTrace = admissionSource |
                                 (rawGeometryConfirmed ? 4u : 0u) |
                                 currentAuditFlags;
                gsAdmissionTraceRW[coord] = EncodeAdmissionTrace(seedTrace);
            }

            if (gsWriteColor > 0.5 && gsCamAvailable && abs(sDistNorm) < COLOR_SURFACE_BAND)
            {
                float2 uv = ProjectToCameraUV(voxPos);
                if (uv.x > 0.02 && uv.x < 0.98 && uv.y > 0.02 && uv.y < 0.98)
                {
                    float4 camColor = gsCamRGB.SampleLevel(gsBilinearClampSampler, uv, 0);
                    float3 boosted = saturate(camColor.rgb * gsCamExposure);
                    gsColorVolumeRW[coord] = float4(boosted, quality * 0.1);
                }
            }
        }
        else if (seedGateQuality >= MIN_QUALITY_SEED && rawGateBlock)
        {
            InterlockedAdd(_CarveStats[rawGateFront ? 8 : 9], 1);
        }
        else if (seedGateQuality >= MIN_QUALITY_SEED && dilationPositiveWriteBlocked)
        {
            InterlockedAdd(_CarveStats[66], 1); // 危险膨胀路径拦播种
        }
        return;
    }

    // 矛盾扣减（投票制反对票）：新观测认为该体素比存量"更空"（超出 0.2≈3cm 噪声带）
    // → 直接扣信心 weight -= carveStep，不走 blend 地板——q 再小也照扣，
    // 把"低质量方向永不可抹"变成"慢但必然"。weight 跌破 minMeshWeight 网格消失，
    // 跌破 PRUNE_WEIGHT 被周期 Prune 回收，完成新陈代谢闭环。
    // 注意必须 clamp 到 0：负 weight 是 frozen 编码，不能误入。
    // v2 修复两个吞票缺陷：
    //  ① 矛盾帧不再加赞成增长（否则 -0.075q2 被同帧 +0.025q2 稀释）；
    //  ② carveStep 保底 1 个量化步长——体积是 R8G8_SNorm，weight 步长 1/127≈0.0079，
    //     Δw 小于半步(≈0.004)会被四舍五入归零，反对票投了但写盘无效（实机：普查"投"涨而幽灵不动）。
    bool contradicted = sDistNorm > oldVal + 0.2;
    // 自由空间对称扣减：主矛盾通道乘 gsFreeSpaceCarveBoost（默认 2，可关回 1）。
    // 新鲜正式面（刚转正 weight≈0.087）在 q≈0.5 时 2~3 票扣死——混合斜坡伪造品
    // 的多帧一致性反而加速它的死亡；成熟面权重基数大（≤0.5），同等倍率只擦皮，
    // 且成熟面有持续正视赞成票补给，天然免疫。
    float carveStep = max(q2 * gsCarveGain * gsFreeSpaceCarveBoost, 1.0 / 127.0);
    float carvedWeight = contradicted ? max(weight - carveStep, 0.0) : weight;

    // 外推闸只阻止假近表面的增长。若当前射线明确反证已有存量，照常扣权，
    // 避免把闸变成“只许旧错活、不许新证据改”的冻结通道。
    if (rawGateBlock || dilationPositiveWriteBlocked)
    {
        if (rawGateBlock)
            InterlockedAdd(_CarveStats[rawGateFront ? 8 : 9], 1);
        if (dilationPositiveWriteBlocked)
            InterlockedAdd(_CarveStats[67], 1); // 危险膨胀路径拦增长/改写
        if (contradicted)
        {
            WriteTrackedTsdf(coord, float2(oldVal, carvedWeight));
            if (gsWriteAdmissionTrace > 0.5)
            {
                uint oldTrace = DecodeAdmissionTrace(gsAdmissionTraceRW[coord]);
                gsAdmissionTraceRW[coord] = carvedWeight > 0.001
                    ? EncodeAdmissionTrace(oldTrace & ~4u)
                    : 0.0;
            }
        }
        return;
    }

    float blend = q2 * gsBlendRate / (1.0 + weight * gsStability);
    blend = clamp(blend, 0.0, 0.7);
    if (blend < 0.005)
    {
        // 赞成票太弱不配改写 TSDF，但反对票仍然生效（只扣信心，不动距离值）
        if (contradicted)
        {
            WriteTrackedTsdf(coord, float2(oldVal, carvedWeight));
            if (gsWriteAdmissionTrace > 0.5)
            {
                uint oldTrace = DecodeAdmissionTrace(gsAdmissionTraceRW[coord]);
                gsAdmissionTraceRW[coord] = carvedWeight > 0.001
                    ? EncodeAdmissionTrace(oldTrace & ~4u)
                    : 0.0;
            }
        }
        return;
    }

    float newTsdf = lerp(oldVal, sDistNorm, blend);
    // 矛盾帧只扣不增：反对票与赞成票同帧抵消是设计缺陷（v2 修复①）
    float newWeight = contradicted ? carvedWeight : min(weight + q2 * gsWeightGrowth, gsMaxWeight);
    // 救援降级①：救援样本不享快速转正——混合斜坡伪造品恰恰能产出"第二次一致原始
    // 观测"，快速转正对它不是防线而是加速器。救援面只能走自然增长慢慢爬到正式阈值。
    bool consistentRawRepeat = !contradicted && !grazingPlaneRescued &&
                               receiverOwnsRawDepth &&
                               rawGeometryConfirmed &&
                               abs(oldVal - sDistNorm) <= 0.35;
    bool fastPromotionApplied = false;
    if (consistentRawRepeat && weight < gsFormalSurfaceWeight)
    {
        // This path can only run for an already-existing provisional voxel, so
        // the current accepted raw observation is the required second vote.
        // Add one R8 SNORM step above the threshold: writing exactly 0.08 would
        // quantize to 10/127 and remain below the 0.08 meshing test.
        float quantizedFormalFloor = min(gsFormalSurfaceWeight + 1.0 / 127.0,
                                         gsMaxWeight);
        fastPromotionApplied = newWeight < gsFormalSurfaceWeight &&
                               quantizedFormalFloor >= gsFormalSurfaceWeight;
        newWeight = max(newWeight, quantizedFormalFloor);
    }
    bool promotedToFormal = weight < gsFormalSurfaceWeight &&
                            newWeight >= gsFormalSurfaceWeight;
    if (promotedToFormal)
    {
        InterlockedAdd(_CarveStats[69], 1); // provisional -> formal
        InterlockedAdd(_CarveStats[fastPromotionApplied ? 78u : 77u], 1u);
        uint priorTrace = DecodeAdmissionTrace(gsAdmissionTraceRW[coord]);
        uint birthSourceForAudit = priorTrace & 3u;
        if (birthSourceForAudit >= 1u && birthSourceForAudit <= 3u)
            InterlockedAdd(_CarveStats[81u + birthSourceForAudit], 1u); // 82..84
        else
            InterlockedAdd(_CarveStats[89], 1u);
        if (grazingPlaneRescued) InterlockedAdd(_CarveStats[79], 1u);
        if (nearAbstainNeighbour) InterlockedAdd(_CarveStats[80], 1u);
        if (gsDiagnosticAngularSpeed > 60.0) InterlockedAdd(_CarveStats[81], 1u);
        if (grazingPlaneRescued && nearAbstainNeighbour) InterlockedAdd(_CarveStats[85], 1u);
        if (grazingPlaneRescued && gsDiagnosticAngularSpeed > 60.0) InterlockedAdd(_CarveStats[86], 1u);
        if (nearAbstainNeighbour && gsDiagnosticAngularSpeed > 60.0) InterlockedAdd(_CarveStats[87], 1u);
        if (fastPromotionApplied && currentAuditFlags != 0u) InterlockedAdd(_CarveStats[88], 1u);
    }
    if (weight >= gsFormalSurfaceWeight && newWeight < gsFormalSurfaceWeight)
        InterlockedAdd(_CarveStats[70], 1); // formal -> below mesh threshold
    WriteTrackedTsdf(coord, float2(newTsdf, newWeight));
    if (gsWriteAdmissionTrace > 0.5)
    {
        uint oldTrace = DecodeAdmissionTrace(gsAdmissionTraceRW[coord]);
        uint birthSource = oldTrace & 3u;
        if (birthSource == 0u)
            birthSource = admissionSource;

        // A raw sample confirms geometry only when it agrees with both the
        // current projective narrow band and the already stored TSDF. A
        // contradiction revokes confirmation; a tiny stable update preserves
        // it so brief dropouts do not turn the ledger into a frame-presence bit.
        bool agreesWithStoredTsdf = abs(oldVal - sDistNorm) <= 0.35;
        bool confirmedNow = !contradicted && newWeight > 0.001 &&
                            rawGeometryConfirmed && agreesWithStoredTsdf;
        bool preserveStableConfirmation = !contradicted &&
                                          ((oldTrace & 4u) != 0u) &&
                                          abs(newTsdf - oldVal) <= 0.05;
        // 运动位(32u)出生定格：只从 oldTrace 继承（种子出生时定格），增长帧不再
        // OR 进来——旧版终身累积让任何一次快转帧最终污染体素全生命周期（三角级
        // 98% 饱和，失去区分度）。救援(8u)/临近弃权(16u)仍是累积型观察位。
        uint lifecycleAuditFlags = (oldTrace & 0x38u) | (currentAuditFlags & 0x18u) |
                                   (fastPromotionApplied ? 128u : 0u);
        uint updatedTrace = birthSource |
                            ((confirmedNow || preserveStableConfirmation) ? 4u : 0u) |
                            lifecycleAuditFlags;
        gsAdmissionTraceRW[coord] = newWeight > 0.001
            ? EncodeAdmissionTrace(updatedTrace)
            : 0.0;
    }

    if (gsWriteColor > 0.5 && gsCamAvailable && abs(sDistNorm) < COLOR_SURFACE_BAND)
    {
        float2 uv = ProjectToCameraUV(voxPos);
        if (uv.x > 0.02 && uv.x < 0.98 && uv.y > 0.02 && uv.y < 0.98)
        {
            float4 camColor = gsCamRGB.SampleLevel(gsBilinearClampSampler, uv, 0);
            float3 boosted = saturate(camColor.rgb * gsCamExposure);

            float4 oldColor = gsColorVolumeRW[coord];
            float colorBlend = quality * 0.3;
            float3 rgb = oldColor.a < 0.01 ? boosted : lerp(oldColor.rgb, boosted, colorBlend);
            float newAlpha = min(oldColor.a + quality * 0.05, 1.0);
            gsColorVolumeRW[coord] = float4(rgb, newAlpha);
        }
    }
}

#pragma kernel BakeRelocation
#pragma kernel FreezeInFrustum
#pragma kernel UnfreezeInFrustum

[numthreads(4, 4, 4)]
void FreezeInFrustum(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 vol = gsVolumeRW[id];
    if (vol.y <= 0) return; // empty or already frozen

    float3 worldPos = gsVoxelToWorld(id);
    float2 uv = ProjectToCameraUV(worldPos);
    if (uv.x < 0.01 || uv.x > 0.99 || uv.y < 0.01 || uv.y > 0.99)
        return;

    gsVolumeRW[id] = float2(vol.x, -vol.y);
}

[numthreads(4, 4, 4)]
void UnfreezeInFrustum(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 vol = gsVolumeRW[id];
    if (vol.y >= 0) return; // not frozen

    float3 worldPos = gsVoxelToWorld(id);
    float2 uv = ProjectToCameraUV(worldPos);
    if (uv.x < 0.01 || uv.x > 0.99 || uv.y < 0.01 || uv.y > 0.99)
        return;

    gsVolumeRW[id] = float2(vol.x, -vol.y);
}

// ──────────────────────────────────────────────────────────────────
//  逐块可逆冻结执行器：CPU 上传 set/clear 块位图，全体素过一遍翻符号。
//  set: weight>0 → 翻负（冻结）；clear: weight<0 → 翻正（解冻）。
//  abs(weight) 不变 → 提取层符号透明，不标脏、不重提网格；解冻块的
//  修复由后续正常积分自然标脏驱动。主卷与影子卷由 C# 换绑各跑一次。
// ──────────────────────────────────────────────────────────────────

#pragma kernel ApplyChunkFreezeMask
#pragma kernel ClearFrozenChunkVotes
#pragma kernel CountChunkMaturity

[numthreads(4, 4, 4)]
void ApplyChunkFreezeMask(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    if (gsFrozenChunkSize == 0) return;
    uint chunkIndex = FrozenChunkIndexFromCoord(id);
    uint word = chunkIndex >> 5;
    uint bit = 1u << (chunkIndex & 31u);

    float2 vol = gsVolumeRW[id];
    if (vol.y > 0.0 && (_ChunkFreezeSetMask[word] & bit) != 0u)
        gsVolumeRW[id] = float2(vol.x, -vol.y);
    else if (vol.y < 0.0 && (_ChunkFreezeClearMask[word] & bit) != 0u)
        gsVolumeRW[id] = float2(vol.x, -vol.y);
}

// 每线程一个块：本批解冻块的票箱清零（与 ApplyChunkFreezeMask 的 clear 位图同批）。
[numthreads(64, 1, 1)]
void ClearFrozenChunkVotes(uint3 id : SV_DispatchThreadID)
{
    uint total = gsFrozenChunkCount.x * gsFrozenChunkCount.y * gsFrozenChunkCount.z;
    if (id.x >= total) return;
    uint word = id.x >> 5;
    uint bit = 1u << (id.x & 31u);
    if ((_ChunkFreezeClearMask[word] & bit) != 0u)
        _FrozenChunkVotes[id.x] = uint2(0u, 0u);
}

// 逐块成熟度普查：只数"长熟体素"（abs(weight)≥gsFrozenMatureWeight 且 |sd|<0.3）。
// 关键：不能用 PRUNE_WEIGHT(08-18 起 0.03)——种子出生 0.04 就会入选，毛坯脚手架与长熟墙
// 计数无差别，权重增长（0.06→0.5）对普查不可见 → 块在毛坯期就被判"稳定"冻结，
// 永停出生权重（实机：天棚冻在 0.06 卡黄、红确认定格 41%）。长熟门槛下：毛坯块
// 计数≈0 不达下限；生长中的块计数在变=不稳定；只有真正饱和的块才冻。
// x=长熟体素数（含冻结） y=其中已冻结 z=可出网（≥minMeshWeight）体素数。
// z 槽=实时轨排队资格判据（T3：0.08~0.15 带可出网但不算长熟，只数长熟
// 会把该带误判"空块"永久拦在队外）。CPU 定期清零后 dispatch、回读判定。
[numthreads(4, 4, 4)]
void CountChunkMaturity(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    if (gsFrozenChunkSize == 0 || gsFrozenBlockEnable < 0.5) return;
    float2 vol = gsVolumeRW[id];
    float absWeight = abs(vol.y);
    if (abs(vol.x) >= 0.3) return;
    uint chunkIndex = FrozenChunkIndexFromCoord(id);
    if (absWeight >= gsDirtyMinWeight)
        InterlockedAdd(_ChunkMaturity[chunkIndex].z, 1u); // 可出网体素数
    if (absWeight < gsFrozenMatureWeight) return;
    InterlockedAdd(_ChunkMaturity[chunkIndex].x, 1u); // 长熟体素数
    if (vol.y < 0.0)
        InterlockedAdd(_ChunkMaturity[chunkIndex].y, 1u); // 其中已冻结
}

// ──────────────────────────────────────────────────────────────────
//  CountSurfaceCoverage: periodically count surface/frozen/colored
//  voxels for scan progress metrics. NOT dispatched every frame.
// ──────────────────────────────────────────────────────────────────

#pragma kernel CountSurfaceCoverage

RWStructuredBuffer<uint> _CoverageCounters; // [0]=surface, [1]=frozen, [2]=colored

Texture3D<float4> gsColorVolumeRead;

[numthreads(4, 4, 4)]
void CountSurfaceCoverage(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 tsdf = gsVolumeRW[id];
    float weight = tsdf.y;
    bool isFrozen = weight < 0;
    float absWeight = abs(weight);
    bool isSurface = absWeight > PRUNE_WEIGHT && abs(tsdf.x) < 0.3;

    if (isSurface)
    {
        InterlockedAdd(_CoverageCounters[0], 1);
        if (isFrozen)
            InterlockedAdd(_CoverageCounters[1], 1);
        float4 color = gsColorVolumeRead[id];
        if (color.a > 0.1)
            InterlockedAdd(_CoverageCounters[2], 1);
    }
}

// ──────────────────────────────────────────────────────────────────
//  BakeRelocation: resample TSDF+color from old grid into current
//  identity grid so volumeToWorld can be reset to I after loading.
// ──────────────────────────────────────────────────────────────────

Texture3D<float2> gsBakeSrcTsdf;
Texture3D<float4> gsBakeSrcColor;
Texture3D<float> gsBakeSrcAdmissionTrace;
float4x4 gsBakeInvRelocation;

[numthreads(4, 4, 4)]
void BakeRelocation(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;

    float3 dstLocal = ((float3)id + 0.5 - (float3)gsVoxCount / 2.0) * gsVoxSize;
    float3 srcLocal = mul(gsBakeInvRelocation, float4(dstLocal, 1)).xyz;

    float3 srcGrid = srcLocal / gsVoxSize + (float3)gsVoxCount / 2.0;
    float3 uvw = srcGrid / (float3)gsVoxCount;

    bool oob = any(uvw < 0.0) || any(uvw > 1.0);
    gsVolumeRW[id] = oob ? float2(GS_EMPTY_VOXEL, 0) : gsBakeSrcTsdf.SampleLevel(gsVolLinearClampSampler, uvw, 0);
    if (gsWriteColor > 0.5)
        gsColorVolumeRW[id] = oob ? float4(0, 0, 0, 0) : gsBakeSrcColor.SampleLevel(gsVolLinearClampSampler, uvw, 0);
    if (gsWriteAdmissionTrace > 0.5)
        gsAdmissionTraceRW[id] = oob ? 0.0 : gsBakeSrcAdmissionTrace.SampleLevel(gsVolPointClampSampler, uvw, 0);
}
