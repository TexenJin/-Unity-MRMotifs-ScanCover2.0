// GPU Surface Nets mesh extraction from TSDF volume
// Reads directly from RWTexture3D (no CPU readback), outputs compacted
// vertex + index buffers for procedural rendering.
//
// Dispatch sequence (C# orchestrator):
//   1. ClearCounters
//   2. ClassifyAndEmit  (3D over volume)
//   3. BuildVertexDispatchArgs  (1 thread)
//   4. [optional] InitSmooth -> N x SmoothVertices -> ApplySmooth
//   5. [optional] TemporalBlend
//   6. AccumulateVisualQualityVertices -> FitVisualQualityPlanes (read-only)
//   7. GenerateIndices  (indirect 1D over vertices)
//   8. BuildIndirectArgs  (1 thread)

#pragma kernel ClearCounters
#pragma kernel ClassifyAndEmit
#pragma kernel BuildFoundationClusters
#pragma kernel BuildVertexDispatchArgs
#pragma kernel InitSmooth
#pragma kernel SmoothVertices
#pragma kernel ApplySmooth
#pragma kernel TemporalBlend
#pragma kernel AccumulateVisualQualityVertices
#pragma kernel FitVisualQualityPlanes
#pragma kernel GenerateIndices
#pragma kernel BuildIndirectArgs
#pragma kernel InitTemporal
#pragma kernel ClearCandidateHistory
#pragma kernel CopyMeshSnapshot
#pragma kernel CopyCoordinateVertexMap
#pragma kernel CanonicalizeBoundarySnapshot
#pragma kernel CopyAdditiveMergePayload
#pragma kernel AppendNovelMatureTriangles
#pragma kernel BuildAdditiveMergeArgs
#pragma kernel CopyHeraVertexPayload
#pragma kernel FilterHeraCleanTriangles
#pragma kernel BuildHeraFilteredArgs
#pragma kernel ClassifyHeraInternalMixed
#pragma kernel BuildHeraInteriorShadowArgs
#pragma kernel BuildHeraBoundaryShadowArgs

#include "DepthKit.hlsl"

// ──────────────────────────────────────────────────────────────────
//  Volume textures (bound by VolumeIntegrator, read-only here)
// ──────────────────────────────────────────────────────────────────
Texture3D<float2> _TsdfVolume;     // R = signed distance [-1,1], G = weight [0,1]
Texture3D<float4> _ColorVolume;    // RGBA8 UNorm
Texture3D<float>  _AdmissionTraceVolume; // diagnostic-only dilation admission provenance
Texture2DArray<uint> gsEdgeReasonTex;

// ──────────────────────────────────────────────────────────────────
//  Parameters
// ──────────────────────────────────────────────────────────────────
uint3  _VoxCount;
int3   _MapMin;
uint3  _MapCount;
int3   _CoreMin;
int3   _CoreMax;
float  _VoxSize;
float  _MinWeight;
uint   _TotalVoxels;
uint   _MaxVertices;

float  _SmoothLambda;
float  _SmoothBeta;

float  _TemporalAlphaMax;
float  _TemporalAlphaMin;
float  _TemporalDecayRate;
float  _ConvergeThreshold;
float  _TemporalDeadzone;
float  _StrictObservedEdges;
float  _CurrentDepthEvidenceAvailable;
float  _CurrentEdgeEvidenceAvailable;
float  _DiagnosticRoiEnabled;
float4 _DiagnosticRoiRect;   // xMin, yMin, xMax, yMax in stereo depth UV
float2 _DiagnosticRoiSplitX; // near|edge and edge|far separators
uint   _CandidateExtractionEpoch;
uint   _CandidateHistoryUpdateEnabled;
uint   _CandidateHistoryCapacity;
uint   _CandidateHistoryMask;
uint   _FoundationTopologyMode;
uint   _FoundationCellStride;
uint   _FoundationFeatureRecognition;
float  _FoundationNormalClusterDotMin;
float  _FoundationCornerNormalDotMax;
float  _FoundationChamferWidthVoxels;
uint   _FoundationSimplifyEnabled;
float  _FoundationSimplifyNormalDotMin;
float  _FoundationSimplifyPlaneResidualVoxels;
uint   _FoundationVisibleSkirtVoxels;
uint   _LayerSeparationEnabled;
float  _LayerSeparationNormalDotMin;
float  _LayerSeparationDistanceVoxels;
uint   _GlobalCellOwnershipEnabled;
uint   _VisualQualityEnabled;
uint   _CounterCount;
uint   _StageResponsibilityBase;
uint   _StageResponsibilityEnabled;

// ──────────────────────────────────────────────────────────────────
//  GPU Vertex (32 bytes, matches StructuredBuffer in render shader)
// ──────────────────────────────────────────────────────────────────
struct GPUVertex
{
    float3 pos;
    float3 norm;
    uint   packedColor;
    uint   voxelFlatIdx;
};

// ──────────────────────────────────────────────────────────────────
//  Buffers
// ──────────────────────────────────────────────────────────────────
RWStructuredBuffer<int>       _CoordVertMap;     // [totalVoxels] flat idx -> compact vert idx (-1 = none)
RWStructuredBuffer<GPUVertex> _Vertices;         // [maxVertices] compact vertex output
RWStructuredBuffer<uint>      _Indices;          // [maxIndices]  triangle index output
// Packed read-only settlement classes per emitted cell:
// bits 0..2 = settled admission source (0=untracked, 1=self, 2=direct, 3=relay, 4=mixed)
// bits 3..4 = settled real confirmation (0=untracked, 1=pending, 2=confirmed, 3=mixed)
RWStructuredBuffer<uint>      _VertexAdmissionClass;
RWStructuredBuffer<GPUVertex> _SnapshotVertices;
RWStructuredBuffer<uint>      _SnapshotIndices;
RWStructuredBuffer<uint>      _SnapshotAdmissionClass;
RWStructuredBuffer<int>       _SnapshotCoordVertMap;
uint _SnapshotVertexCount;
uint _SnapshotIndexCount;
uint _SnapshotCoordMapCount;
uint _SnapshotMarkBoundaryVertices;

// Display-only proof bits for the boundary representative hand-off. They live
// above the production admission/lifecycle payload and never participate in
// extraction, topology or publication decisions.
static const uint kBoundaryCandidateBit = 1u << 27u;
static const uint kBoundaryCanonicalBit = 1u << 28u;

StructuredBuffer<GPUVertex> _BoundaryOwnerVertices;
StructuredBuffer<uint> _BoundaryOwnerAdmissionClass;
StructuredBuffer<int> _BoundaryOwnerCoordVertMap;
RWStructuredBuffer<GPUVertex> _BoundaryTargetVertices;
RWStructuredBuffer<uint> _BoundaryTargetAdmissionClass;
StructuredBuffer<int> _BoundaryTargetCoordVertMap;
int3 _BoundaryOwnerMapMin;
uint3 _BoundaryOwnerMapCount;
int3 _BoundaryTargetMapMin;
uint3 _BoundaryTargetMapCount;
int3 _BoundaryCopyMin;
uint3 _BoundaryCopyCount;
uint _BoundaryOwnerVertexCount;
uint _BoundaryTargetVertexCount;

// Conservative partial-publish path.  A spatially destructive candidate is
// never allowed to rewrite the accepted front buffer.  It may only append
// mature triangles whose exact 16^3 ownership cell was absent before.
StructuredBuffer<GPUVertex>   _PreviousVertices;
StructuredBuffer<uint>        _PreviousIndices;
StructuredBuffer<uint>        _PreviousAdmissionClass;
StructuredBuffer<uint>        _AcceptedSpatialOccupancy;
RWStructuredBuffer<GPUVertex> _MergeVertices;
RWStructuredBuffer<uint>      _MergeIndices;
RWStructuredBuffer<uint>      _MergeAdmissionClass;
RWStructuredBuffer<uint>      _MergeCounters;
RWStructuredBuffer<uint>      _MergeDrawIndirectArgs;
uint _PreviousVertexCount;
uint _PreviousIndexCount;
uint _CandidateVertexCount;
uint _CandidateIndexCount;

// HERA shadow extraction.  The source page remains immutable and is always the
// resident 32^3 baseline.  A 16^3 request is additive rescue/diagnosis only: it
// must never remove the corresponding parent triangle.
// [0] stored indices, [1] resident parent triangles, [2] fine-tier requests;
// [21] displayed red triangles; [22..25] confirmation classes.
// Read-only internal_mixed split (never affects heraClass or output indices).
// Broad contact ledger (any triangle touching an internal_mixed vertex):
// [3] real edge/corner, [4] suspected centre false conflict, [5] ambiguous.
// Final delegated ledger (only triangles actually delegated by HERA):
// [6] real edge/corner, [7] suspected centre false conflict, [8] ambiguous.
// [9] delegated transition without an internal_mixed vertex.
// [10] broad contact total: any triangle touching internal_mixed.
RWStructuredBuffer<uint>      _HeraFilterCounters;
RWStructuredBuffer<uint>      _HeraDrawIndirectArgs;
RWStructuredBuffer<uint>      _HeraInteriorShadowIndices;
RWStructuredBuffer<uint>      _HeraInteriorShadowDrawIndirectArgs;
RWStructuredBuffer<uint>      _HeraBoundaryShadowIndices;
RWStructuredBuffer<uint>      _HeraBoundaryShadowDrawIndirectArgs;
uint _HeraSourceIndexCount;
uint _HeraMatureOnly;

RWStructuredBuffer<uint>      _Counters;         // [0] = vertex count, [1] = index count
RWStructuredBuffer<uint>      _DispatchArgs;     // [0,1,2] = indirect dispatch group counts
RWStructuredBuffer<uint>      _DrawIndirectArgs; // [0..4]  = DrawProceduralIndirect args
RWStructuredBuffer<uint>      _LineDrawIndirectArgs; // same mesh, 3 triangle edges = indexCount * 2 line vertices

RWStructuredBuffer<float3>    _SmoothPosA;       // [maxVertices] ping-pong smoothing
RWStructuredBuffer<float3>    _SmoothPosB;       // [maxVertices] ping-pong smoothing
RWStructuredBuffer<uint>      _CandidateHistoryKeys;
RWStructuredBuffer<uint>      _CandidateHistoryStates;

RWTexture3D<float4>           _TemporalState;    // 3D texture: xyz = prev pos, w = age (-1 = uninit)

// Read-only visual-quality ledger.  It classifies the final mesh and retains
// same-epoch plane fits for TSDF edge crossings and raw Surface-Nets vertices.
// None of these counters writes vertices, indices, TSDF, admission or renderer
// state.
#define VISUAL_BIN_COUNT 64u
#define VISUAL_PRIMARY_COUNT 8u
#define VISUAL_FLAG_COUNT 11u
#define VISUAL_PRIMARY_BASE 1420u
#define VISUAL_FLAGS_BASE 1428u
#define VISUAL_RESIDUAL_HIST_BASE 1439u
#define VISUAL_NORMAL_HIST_BASE 1445u
#define VISUAL_TOTAL_INDEX 1450u
#define VISUAL_SPATIAL_PRIMARY_BASE 1451u
#define VISUAL_SPATIAL_FLAGS_BASE 1963u
#define VISUAL_PLANE_ACCUM_BASE 2667u
#define VISUAL_PLANE_ACCUM_STRIDE 10u
#define VISUAL_PLANE_MODEL_BASE 3307u
#define VISUAL_PLANE_MODEL_STRIDE 6u
#define VISUAL_BOUNDARY_BASE 3691u
#define VISUAL_BOUNDARY_FACE_RESOLUTION 65u
#define VISUAL_BOUNDARY_FACE_CELLS 4225u
#define STAGE_CROSSING_PLANE_ACCUM_OFFSET 0u
#define STAGE_CROSSING_PLANE_MODEL_OFFSET 640u
#define STAGE_RAW_PLANE_ACCUM_OFFSET 1024u
#define STAGE_RAW_PLANE_MODEL_OFFSET 1664u
#define STAGE_RESPONSIBILITY_COUNTER_COUNT 2048u
#define COUNTER_COUNT 31089u

uint VisualSpatialBin(int3 coord);
void VisualAccumulatePlanePointAt(uint accumBase, uint binIndex, float3 posVox);

// ──────────────────────────────────────────────────────────────────
//  Corner / edge tables  (Surface Nets cell topology)
// ──────────────────────────────────────────────────────────────────
static const int3 kCornerOffs[8] =
{
    int3(0,0,0), int3(1,0,0), int3(1,0,1), int3(0,0,1),
    int3(0,1,0), int3(1,1,0), int3(1,1,1), int3(0,1,1)
};
static const uint kEdgeA[12] = { 0,1,2,3, 4,5,6,7, 0,1,2,3 };
static const uint kEdgeB[12] = { 1,2,3,0, 5,6,7,4, 4,5,6,7 };

// ──────────────────────────────────────────────────────────────────
//  Helpers
// ──────────────────────────────────────────────────────────────────
int Flatten(int3 c)
{
    return c.x + c.y * (int)_VoxCount.x + c.z * (int)_VoxCount.x * (int)_VoxCount.y;
}

int3 Unflatten(int idx)
{
    uint uidx = (uint)idx;
    uint sliceXY = _VoxCount.x * _VoxCount.y;
    uint z = uidx / sliceXY;
    uint rem = uidx - z * sliceXY;
    uint y = rem / _VoxCount.x;
    uint x = rem - y * _VoxCount.x;
    return int3(x, y, z);
}

float3 VoxelCoordToWorld(float3 c)
{
    return (c + 0.5 - (float3)_VoxCount / 2.0) * _VoxSize;
}

uint PackColor(float4 c)
{
    return (uint)(saturate(c.r) * 255.0)
         | ((uint)(saturate(c.g) * 255.0) << 8)
         | ((uint)(saturate(c.b) * 255.0) << 16)
         | (255u << 24);
}

float SampleSDF(int3 coord)
{
    float2 s = _TsdfVolume[coord];
    if (s.x <= -0.99) return 0.0;
    if (abs(s.y) < _MinWeight) return 0.0;
    return s.x;
}

bool InsideMap(int3 c)
{
    int3 local = c - _MapMin;
    return all(local >= 0) && all(local < (int3)_MapCount);
}

int MapFlatten(int3 c)
{
    int3 local = c - _MapMin;
    return local.x + local.y * (int)_MapCount.x +
           local.z * (int)_MapCount.x * (int)_MapCount.y;
}

bool OwnsGlobalCell(int3 coord)
{
    return all(coord >= _CoreMin) && all(coord < _CoreMax);
}

float3 CanonicalLayerNormal(float3 normal)
{
    float3 magnitude = abs(normal);
    float signValue = magnitude.x >= magnitude.y && magnitude.x >= magnitude.z
        ? normal.x
        : (magnitude.y >= magnitude.z ? normal.y : normal.z);
    return signValue < 0.0 ? -normal : normal;
}

bool TrySampleObservedSDF(int3 coord, out float value)
{
    float2 s = _TsdfVolume[coord];
    // Weight is the authoritative observation mask. A valid truncated TSDF can
    // legitimately saturate at -1, so the distance channel is not an emptiness flag.
    bool observed = abs(s.y) >= _MinWeight;
    value = observed ? s.x : 0.0;
    return observed;
}

// Local TSDF gradient used only by the foundation feature recognizer. It is
// sampled at each real zero crossing, before the cell's normals/positions are
// averaged together. Missing neighbours fall back to a one-sided difference;
// no observation is invented and no value is written back to the TSDF.
bool TryFoundationGradient(float3 voxelPos, out float3 normal)
{
    int3 hi = max((int3)_VoxCount - 2, int3(1, 1, 1));
    int3 c = clamp((int3)round(voxelPos), int3(1, 1, 1), hi);

    float center;
    bool centerObserved = TrySampleObservedSDF(c, center);
    float xp, xm, yp, ym, zp, zm;
    bool hasXp = TrySampleObservedSDF(c + int3(1, 0, 0), xp);
    bool hasXm = TrySampleObservedSDF(c - int3(1, 0, 0), xm);
    bool hasYp = TrySampleObservedSDF(c + int3(0, 1, 0), yp);
    bool hasYm = TrySampleObservedSDF(c - int3(0, 1, 0), ym);
    bool hasZp = TrySampleObservedSDF(c + int3(0, 0, 1), zp);
    bool hasZm = TrySampleObservedSDF(c - int3(0, 0, 1), zm);

    float dx = hasXp && hasXm ? xp - xm :
               (centerObserved && hasXp ? xp - center :
               (centerObserved && hasXm ? center - xm : 0.0));
    float dy = hasYp && hasYm ? yp - ym :
               (centerObserved && hasYp ? yp - center :
               (centerObserved && hasYm ? center - ym : 0.0));
    float dz = hasZp && hasZm ? zp - zm :
               (centerObserved && hasZp ? zp - center :
               (centerObserved && hasZm ? center - zm : 0.0));

    float3 gradient = float3(dx, dy, dz);
    float gradientLengthSq = dot(gradient, gradient);
    if (gradientLengthSq <= 1e-6)
    {
        normal = float3(0.0, 1.0, 0.0);
        return false;
    }

    normal = gradient * rsqrt(gradientLengthSq);
    return true;
}

// Read-only current-geometry evidence for every emitted Surface-Nets vertex.
// This projects the already-emitted vertex into the current stereo depth frame;
// it never changes TSDF fusion, extraction, or topology. The older residual
// ledger consumes a subset, while the forensic ledger consumes the full set.
// Return classes: 0=current depth support, 1=history only,
// 2=current free-space contradiction, 3=edge/multi-hop evidence insufficient.
uint ClassifyCurrentGeometryEvidence(float3 worldPos, uint knownSourceMask, out uint roiZone)
{
    roiZone = 3u; // outside the diagnostic frame
    bool anyValidEye = false;
    bool anySupport = false;
    bool anyContradiction = false;
    bool anyOtherObservation = false;
    bool edgeEvidence = false;
    float2 projectedUvSum = float2(0.0, 0.0);
    uint projectedEyeCount = 0u;
    const float supportBandVoxels = 1.5;
    const float contradictionBandVoxels = 2.0;

    if (_CurrentDepthEvidenceAvailable > 0.5)
    {
        [unroll]
        for (int eye = 0; eye < 2; eye++)
        {
            float3 viewPos = mul(gsDepthView[eye], float4(worldPos, 1.0)).xyz;
            if (viewPos.z > -0.05)
                continue;

            float3 ndc = gsDepthWorldToNDC(worldPos, eye);
            if (ndc.x < 0.01 || ndc.x > 0.99 || ndc.y < 0.01 || ndc.y > 0.99)
                continue;

            // ROI membership is a projection fact, not a depth-validity fact.
            // Record it before rejecting invalid depth so the three-column sample
            // can still expose history-only and insufficient-evidence geometry.
            projectedUvSum += ndc.xy;
            projectedEyeCount++;

            float depthNdc = gsDepthSample(ndc.xy, eye);
            if (depthNdc <= 0.0 || depthNdc >= 1.0)
                continue;

            float3 depthWorld = gsDepthNDCtoWorld(float3(ndc.xy, depthNdc), eye);
            float3 eyePos = gsDepthEyePos(eye);
            float candidateRange = length(worldPos - eyePos);
            float measuredRange = length(depthWorld - eyePos);
            float gap = measuredRange - candidateRange;
            anyValidEye = true;

            if (abs(gap) <= _VoxSize * supportBandVoxels)
                anySupport = true;
            else if (gap > _VoxSize * contradictionBandVoxels)
                anyContradiction = true; // candidate lies in observed free space
            else
                anyOtherObservation = true; // candidate is occluded/behind the current hit

            if (_CurrentEdgeEvidenceAvailable > 0.5)
            {
                int2 maxPx = int2((int)gsDepthTexSize.x - 1, (int)gsDepthTexSize.y - 1);
                int2 px = clamp(int2(ndc.xy * float2(gsDepthTexSize)), int2(0, 0), maxPx);
                edgeEvidence = edgeEvidence || gsEdgeReasonTex[uint3(uint2(px), (uint)eye)] != 0u;
            }
        }
    }

    if (_DiagnosticRoiEnabled > 0.5 && projectedEyeCount > 0u)
    {
        float2 uv = projectedUvSum / (float)projectedEyeCount;
        bool inside = uv.x >= _DiagnosticRoiRect.x && uv.x <= _DiagnosticRoiRect.z &&
                      uv.y >= _DiagnosticRoiRect.y && uv.y <= _DiagnosticRoiRect.w;
        if (inside)
            roiZone = uv.x < _DiagnosticRoiSplitX.x ? 0u :
                      (uv.x < _DiagnosticRoiSplitX.y ? 1u : 2u);
    }

    bool multiKnownSource = knownSourceMask != 0u &&
                            (knownSourceMask & (knownSourceMask - 1u)) != 0u;
    bool relayOrMultiHop = (knownSourceMask & 4u) != 0u || multiKnownSource;

    // Conflicting stereo evidence is deliberately not promoted to support or
    // contradiction.  It belongs to the insufficient-evidence bucket.
    if (anySupport && anyContradiction)
        return 3u;
    if (anySupport)
        return 0u;
    if (anyContradiction && !anyOtherObservation)
        return 2u;
    if (edgeEvidence || relayOrMultiHop || (anyContradiction && anyOtherObservation))
        return 3u;
    return 1u; // no current observation, or only an occluded historical shell
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 0 : ClearCounters
// ══════════════════════════════════════════════════════════════════
[numthreads(256, 1, 1)]
void ClearCounters(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_CounterCount,
        _VisualQualityEnabled != 0u ? COUNTER_COUNT : 1420u);
    if (id.x < count)
        _Counters[id.x] = 0;
}

[numthreads(256, 1, 1)]
void ClearCandidateHistory(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _CandidateHistoryCapacity) return;
    _CandidateHistoryKeys[id.x] = 0u;
    _CandidateHistoryStates[id.x] = 0u;
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 1 : ClassifyAndEmit
//  3D dispatch: ceil(VoxCount / 4) per axis
//  Per voxel: check 12 edges, emit vertex via atomic if surface
// ══════════════════════════════════════════════════════════════════
[numthreads(4, 4, 4)]
void ClassifyAndEmit(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= _MapCount))
        return;

    int3 coord = _MapMin + (int3)id;
    int flatIdx = MapFlatten(coord);

    // The foundation route uses a globally anchored coarse lattice. Skipped
    // coordinates remain explicit holes in the regional lookup map, while
    // adjacent coarse cells still share one vertex. Never create a dense mesh
    // and discard alternating triangles: that would break connectivity.
    int cellStride = _FoundationTopologyMode != 0u
        ? max((int)_FoundationCellStride, 1)
        : 1;
    int3 coarseRemainder = coord - (coord / cellStride) * cellStride;
    if (any(coarseRemainder != int3(0, 0, 0)))
    {
        _CoordVertMap[flatIdx] = -1;
        return;
    }

    if (coord.x >= (int)_VoxCount.x - cellStride ||
        coord.y >= (int)_VoxCount.y - cellStride ||
        coord.z >= (int)_VoxCount.z - cellStride)
    {
        _CoordVertMap[flatIdx] = -1;
        return;
    }

    float3 posCoord = 0;
    float3 gradDir  = 0;
    uint numCrossings    = 0;
    uint numBadCrossings = 0;
    bool stageResponsibilityCell = _VisualQualityEnabled != 0u &&
        _StageResponsibilityEnabled != 0u &&
        all(coord >= _CoreMin) && all(coord < _CoreMax);
    uint responsibilityBin = 0u;
    float3 responsibilityCenter = float3(0.0, 0.0, 0.0);
    int3 crossingSum = int3(0, 0, 0);
    uint crossingXX = 0u;
    int crossingXY = 0;
    int crossingXZ = 0;
    uint crossingYY = 0u;
    int crossingYZ = 0;
    uint crossingZZ = 0u;
    if (stageResponsibilityCell)
    {
        responsibilityBin = VisualSpatialBin(coord);
        int3 responsibilityBinCoord = int3(
            (int)(responsibilityBin & 3u),
            (int)((responsibilityBin >> 2u) & 3u),
            (int)((responsibilityBin >> 4u) & 3u));
        int3 responsibilityExtent = max(_CoreMax - _CoreMin, int3(1, 1, 1));
        int3 responsibilityMin = _CoreMin +
            (responsibilityExtent * responsibilityBinCoord) / 4;
        int3 responsibilityMax = _CoreMin +
            (responsibilityExtent * (responsibilityBinCoord + 1)) / 4;
        responsibilityCenter = 0.5 *
            ((float3)responsibilityMin + (float3)responsibilityMax);
    }
    uint rejectedUnknownEdges = 0;
    bool foundationMultipleCrossings = false;
    bool anyObservedEndpoint = false;
    // Uniform 10 cm foundation cells are allowed to use only real, formally
    // supported 5 cm samples.  Treating an unknown endpoint as SDF zero was the
    // old source of coarse bridges across holes and unrelated depth layers.
    bool strictObserved = _StrictObservedEdges > 0.5 ||
                          (_FoundationTopologyMode != 0u && cellStride > 1);
    bool traceEndpointSeen = false;
    uint firstAdmissionSource = 0u;
    uint firstConfirmationState = 0u;
    bool admissionSourceMixed = false;
    bool confirmationStateMixed = false;
    // Read-only combination ledger payload. These masks retain the exact
    // endpoint classes collapsed into one Surface-Nets vertex. They never
    // participate in extraction, topology, or vertex placement.
    uint admissionSourceMask = 0u;       // bits 0..3: unknown/self/direct/relay
    uint confirmationStateMask = 0u;     // bits 0..2: unknown/pending/confirmed
    uint pendingSourceMask = 0u;         // bits 0..2: self/direct/relay seen pending
    uint confirmedSourceMask = 0u;       // bits 0..2: self/direct/relay seen confirmed
    uint lifecycleRiskMask = 0u;         // bits 0..4: plane/near-abstain/motion(birth-frozen)/retired/fast-promotion

    // Feature-placement witnesses. Each group accumulates zero-crossing
    // positions and their pre-averaging TSDF normals. A third unmatched family
    // makes the cell ambiguous rather than forcing a false corner.
    float3 featureNormalSum0 = float3(0.0, 0.0, 0.0);
    float3 featureNormalSum1 = float3(0.0, 0.0, 0.0);
    float3 featurePositionSum0 = float3(0.0, 0.0, 0.0);
    float3 featurePositionSum1 = float3(0.0, 0.0, 0.0);
    uint featureCount0 = 0u;
    uint featureCount1 = 0u;
    bool featureAmbiguous = false;

    // Optional two-sheet resolver. A genuine corner has divergent normals and
    // remains on the ordinary Surface-Nets path. Only near-parallel crossing
    // families separated along their common normal are treated as two depth
    // layers, so a flat wall/floor cannot be averaged into a false middle band.
    float3 layerReferenceNormal = float3(0.0, 0.0, 0.0);
    float3 layerPositionSum0 = float3(0.0, 0.0, 0.0);
    float3 layerPositionSum1 = float3(0.0, 0.0, 0.0);
    float3 layerNormalSum0 = float3(0.0, 0.0, 0.0);
    float3 layerNormalSum1 = float3(0.0, 0.0, 0.0);
    float layerOffsetSum0 = 0.0;
    float layerOffsetSum1 = 0.0;
    float layerSupport0 = 0.0;
    float layerSupport1 = 0.0;
    uint layerCount0 = 0u;
    uint layerCount1 = 0u;
    bool layerReferenceReady = false;
    bool layerSplitEligible = _LayerSeparationEnabled != 0u;
    bool layerThirdFamily = false;
    float layerCornerSdf[8];
    if (_LayerSeparationEnabled != 0u)
    {
        // The product route is native stride-1. Cache its eight corner samples
        // once, then derive a trilinear gradient for every crossing without
        // adding seven texture reads per crossing.
        if (cellStride != 1)
            layerSplitEligible = false;
        [unroll]
        for (uint layerCorner = 0u; layerCorner < 8u; layerCorner++)
        {
            float cornerValue;
            bool cornerObserved = TrySampleObservedSDF(
                coord + kCornerOffs[layerCorner], cornerValue);
            layerCornerSdf[layerCorner] = cornerValue;
            layerSplitEligible = layerSplitEligible && cornerObserved;
        }
    }

    [unroll]
    for (uint e = 0; e < 12; e++)
    {
        int3 cA = coord + kCornerOffs[kEdgeA[e]] * cellStride;
        int3 cB = coord + kCornerOffs[kEdgeB[e]] * cellStride;

        float2 sA = _TsdfVolume[cA];
        float2 sB = _TsdfVolume[cB];

        // A 10 cm edge is not sampled as one long chord.  Bracket its zero
        // crossing on the two native 5 cm segments so depth remains tied to the
        // fine TSDF.  All three nodes must be formally readable.  Two crossings
        // on one coarse edge mean multiple layers inside the cell; reject that
        // cell rather than average the layers into a false surface.
        if (_FoundationTopologyMode != 0u && cellStride == 2)
        {
            int3 cMid = (cA + cB) / 2;
            float2 sMid = _TsdfVolume[cMid];
            bool observedA = abs(sA.y) >= _MinWeight;
            bool observedMid = abs(sMid.y) >= _MinWeight;
            bool observedB = abs(sB.y) >= _MinWeight;
            if (!observedA || !observedMid || !observedB)
            {
                rejectedUnknownEdges++;
                continue;
            }

            bool crossesFirst = (sA.x < 0.0) != (sMid.x < 0.0);
            bool crossesSecond = (sMid.x < 0.0) != (sB.x < 0.0);
            if (crossesFirst && crossesSecond)
            {
                foundationMultipleCrossings = true;
                continue;
            }
            if (!crossesFirst && !crossesSecond)
                continue;
            if (crossesFirst)
            {
                cB = cMid;
                sB = sMid;
            }
            else
            {
                cA = cMid;
                sA = sMid;
            }
        }

        bool emptyA;
        bool emptyB;
        if (strictObserved)
        {
            emptyA = abs(sA.y) < _MinWeight;
            emptyB = abs(sB.y) < _MinWeight;
        }
        else
        {
            emptyA = (sA.x <= -0.99);
            emptyB = (sB.x <= -0.99);
            if (!emptyA && abs(sA.y) < _MinWeight) emptyA = true;
            if (!emptyB && abs(sB.y) < _MinWeight) emptyB = true;
        }

        anyObservedEndpoint = anyObservedEndpoint || !emptyA || !emptyB;
        if (strictObserved && (emptyA || emptyB))
        {
            rejectedUnknownEdges++;
            continue;
        }

        float valA = emptyA ? 0.0 : sA.x;
        float valB = emptyB ? 0.0 : sB.x;

        float change = valA - valB;
        gradDir += (float3)(cA - cB) * change;

        bool crosses = (valA < 0) != (valB < 0);
        if (crosses)
        {
            if (emptyA || emptyB) numBadCrossings++;
            float t = valA / change;
            float3 crossingPosition = (float3)cA + t * (float3)(cB - cA);
            posCoord += crossingPosition;
            numCrossings++;

            if (_LayerSeparationEnabled != 0u)
            {
                float3 localCrossing = saturate(crossingPosition - (float3)coord);
                float dx0 = lerp(layerCornerSdf[1] - layerCornerSdf[0],
                                 layerCornerSdf[5] - layerCornerSdf[4],
                                 localCrossing.y);
                float dx1 = lerp(layerCornerSdf[2] - layerCornerSdf[3],
                                 layerCornerSdf[6] - layerCornerSdf[7],
                                 localCrossing.y);
                float dy0 = lerp(layerCornerSdf[4] - layerCornerSdf[0],
                                 layerCornerSdf[5] - layerCornerSdf[1],
                                 localCrossing.x);
                float dy1 = lerp(layerCornerSdf[7] - layerCornerSdf[3],
                                 layerCornerSdf[6] - layerCornerSdf[2],
                                 localCrossing.x);
                float dz0 = lerp(layerCornerSdf[3] - layerCornerSdf[0],
                                 layerCornerSdf[2] - layerCornerSdf[1],
                                 localCrossing.x);
                float dz1 = lerp(layerCornerSdf[7] - layerCornerSdf[4],
                                 layerCornerSdf[6] - layerCornerSdf[5],
                                 localCrossing.x);
                float3 crossingGradient = float3(
                    lerp(dx0, dx1, localCrossing.z),
                    lerp(dy0, dy1, localCrossing.z),
                    lerp(dz0, dz1, localCrossing.y));
                float gradientLengthSq = dot(crossingGradient, crossingGradient);
                if (!layerSplitEligible || gradientLengthSq <= 1e-6)
                {
                    // Missing gradient evidence must never invent a layer
                    // split. Fall back to the unchanged SN average.
                    layerSplitEligible = false;
                }
                else
                {
                    float3 crossingLayerNormal = crossingGradient *
                        rsqrt(gradientLengthSq);
                    crossingLayerNormal = CanonicalLayerNormal(crossingLayerNormal);
                    if (!layerReferenceReady)
                    {
                        layerReferenceNormal = crossingLayerNormal;
                        layerReferenceReady = true;
                    }

                    float normalAlignment = dot(crossingLayerNormal,
                                                layerReferenceNormal);
                    if (normalAlignment < _LayerSeparationNormalDotMin)
                    {
                        // Differing normal families describe a corner or
                        // curvature, not two parallel sheets.
                        layerSplitEligible = false;
                    }
                    else
                    {
                        float layerOffset = dot(crossingPosition,
                                                layerReferenceNormal);
                        float crossingSupport = min(abs(sA.y), abs(sB.y));
                        if (layerCount0 == 0u)
                        {
                            layerPositionSum0 = crossingPosition;
                            layerNormalSum0 = crossingLayerNormal;
                            layerOffsetSum0 = layerOffset;
                            layerSupport0 = crossingSupport;
                            layerCount0 = 1u;
                        }
                        else
                        {
                            float meanOffset0 = layerOffsetSum0 / (float)layerCount0;
                            float distance0 = abs(layerOffset - meanOffset0);
                            if (distance0 <= _LayerSeparationDistanceVoxels)
                            {
                                layerPositionSum0 += crossingPosition;
                                layerNormalSum0 += crossingLayerNormal;
                                layerOffsetSum0 += layerOffset;
                                layerSupport0 += crossingSupport;
                                layerCount0++;
                            }
                            else if (layerCount1 == 0u)
                            {
                                layerPositionSum1 = crossingPosition;
                                layerNormalSum1 = crossingLayerNormal;
                                layerOffsetSum1 = layerOffset;
                                layerSupport1 = crossingSupport;
                                layerCount1 = 1u;
                            }
                            else
                            {
                                float meanOffset1 = layerOffsetSum1 / (float)layerCount1;
                                float distance1 = abs(layerOffset - meanOffset1);
                                if (min(distance0, distance1) >
                                    _LayerSeparationDistanceVoxels)
                                {
                                    layerThirdFamily = true;
                                }
                                else if (distance0 <= distance1)
                                {
                                    layerPositionSum0 += crossingPosition;
                                    layerNormalSum0 += crossingLayerNormal;
                                    layerOffsetSum0 += layerOffset;
                                    layerSupport0 += crossingSupport;
                                    layerCount0++;
                                }
                                else
                                {
                                    layerPositionSum1 += crossingPosition;
                                    layerNormalSum1 += crossingLayerNormal;
                                    layerOffsetSum1 += layerOffset;
                                    layerSupport1 += crossingSupport;
                                    layerCount1++;
                                }
                            }
                        }
                    }
                }
            }
            if (stageResponsibilityCell)
            {
                int3 q = (int3)round(clamp(
                    (crossingPosition - responsibilityCenter) * 4.0,
                    -127.0, 127.0));
                crossingSum += q;
                crossingXX += (uint)(q.x * q.x);
                crossingXY += q.x * q.y;
                crossingXZ += q.x * q.z;
                crossingYY += (uint)(q.y * q.y);
                crossingYZ += q.y * q.z;
                crossingZZ += (uint)(q.z * q.z);
            }

            if (_FoundationFeatureRecognition != 0u &&
                !emptyA && !emptyB)
            {
                float3 crossingNormal;
                if (TryFoundationGradient(crossingPosition, crossingNormal))
                {
                    if (featureCount0 == 0u)
                    {
                        featureNormalSum0 = crossingNormal;
                        featurePositionSum0 = crossingPosition;
                        featureCount0 = 1u;
                    }
                    else
                    {
                        float3 normal0 = normalize(featureNormalSum0);
                        float alignment0 = dot(crossingNormal, normal0);
                        float alignment1 = featureCount1 > 0u
                            ? dot(crossingNormal, normalize(featureNormalSum1))
                            : -2.0;

                        if (alignment0 >= _FoundationNormalClusterDotMin &&
                            alignment0 >= alignment1)
                        {
                            featureNormalSum0 += crossingNormal;
                            featurePositionSum0 += crossingPosition;
                            featureCount0++;
                        }
                        else if (featureCount1 == 0u)
                        {
                            featureNormalSum1 = crossingNormal;
                            featurePositionSum1 = crossingPosition;
                            featureCount1 = 1u;
                        }
                        else if (alignment1 >= _FoundationNormalClusterDotMin)
                        {
                            featureNormalSum1 += crossingNormal;
                            featurePositionSum1 += crossingPosition;
                            featureCount1++;
                        }
                        else
                        {
                            featureAmbiguous = true;
                        }
                    }
                }
            }

            // Only endpoints of edges that actually contributed a zero
            // crossing may settle the emitted cell's ledgers. Reading all eight
            // corners lets unrelated nearby history contaminate the result.
            uint traceA = (uint)clamp((int)round(saturate(_AdmissionTraceVolume[cA]) * 255.0), 0, 255);
            uint traceB = (uint)clamp((int)round(saturate(_AdmissionTraceVolume[cB]) * 255.0), 0, 255);
            uint sourceA = traceA & 3u;
            uint sourceB = traceB & 3u;
            uint confirmA = sourceA == 0u ? 0u : (((traceA & 4u) != 0u) ? 2u : 1u);
            uint confirmB = sourceB == 0u ? 0u : (((traceB & 4u) != 0u) ? 2u : 1u);

            admissionSourceMask |= 1u << sourceA;
            admissionSourceMask |= 1u << sourceB;
            confirmationStateMask |= 1u << confirmA;
            confirmationStateMask |= 1u << confirmB;
            if (sourceA > 0u && confirmA == 1u) pendingSourceMask |= 1u << (sourceA - 1u);
            if (sourceB > 0u && confirmB == 1u) pendingSourceMask |= 1u << (sourceB - 1u);
            if (sourceA > 0u && confirmA == 2u) confirmedSourceMask |= 1u << (sourceA - 1u);
            if (sourceB > 0u && confirmB == 2u) confirmedSourceMask |= 1u << (sourceB - 1u);
            lifecycleRiskMask |= (traceA >> 3u) & 31u;
            lifecycleRiskMask |= (traceB >> 3u) & 31u;

            if (!traceEndpointSeen)
            {
                firstAdmissionSource = sourceA;
                firstConfirmationState = confirmA;
                traceEndpointSeen = true;
            }
            admissionSourceMixed = admissionSourceMixed || sourceA != firstAdmissionSource;
            confirmationStateMixed = confirmationStateMixed || confirmA != firstConfirmationState;
            admissionSourceMixed = admissionSourceMixed || sourceB != firstAdmissionSource;
            confirmationStateMixed = confirmationStateMixed || confirmB != firstConfirmationState;
        }
    }

    if (strictObserved && anyObservedEndpoint && rejectedUnknownEdges > 0)
    {
        InterlockedAdd(_Counters[2], rejectedUnknownEdges);
        if (numCrossings > 0)
            InterlockedAdd(_Counters[3], 1);
    }

    if (foundationMultipleCrossings || numCrossings < 3 ||
        numCrossings == numBadCrossings)
    {
        _CoordVertMap[flatIdx] = -1;
        return;
    }

    if (_LayerSeparationEnabled != 0u && layerSplitEligible &&
        layerReferenceReady && layerCount0 > 0u && layerCount1 > 0u)
    {
        float meanOffset0 = layerOffsetSum0 / (float)layerCount0;
        float meanOffset1 = layerOffsetSum1 / (float)layerCount1;
        bool separated = abs(meanOffset0 - meanOffset1) >
                         _LayerSeparationDistanceVoxels;
        if (separated)
        {
            // Three distinct parallel sheets cannot be resolved safely inside
            // one cell. A temporary hole is preferable to a false bridge.
            if (layerThirdFamily)
            {
                _CoordVertMap[flatIdx] = -1;
                return;
            }

            // Stronger observation support wins. Crossing count is the first
            // tie-break, then accumulated TSDF weight. The final canonical
            // offset tie-break is global and deterministic, so neighbouring
            // blocks cannot choose opposite sheets merely from dispatch order.
            bool chooseLayer1 = layerCount1 > layerCount0 ||
                (layerCount1 == layerCount0 && layerSupport1 > layerSupport0 + 1e-5) ||
                (layerCount1 == layerCount0 &&
                 abs(layerSupport1 - layerSupport0) <= 1e-5 &&
                 meanOffset1 < meanOffset0);
            uint selectedCount = chooseLayer1 ? layerCount1 : layerCount0;
            if (selectedCount < 3u)
            {
                _CoordVertMap[flatIdx] = -1;
                return;
            }

            posCoord = chooseLayer1 ? layerPositionSum1 : layerPositionSum0;
            gradDir = chooseLayer1 ? layerNormalSum1 : layerNormalSum0;
            numCrossings = selectedCount;
        }
    }

    posCoord /= (float)numCrossings;
    float3 rawSurfaceNetsPosition = posCoord;

    // Same candidate, same page-local bin, same dirty epoch: preserve the two
    // pre-paper geometric stages before any optional feature placement,
    // simplification, smoothing or temporal blend.  Rejected cells never enter
    // this ledger, so the crossing cloud and raw representative describe only
    // geometry that can contribute to the candidate surface.
    if (stageResponsibilityCell)
    {
        uint crossingBase = _StageResponsibilityBase +
            STAGE_CROSSING_PLANE_ACCUM_OFFSET +
            responsibilityBin * VISUAL_PLANE_ACCUM_STRIDE;
        InterlockedAdd(_Counters[crossingBase], numCrossings);
        InterlockedAdd(_Counters[crossingBase + 1u], (uint)crossingSum.x);
        InterlockedAdd(_Counters[crossingBase + 2u], (uint)crossingSum.y);
        InterlockedAdd(_Counters[crossingBase + 3u], (uint)crossingSum.z);
        InterlockedAdd(_Counters[crossingBase + 4u], crossingXX);
        InterlockedAdd(_Counters[crossingBase + 5u], (uint)crossingXY);
        InterlockedAdd(_Counters[crossingBase + 6u], (uint)crossingXZ);
        InterlockedAdd(_Counters[crossingBase + 7u], crossingYY);
        InterlockedAdd(_Counters[crossingBase + 8u], (uint)crossingYZ);
        InterlockedAdd(_Counters[crossingBase + 9u], crossingZZ);
        VisualAccumulatePlanePointAt(
            _StageResponsibilityBase + STAGE_RAW_PLANE_ACCUM_OFFSET,
            responsibilityBin,
            rawSurfaceNetsPosition);
    }

    // Two stable, non-opposed normal families describe an actual edge. Fit a
    // plane to each family, solve their shared corner nearest the ordinary
    // Surface-Nets point, then retreat a fixed distance along the angle
    // bisector. That produces one consistent chamfer band instead of letting
    // a noisy mixture pull every corner cell to a different arbitrary point.
    bool foundationCorner = false;
    if (_FoundationFeatureRecognition != 0u &&
        !featureAmbiguous &&
        featureCount0 >= 2u && featureCount1 >= 2u)
    {
        float coherence0 = length(featureNormalSum0) / (float)featureCount0;
        float coherence1 = length(featureNormalSum1) / (float)featureCount1;
        float3 featureNormal0 = normalize(featureNormalSum0);
        float3 featureNormal1 = normalize(featureNormalSum1);
        float normalDot = dot(featureNormal0, featureNormal1);

        // Nearly opposite families are the two sides of a thin object, not a
        // bevel. Three-family cells were marked ambiguous above. The upper
        // bound rejects ordinary curvature and noisy single planes.
        if (coherence0 >= 0.90 && coherence1 >= 0.90 &&
            normalDot > -0.25 && normalDot <= _FoundationCornerNormalDotMax)
        {
            float3 planePoint0 = featurePositionSum0 / (float)featureCount0;
            float3 planePoint1 = featurePositionSum1 / (float)featureCount1;
            float rhs0 = dot(featureNormal0, planePoint0) - dot(featureNormal0, posCoord);
            float rhs1 = dot(featureNormal1, planePoint1) - dot(featureNormal1, posCoord);
            float denominator = 1.0 - normalDot * normalDot;

            if (denominator > 0.05)
            {
                float alpha = (rhs0 - normalDot * rhs1) / denominator;
                float beta = (rhs1 - normalDot * rhs0) / denominator;
                float3 cornerPoint = posCoord + alpha * featureNormal0 + beta * featureNormal1;
                float3 bisector = featureNormal0 + featureNormal1;
                float bisectorLengthSq = dot(bisector, bisector);

                if (bisectorLengthSq > 1e-5)
                {
                    bisector *= rsqrt(bisectorLengthSq);
                    float3 chamferDirection = bisector;
                    // TSDF sign conventions may reverse both normals. Choose
                    // the side containing the cell's ordinary crossing mean;
                    // the bevel therefore remains inside the observed cell.
                    if (dot(chamferDirection, posCoord - cornerPoint) < 0.0)
                        chamferDirection = -chamferDirection;

                    float maxInset = max(0.0, dot(posCoord - cornerPoint, chamferDirection));
                    float inset = min(_FoundationChamferWidthVoxels, maxInset);
                    float3 chamferPoint = cornerPoint + chamferDirection * inset;
                    float edgeMargin = min(0.15, (float)cellStride * 0.1);
                    posCoord = clamp(chamferPoint,
                                     (float3)coord + edgeMargin,
                                     (float3)(coord + cellStride) - edgeMargin);
                    // Shading keeps the TSDF-consistent angle-bisector normal;
                    // only the positional retreat chooses the in-cell side.
                    gradDir = bisector;
                    foundationCorner = true;
                }
            }
        }
    }

    float3 worldPos = VoxelCoordToWorld(posCoord);
    float3 norm = normalize(gradDir);

    float4 col = _ColorVolume[coord];
    // Threshold must stay below ~2/255: after save/load, coverage alpha is quantized to 8-bit
    // and can dip slightly below 0.04 even when rgb is valid — old cutoff forced dark gray verts.
    uint packed = (col.a > 0.008) ? PackColor(col) : PackColor(float4(0.078, 0.078, 0.098, 1.0));

    uint compactIdx;
    InterlockedAdd(_Counters[0], 1, compactIdx);

    if (compactIdx >= _MaxVertices)
    {
        // This cell was active in the current TSDF but could not obtain a
        // current vertex slot.  Never leave its previous extraction's map
        // entry alive: a later face would otherwise connect current vertices
        // to an unrelated stale vertex and produce a long scar triangle.
        _CoordVertMap[flatIdx] = -1;
        return;
    }

    if (strictObserved)
        InterlockedAdd(_Counters[5], 1);

    // Ledger A = immutable birth source; Ledger B = geometric confirmation.
    // Unknown mixed with known is deliberately "mixed", never silently promoted.
    uint pathClass = !traceEndpointSeen ? 0u :
                     (admissionSourceMixed ? 4u : firstAdmissionSource);
    uint confirmationClass = !traceEndpointSeen ? 0u :
                             (confirmationStateMixed ? 3u : firstConfirmationState);

    // Read-only per-vertex evidence used by the two-colour temporal display.
    // It is packed into previously-unused high bits and never feeds extraction.
    uint diagnosticKnownSourceMask = (admissionSourceMask >> 1u) & 7u;
    uint diagnosticRoiZone = 3u;
    uint diagnosticEvidenceClass = 1u;
    if (_DiagnosticRoiEnabled > 0.5)
        diagnosticEvidenceClass = ClassifyCurrentGeometryEvidence(
            worldPos, diagnosticKnownSourceMask, diagnosticRoiZone);

    // Keep the original low five bits byte-for-byte compatible with the
    // renderer. High bits are diagnostic-only masks.
    _VertexAdmissionClass[compactIdx] = pathClass |
                                        (confirmationClass << 3u) |
                                        (admissionSourceMask << 5u) |
                                        (confirmationStateMask << 9u) |
                                        (pendingSourceMask << 12u) |
                                        (confirmedSourceMask << 15u) |
                                        (diagnosticEvidenceClass << 18u) |
                                        (diagnosticRoiZone << 20u) |
                                        (lifecycleRiskMask << 22u);
    InterlockedAdd(_Counters[6u + (pathClass == 0u ? 4u : pathClass - 1u)], 1u);
    InterlockedAdd(_Counters[11u + (confirmationClass == 0u ? 3u : confirmationClass - 1u)], 1u);
    // Read-only joint ledger: 5 admission classes x 4 confirmation classes.
    // 24..43 are emitted cells. This does not participate in admission.
    InterlockedAdd(_Counters[24u + pathClass * 4u + confirmationClass], 1u);

    // 75..93: unique emitted-vertex combination ledger for the dominant
    // same-vertex double-mixed population. Each of the three partitions
    // independently sums to counter 75.
    if (pathClass == 4u && confirmationClass == 3u)
    {
        InterlockedAdd(_Counters[75u], 1u);

        uint knownSourceMask = (admissionSourceMask >> 1u) & 7u;
        bool hasUnknownSource = (admissionSourceMask & 1u) != 0u;
        uint sourceBucket = hasUnknownSource ? 76u :
                            (knownSourceMask == 3u ? 77u :
                            (knownSourceMask == 5u ? 78u :
                            (knownSourceMask == 6u ? 79u :
                            (knownSourceMask == 7u ? 80u : 81u))));
        InterlockedAdd(_Counters[sourceBucket], 1u);

        uint confirmationBucket = confirmationStateMask == 3u ? 82u :
                                  (confirmationStateMask == 5u ? 83u :
                                  (confirmationStateMask == 6u ? 84u :
                                  (confirmationStateMask == 7u ? 85u : 86u)));
        InterlockedAdd(_Counters[confirmationBucket], 1u);

        uint associationBucket = 93u;
        if (!hasUnknownSource && knownSourceMask == 3u &&
            pendingSourceMask == 1u && confirmedSourceMask == 2u)
            associationBucket = 87u;
        else if (!hasUnknownSource && knownSourceMask == 3u &&
                 pendingSourceMask == 2u && confirmedSourceMask == 1u)
            associationBucket = 88u;
        else if (!hasUnknownSource && knownSourceMask == 5u &&
                 pendingSourceMask == 1u && confirmedSourceMask == 4u)
            associationBucket = 89u;
        else if (!hasUnknownSource && knownSourceMask == 5u &&
                 pendingSourceMask == 4u && confirmedSourceMask == 1u)
            associationBucket = 90u;
        else if (!hasUnknownSource && knownSourceMask == 6u &&
                 pendingSourceMask == 2u && confirmedSourceMask == 4u)
            associationBucket = 91u;
        else if (!hasUnknownSource && knownSourceMask == 6u &&
                 pendingSourceMask == 4u && confirmedSourceMask == 2u)
            associationBucket = 92u;
        InterlockedAdd(_Counters[associationBucket], 1u);

        // 94..115: exhaustive read-only split of the old association fallback
        // (counter 93).  The first 16 buckets form a 4x4 cross-table for
        // unknown-source vertices.  The final six buckets explain every
        // known-source-only residual.  Exactly one sub-bucket is incremented
        // whenever associationBucket == 93, so 94..115 must sum to counter 93.
        if (associationBucket == 93u)
        {
            uint residualBucket;
            if (hasUnknownSource)
            {
                // Rows: unknown+self, unknown+direct, unknown+relay,
                // unknown+multiple/other known sources.
                uint knownGroup = knownSourceMask == 1u ? 0u :
                                  (knownSourceMask == 2u ? 1u :
                                  (knownSourceMask == 4u ? 2u : 3u));
                // Columns: unknown+pending, unknown+confirmed,
                // pending+confirmed, all-three/other confirmation states.
                uint confirmationGroup = confirmationStateMask == 3u ? 0u :
                                         (confirmationStateMask == 5u ? 1u :
                                         (confirmationStateMask == 6u ? 2u : 3u));
                residualBucket = 94u + knownGroup * 4u + confirmationGroup;

                // 116..119: final, mutually exclusive decision-oriented split
                // of the unknown-source residual subset (94..109).  These four
                // counters must sum exactly to counters 94..109.
                InterlockedAdd(_Counters[116u + diagnosticEvidenceClass], 1u);
                if (diagnosticRoiZone < 3u)
                    InterlockedAdd(_Counters[120u + diagnosticRoiZone * 4u + diagnosticEvidenceClass], 1u);
            }
            else
            {
                bool hasUnknownConfirmation = (confirmationStateMask & 1u) != 0u;
                uint overlapMask = pendingSourceMask & confirmedSourceMask;
                bool pendingMulti = (pendingSourceMask & (pendingSourceMask - 1u)) != 0u;
                bool confirmedMulti = (confirmedSourceMask & (confirmedSourceMask - 1u)) != 0u;

                // Hierarchical, disjoint explanation of known-source-only
                // residuals.  Counter 115 is an invariant-violation sentinel,
                // not a normal catch-all category.
                residualBucket = hasUnknownConfirmation ? 110u :
                                 (overlapMask != 0u ? 111u :
                                 (knownSourceMask == 7u ? 112u :
                                 (pendingSourceMask == 0u || confirmedSourceMask == 0u ? 113u :
                                 (pendingMulti || confirmedMulti ? 114u : 115u))));
            }
            InterlockedAdd(_Counters[residualBucket], 1u);
        }
    }

    GPUVertex v;
    v.pos          = worldPos;
    v.norm         = norm;
    v.packedColor  = packed;
    // Keep the vertex identity in full-volume coordinates.  The coordinate
    // map is regional, but all diagnostics, TSDF samples and face keys are
    // deliberately global so a chunk can never drift into its own origin.
    v.voxelFlatIdx = (uint)Flatten(coord);

    _Vertices[compactIdx]     = v;
    _CoordVertMap[flatIdx]    = (int)compactIdx;
}

// ══════════════════════════════════════════════════════════════════
//  Foundation constrained simplification
//  Native 5 cm Surface-Nets vertices already own the depth here. This pass
//  may only alias a complete, planar 2x2x2 group to one representative. It
//  never re-samples a 10 cm TSDF edge and never merges distinct depth layers.
// ══════════════════════════════════════════════════════════════════
[numthreads(4, 4, 4)]
void BuildFoundationClusters(uint3 id : SV_DispatchThreadID)
{
    if (_FoundationSimplifyEnabled == 0u || any(id >= _MapCount))
        return;

    int3 anchor = _MapMin + (int3)id;
    const int clusterStride = 2;
    int3 remainder = anchor - (anchor / clusterStride) * clusterStride;
    if (any(remainder != int3(0, 0, 0)))
        return;

    int3 clusterMax = anchor + int3(1, 1, 1);
    if (any(clusterMax >= (int3)_VoxCount) ||
        !InsideMap(anchor) || !InsideMap(clusterMax))
        return;

    float3 positionSum = float3(0.0, 0.0, 0.0);
    float3 normalSum = float3(0.0, 0.0, 0.0);
    int3 activeMin = int3(1, 1, 1);
    int3 activeMax = int3(0, 0, 0);
    uint activeCount = 0u;

    [unroll]
    for (uint i = 0u; i < 8u; i++)
    {
        int3 offset = int3((int)(i & 1u),
                           (int)((i >> 1u) & 1u),
                           (int)((i >> 2u) & 1u));
        int vertexIndex = _CoordVertMap[MapFlatten(anchor + offset)];
        if (vertexIndex < 0)
            continue;

        GPUVertex vertex = _Vertices[(uint)vertexIndex];
        float normalLengthSq = dot(vertex.norm, vertex.norm);
        if (normalLengthSq <= 0.25)
            return;

        positionSum += vertex.pos;
        normalSum += vertex.norm * rsqrt(normalLengthSq);
        activeMin = min(activeMin, offset);
        activeMax = max(activeMax, offset);
        activeCount++;
    }

    // Four witnesses spanning two tangential axes describe a surface patch.
    // Smaller/linear sets are usually a hole rim, thin feature or page fringe.
    if (activeCount < 4u)
        return;
    int3 activeSpan = activeMax - activeMin;
    uint varyingAxes = (activeSpan.x > 0 ? 1u : 0u) +
                       (activeSpan.y > 0 ? 1u : 0u) +
                       (activeSpan.z > 0 ? 1u : 0u);
    if (varyingAxes < 2u)
        return;

    float normalSumLength = length(normalSum);
    float normalCoherence = normalSumLength / (float)activeCount;
    if (normalCoherence < _FoundationSimplifyNormalDotMin || normalSumLength <= 1e-5)
        return;

    float3 averageNormal = normalSum / normalSumLength;
    float3 averagePosition = positionSum / (float)activeCount;
    float maxPlaneResidual = 0.0;
    float minNormalDot = 1.0;
    float bestDistanceSq = 1e30;
    int representativeIndex = -1;

    [unroll]
    for (uint j = 0u; j < 8u; j++)
    {
        int3 offset = int3((int)(j & 1u),
                           (int)((j >> 1u) & 1u),
                           (int)((j >> 2u) & 1u));
        int vertexIndex = _CoordVertMap[MapFlatten(anchor + offset)];
        if (vertexIndex < 0)
            continue;

        GPUVertex vertex = _Vertices[(uint)vertexIndex];
        float3 vertexNormal = normalize(vertex.norm);
        minNormalDot = min(minNormalDot, dot(vertexNormal, averageNormal));
        maxPlaneResidual = max(maxPlaneResidual,
            abs(dot(vertex.pos - averagePosition, averageNormal)));
        float3 centerDelta = vertex.pos - averagePosition;
        float centerDistanceSq = dot(centerDelta, centerDelta);
        if (centerDistanceSq < bestDistanceSq)
        {
            bestDistanceSq = centerDistanceSq;
            representativeIndex = vertexIndex;
        }
    }

    float residualLimit = _FoundationSimplifyPlaneResidualVoxels * _VoxSize;
    if (representativeIndex < 0 ||
        minNormalDot < _FoundationSimplifyNormalDotMin ||
        maxPlaneResidual > residualLimit)
        return;

    // Tangentially centre the representative while preserving the normal
    // depth of an existing fine vertex. This cannot drift to the midpoint of
    // two layers because the residual test above rejects such a cluster.
    GPUVertex representative = _Vertices[(uint)representativeIndex];
    float signedDepthDelta = dot(averagePosition - representative.pos, averageNormal);
    representative.pos = averagePosition - averageNormal * signedDepthDelta;
    representative.norm = averageNormal;
    _Vertices[(uint)representativeIndex] = representative;

    [unroll]
    for (uint k = 0u; k < 8u; k++)
    {
        int3 offset = int3((int)(k & 1u),
                           (int)((k >> 1u) & 1u),
                           (int)((k >> 2u) & 1u));
        int flatIndex = MapFlatten(anchor + offset);
        if (_CoordVertMap[flatIndex] >= 0)
            _CoordVertMap[flatIndex] = representativeIndex;
    }
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 2 : BuildVertexDispatchArgs
//  Writes indirect dispatch dimensions for per-vertex kernels
// ══════════════════════════════════════════════════════════════════
[numthreads(1, 1, 1)]
void BuildVertexDispatchArgs(uint3 id : SV_DispatchThreadID)
{
    uint vertCount = min(_Counters[0], _MaxVertices);
    _DispatchArgs[0] = (vertCount + 63) / 64;
    _DispatchArgs[1] = 1;
    _DispatchArgs[2] = 1;
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 3 : InitSmooth
//  Copies vertex positions into smooth ping buffer
// ══════════════════════════════════════════════════════════════════
[numthreads(64, 1, 1)]
void InitSmooth(uint3 id : SV_DispatchThreadID)
{
    uint vertCount = min(_Counters[0], _MaxVertices);
    if (id.x >= vertCount) return;
    _SmoothPosA[id.x] = _Vertices[id.x].pos;
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 4 : SmoothVertices
//  HC-Laplacian: reads _SmoothPosA, writes _SmoothPosB
//  C# swaps buffer bindings between iterations
// ══════════════════════════════════════════════════════════════════
[numthreads(64, 1, 1)]
void SmoothVertices(uint3 id : SV_DispatchThreadID)
{
    uint vertCount = min(_Counters[0], _MaxVertices);
    if (id.x >= vertCount) return;

    float3 pos  = _SmoothPosA[id.x];
    float3 norm = _Vertices[id.x].norm;
    int3   coord = Unflatten((int)_Vertices[id.x].voxelFlatIdx);

    float3 laplacian    = 0;
    float  totalWeight  = 0;

    [unroll]
    for (int axis = 0; axis < 3; axis++)
    {
        [unroll]
        for (int dir = -1; dir <= 1; dir += 2)
        {
            int3 nc = coord;
            nc[axis] += dir;
            if (!InsideMap(nc)) continue;

            int nbrVert = _CoordVertMap[MapFlatten(nc)];
            if (nbrVert < 0 || (uint)nbrVert >= vertCount) continue;

            float nw = max(0.0, dot(norm, _Vertices[nbrVert].norm));
            laplacian   += _SmoothPosA[nbrVert] * nw;
            totalWeight += nw;
        }
    }

    if (totalWeight < 0.001)
    {
        _SmoothPosB[id.x] = pos;
        return;
    }

    laplacian /= totalWeight;
    float3 q        = lerp(pos, laplacian, _SmoothLambda);
    float3 original = _Vertices[id.x].pos;
    _SmoothPosB[id.x] = q - _SmoothBeta * (q - original);
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 5 : ApplySmooth
//  Writes final smoothed positions from _SmoothPosA back to _Vertices
//  C# ensures the correct buffer is bound as _SmoothPosA after iterations
// ══════════════════════════════════════════════════════════════════
[numthreads(64, 1, 1)]
void ApplySmooth(uint3 id : SV_DispatchThreadID)
{
    uint vertCount = min(_Counters[0], _MaxVertices);
    if (id.x >= vertCount) return;

    GPUVertex v = _Vertices[id.x];
    v.pos = _SmoothPosA[id.x];
    _Vertices[id.x] = v;
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 6 : TemporalBlend
//  Adaptive temporal damping keyed by voxel 3D coordinate
//  _TemporalState is a RWTexture3D<float4>
// ══════════════════════════════════════════════════════════════════
[numthreads(64, 1, 1)]
void TemporalBlend(uint3 id : SV_DispatchThreadID)
{
    uint vertCount = min(_Counters[0], _MaxVertices);
    if (id.x >= vertCount) return;

    GPUVertex v = _Vertices[id.x];
    int3 coord  = Unflatten((int)v.voxelFlatIdx);

    int3 localCoord = coord - _MapMin;

    // Exact page-face vertices are shared identities: the negative page sees
    // them at CoreMax while the positive page sees them at CoreMin. Letting
    // each page blend that same global TSDF vertex through its private temporal
    // texture gives the two copies different ages and can pull them apart.
    // Publish the current global-TSDF extraction directly on shared faces;
    // interior vertices keep the existing temporal damping.
    bool sharedPageFace = any(coord == _CoreMin) || any(coord == _CoreMax);
    if (sharedPageFace)
    {
        _TemporalState[localCoord] = float4(v.pos, 0.0);
        return;
    }

    float4 prev    = _TemporalState[localCoord];
    float  prevAge = prev.w;

    if (prevAge < 0.0)
    {
        _TemporalState[localCoord] = float4(v.pos, 0.0);
        return;
    }

    float3 prevPos = prev.xyz;
    float  dist    = distance(v.pos, prevPos);

    if (dist < _TemporalDeadzone)
    {
        v.pos = prevPos;
        _Vertices[id.x]     = v;
        _TemporalState[localCoord] = float4(prevPos, prevAge + 1.0);
        return;
    }

    float age   = (dist > _ConvergeThreshold) ? 0.0 : prevAge + 1.0;
    float alpha = _TemporalAlphaMin
                + (_TemporalAlphaMax - _TemporalAlphaMin) * exp(-age * _TemporalDecayRate);

    v.pos = lerp(prevPos, v.pos, alpha);
    _Vertices[id.x]     = v;
    _TemporalState[localCoord] = float4(v.pos, age);
}

// ══════════════════════════════════════════════════════════════════
//  Read-only visual-quality prepass
//  Final vertex positions are fitted in 4^3 page-local bins.  The fit is only
//  a diagnostic reference plane; it never feeds smoothing or extraction.
// ══════════════════════════════════════════════════════════════════
uint VisualSpatialBin(int3 coord)
{
    int3 extent = max(_CoreMax - _CoreMin, int3(1, 1, 1));
    int3 rel = clamp(coord - _CoreMin, int3(0, 0, 0), extent - 1);
    int3 bin = min((rel * 4) / extent, int3(3, 3, 3));
    return (uint)(bin.x + 4 * bin.y + 16 * bin.z);
}

void VisualBinBounds(uint binIndex, out int3 voxelMin, out int3 voxelMax)
{
    int3 bin = int3((int)(binIndex & 3u),
                    (int)((binIndex >> 2u) & 3u),
                    (int)((binIndex >> 4u) & 3u));
    int3 extent = max(_CoreMax - _CoreMin, int3(1, 1, 1));
    voxelMin = _CoreMin + (extent * bin) / 4;
    voxelMax = _CoreMin + (extent * (bin + 1)) / 4;
}

void VisualAccumulatePlanePointAt(uint accumBase, uint binIndex, float3 posVox)
{
    int3 binMin;
    int3 binMax;
    VisualBinBounds(binIndex, binMin, binMax);
    float3 binCenter = 0.5 * ((float3)binMin + (float3)binMax);
    int3 q = (int3)round(clamp((posVox - binCenter) * 4.0, -127.0, 127.0));
    uint baseIndex = accumBase + binIndex * VISUAL_PLANE_ACCUM_STRIDE;
    InterlockedAdd(_Counters[baseIndex], 1u);
    InterlockedAdd(_Counters[baseIndex + 1u], (uint)q.x);
    InterlockedAdd(_Counters[baseIndex + 2u], (uint)q.y);
    InterlockedAdd(_Counters[baseIndex + 3u], (uint)q.z);
    InterlockedAdd(_Counters[baseIndex + 4u], (uint)(q.x * q.x));
    InterlockedAdd(_Counters[baseIndex + 5u], (uint)(q.x * q.y));
    InterlockedAdd(_Counters[baseIndex + 6u], (uint)(q.x * q.z));
    InterlockedAdd(_Counters[baseIndex + 7u], (uint)(q.y * q.y));
    InterlockedAdd(_Counters[baseIndex + 8u], (uint)(q.y * q.z));
    InterlockedAdd(_Counters[baseIndex + 9u], (uint)(q.z * q.z));
}

void VisualAccumulatePlaneVertex(uint binIndex, float3 posVox)
{
    VisualAccumulatePlanePointAt(VISUAL_PLANE_ACCUM_BASE, binIndex, posVox);
}

uint VisualPackBoundaryVertex(float3 posVox, int3 coord)
{
    // The normal Surface Nets offset lies inside [0,1]^3.  Leave one voxel of
    // headroom on either side for smoothing/temporal motion and quantize at
    // 1/256 voxel (about 0.2 mm at the default 5 cm voxel).
    uint3 q = (uint3)round(clamp((posVox - (float3)coord + 1.0) * 256.0, 0.0, 1023.0));
    return 0x80000000u | q.x | (q.y << 10u) | (q.z << 20u);
}

void VisualWriteBoundaryVertex(uint face, uint u, uint v, uint packed)
{
    if (u >= VISUAL_BOUNDARY_FACE_RESOLUTION || v >= VISUAL_BOUNDARY_FACE_RESOLUTION)
        return;
    uint address = VISUAL_BOUNDARY_BASE +
        face * VISUAL_BOUNDARY_FACE_CELLS + u + VISUAL_BOUNDARY_FACE_RESOLUTION * v;
    _Counters[address] = packed;
}

[numthreads(64, 1, 1)]
void AccumulateVisualQualityVertices(uint3 id : SV_DispatchThreadID)
{
    if (_VisualQualityEnabled == 0u) return;
    uint vertCount = min(_Counters[0], _MaxVertices);
    if (id.x >= vertCount) return;

    GPUVertex vertex = _Vertices[id.x];
    int3 coord = Unflatten((int)vertex.voxelFlatIdx);
    float3 posVox = vertex.pos / max(_VoxSize, 1e-6) + (float3)_VoxCount * 0.5;

    if (all(coord >= _CoreMin) && all(coord < _CoreMax))
        VisualAccumulatePlaneVertex(VisualSpatialBin(coord), posVox);

    uint packed = VisualPackBoundaryVertex(posVox, coord);
    int3 rel = coord - _CoreMin;
    int3 extent = _CoreMax - _CoreMin;
    // One fixed 65x65 backing store covers every production management page up
    // to 64^3.  Smaller pages use the same stride and leave the tail empty, so
    // the CPU can compare exact face coordinates without resampling/collapsing.
    if (all(extent <= 64))
    {
        if (coord.x == _CoreMin.x)
            VisualWriteBoundaryVertex(0u, (uint)rel.y, (uint)rel.z, packed);
        if (coord.x == _CoreMax.x)
            VisualWriteBoundaryVertex(1u, (uint)rel.y, (uint)rel.z, packed);
        if (coord.y == _CoreMin.y)
            VisualWriteBoundaryVertex(2u, (uint)rel.x, (uint)rel.z, packed);
        if (coord.y == _CoreMax.y)
            VisualWriteBoundaryVertex(3u, (uint)rel.x, (uint)rel.z, packed);
        if (coord.z == _CoreMin.z)
            VisualWriteBoundaryVertex(4u, (uint)rel.x, (uint)rel.y, packed);
        if (coord.z == _CoreMax.z)
            VisualWriteBoundaryVertex(5u, (uint)rel.x, (uint)rel.y, packed);
    }
}

bool VisualPlaneEigen(float xx, float xy, float xz, float yy, float yz, float zz,
                      out float3 normal, out float lambdaMin, out float lambdaSecond)
{
    normal = float3(0, 1, 0);
    lambdaMin = 0.0;
    lambdaSecond = 0.0;
    float a[9];
    a[0] = xx; a[1] = xy; a[2] = xz;
    a[3] = xy; a[4] = yy; a[5] = yz;
    a[6] = xz; a[7] = yz; a[8] = zz;
    float basis[9];
    basis[0] = 1; basis[1] = 0; basis[2] = 0;
    basis[3] = 0; basis[4] = 1; basis[5] = 0;
    basis[6] = 0; basis[7] = 0; basis[8] = 1;

    [loop]
    for (int iter = 0; iter < 16; iter++)
    {
        int p = 0;
        int q = 1;
        float maxOff = abs(a[1]);
        if (abs(a[2]) > maxOff) { maxOff = abs(a[2]); p = 0; q = 2; }
        if (abs(a[5]) > maxOff) { maxOff = abs(a[5]); p = 1; q = 2; }
        if (maxOff < 1e-7) break;
        float app = a[p * 3 + p];
        float aqq = a[q * 3 + q];
        float apq = a[p * 3 + q];
        float phi = 0.5 * atan2(2.0 * apq, aqq - app);
        float c = cos(phi);
        float s = sin(phi);
        [loop]
        for (int k = 0; k < 3; k++)
        {
            float akp = a[k * 3 + p];
            float akq = a[k * 3 + q];
            a[k * 3 + p] = c * akp - s * akq;
            a[k * 3 + q] = s * akp + c * akq;
        }
        [loop]
        for (int k = 0; k < 3; k++)
        {
            float apk = a[p * 3 + k];
            float aqk = a[q * 3 + k];
            a[p * 3 + k] = c * apk - s * aqk;
            a[q * 3 + k] = s * apk + c * aqk;
        }
        [loop]
        for (int k = 0; k < 3; k++)
        {
            float bkp = basis[k * 3 + p];
            float bkq = basis[k * 3 + q];
            basis[k * 3 + p] = c * bkp - s * bkq;
            basis[k * 3 + q] = s * bkp + c * bkq;
        }
    }

    int smallest = 0;
    if (a[4] < a[0]) smallest = 1;
    if (a[8] < a[smallest * 3 + smallest]) smallest = 2;
    int largest = 0;
    if (a[4] > a[0]) largest = 1;
    if (a[8] > a[largest * 3 + largest]) largest = 2;
    lambdaMin = max(a[smallest * 3 + smallest], 0.0);
    lambdaSecond = max(a[0] + a[4] + a[8] - lambdaMin -
        a[largest * 3 + largest], 0.0);
    normal = float3(basis[smallest], basis[3 + smallest], basis[6 + smallest]);
    if (any(isnan(normal)) || any(isinf(normal)) || dot(normal, normal) < 1e-8)
        return false;
    normal = normalize(normal);
    return true;
}

void FitVisualPlaneAt(uint binIndex, uint accumBase, uint modelBase)
{
    uint accum = accumBase + binIndex * VISUAL_PLANE_ACCUM_STRIDE;
    uint model = modelBase + binIndex * VISUAL_PLANE_MODEL_STRIDE;
    uint count = _Counters[accum];
    if (count < 8u) return;

    float invN = 1.0 / (float)count;
    float3 centerQ = float3((float)asint(_Counters[accum + 1u]),
                            (float)asint(_Counters[accum + 2u]),
                            (float)asint(_Counters[accum + 3u])) * invN;
    float xx = (float)_Counters[accum + 4u] * invN - centerQ.x * centerQ.x;
    float xy = (float)asint(_Counters[accum + 5u]) * invN - centerQ.x * centerQ.y;
    float xz = (float)asint(_Counters[accum + 6u]) * invN - centerQ.x * centerQ.z;
    float yy = (float)_Counters[accum + 7u] * invN - centerQ.y * centerQ.y;
    float yz = (float)asint(_Counters[accum + 8u]) * invN - centerQ.y * centerQ.z;
    float zz = (float)_Counters[accum + 9u] * invN - centerQ.z * centerQ.z;
    float3 normal;
    float lambdaMin;
    float lambdaSecond;
    if (!VisualPlaneEigen(xx, xy, xz, yy, yz, zz, normal, lambdaMin, lambdaSecond))
        return;
    float trace = max(xx + yy + zz, 1e-6);
    float thinRatio = lambdaMin / trace;
    float spanRatio = lambdaSecond / trace;
    // A plane may be visibly rough and must stay eligible for diagnosis.  The
    // loose thinness gate rejects volumetric/corner mixtures, while the second
    // eigenvalue rejects line-like fragments.
    bool planeCandidate = thinRatio <= 0.08 && spanRatio >= 0.02;
    _Counters[model] = planeCandidate ? 1u : 0u;
    _Counters[model + 1u] = (uint)(int)round(normal.x * 32767.0);
    _Counters[model + 2u] = (uint)(int)round(normal.y * 32767.0);
    _Counters[model + 3u] = (uint)(int)round(normal.z * 32767.0);
    _Counters[model + 4u] = (uint)round(sqrt(max(lambdaMin, 0.0)) * 256.0);
    _Counters[model + 5u] = (uint)round(saturate(thinRatio) * 1000000.0);
}

[numthreads(64, 1, 1)]
void FitVisualQualityPlanes(uint3 id : SV_DispatchThreadID)
{
    if (_VisualQualityEnabled == 0u) return;
    if (id.x >= VISUAL_BIN_COUNT) return;
    FitVisualPlaneAt(id.x, VISUAL_PLANE_ACCUM_BASE, VISUAL_PLANE_MODEL_BASE);
    if (_StageResponsibilityEnabled != 0u)
    {
        FitVisualPlaneAt(
            id.x,
            _StageResponsibilityBase + STAGE_CROSSING_PLANE_ACCUM_OFFSET,
            _StageResponsibilityBase + STAGE_CROSSING_PLANE_MODEL_OFFSET);
        FitVisualPlaneAt(
            id.x,
            _StageResponsibilityBase + STAGE_RAW_PLANE_ACCUM_OFFSET,
            _StageResponsibilityBase + STAGE_RAW_PLANE_MODEL_OFFSET);
    }
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 7 : GenerateIndices
//  Per vertex: check 3 axes for quad emission
// ══════════════════════════════════════════════════════════════════
static const uint kCandidateIndexMask = 0x3FFFFFFFu;

uint CandidateHash(uint key)
{
    key ^= key >> 16u;
    key *= 0x7feb352du;
    key ^= key >> 15u;
    key *= 0x846ca68bu;
    key ^= key >> 16u;
    return key & _CandidateHistoryMask;
}

bool CandidateFindSlot(uint key, bool allowCreate, out uint slot, out uint state)
{
    uint start = CandidateHash(key);
    [unroll]
    for (uint probe = 0u; probe < 16u; probe++)
    {
        slot = (start + probe) & _CandidateHistoryMask;
        uint observedKey = _CandidateHistoryKeys[slot];
        if (observedKey == key)
        {
            state = _CandidateHistoryStates[slot];
            return true;
        }

        if (observedKey == 0u)
        {
            if (!allowCreate)
                break;

            uint priorKey;
            InterlockedCompareExchange(_CandidateHistoryKeys[slot], 0u, key, priorKey);
            if (priorKey == 0u || priorKey == key)
            {
                state = _CandidateHistoryStates[slot];
                return true;
            }
        }
    }

    slot = 0u;
    state = 0u;
    if (allowCreate)
        InterlockedAdd(_Counters[137], 1u);
    return false;
}

uint CandidateTriangleClass(uint stableKey, uint p0, uint p1, uint p2)
{
    uint e0 = (p0 >> 18u) & 3u;
    uint e1 = (p1 >> 18u) & 3u;
    uint e2 = (p2 >> 18u) & 3u;
    uint supportCount = (e0 == 0u ? 1u : 0u) +
                        (e1 == 0u ? 1u : 0u) +
                        (e2 == 0u ? 1u : 0u);
    bool contradicted = e0 == 2u || e1 == 2u || e2 == 2u;
    bool updateEnabled = _CandidateHistoryUpdateEnabled != 0u;

    uint slot;
    uint packedState;
    bool found = CandidateFindSlot(stableKey, updateEnabled, slot, packedState);
    uint previousMode = packedState & 15u;
    uint previousEpoch = packedState >> 4u;
    bool consecutive = found && previousEpoch != 0u && previousEpoch + 1u == _CandidateExtractionEpoch;
    // Class 1 means that this extraction has no current observation for the
    // vertex (typically because the mature surface is outside the current
    // stereo frustum).  It is absence of evidence, not negative evidence.
    // Class 3 remains insufficient/ambiguous evidence and may not preserve a
    // triangle.  This distinction lets a verified surface survive a head turn
    // without admitting any new geometry through the history-only path.
    bool supportOrHistoryOnly = (e0 <= 1u) && (e1 <= 1u) && (e2 <= 1u);
    bool matureHistoryHold = previousMode == 2u && !contradicted && supportOrHistoryOnly;

    uint candidateClass = 0u;
    uint nextMode = 0u;

    if (!updateEnabled)
    {
        // Save/export extraction is read-only.  It may show only a triangle
        // that was already mature and is either supported now or simply not
        // observed by the current stereo view.
        candidateClass = matureHistoryHold
            ? 2u
            : 0u;

        if (candidateClass == 2u)
            InterlockedAdd(_Counters[133], 1u);
        else if (!contradicted && supportCount == 3u && previousMode == 1u)
            InterlockedAdd(_Counters[132], 1u);
        else
            InterlockedAdd(_Counters[136], 1u);
    }
    else if (matureHistoryHold && supportCount != 3u)
    {
        // A triangle that already passed the two-extraction, three-point gate
        // remains mature while it is merely outside the current observation.
        // Re-observation with class 2 (free-space contradiction) or class 3
        // (edge/multi-hop ambiguity) still retires it below.
        nextMode = 2u;
        candidateClass = 2u;
        InterlockedAdd(_Counters[133], 1u);
    }
    else if (contradicted || supportCount != 3u)
    {
        // The history-only exception was handled above.  Current edge/multi-hop
        // ambiguity or a free-space contradiction still retires the triangle.
        nextMode = 0u;
        candidateClass = 0u;
        InterlockedAdd(_Counters[136], 1u);
    }
    else if (supportCount == 3u)
    {
        if (consecutive && previousMode == 1u)
        {
            nextMode = 2u;
            candidateClass = 2u;
            InterlockedAdd(_Counters[133], 1u);
        }
        else if (consecutive && previousMode == 2u)
        {
            nextMode = 2u;
            candidateClass = 2u;
            InterlockedAdd(_Counters[133], 1u);
        }
        else
        {
            nextMode = 1u;
            candidateClass = 0u;
            InterlockedAdd(_Counters[132], 1u);
        }
    }
    if (updateEnabled && found)
        _CandidateHistoryStates[slot] = (_CandidateExtractionEpoch << 4u) | nextMode;

    return candidateClass;
}

uint EncodeCandidateIndex(uint vertexIndex, uint candidateClass)
{
    return (vertexIndex & kCandidateIndexMask) | ((candidateClass & 3u) << 30u);
}

// A whole extraction chunk is deliberately fairly large.  Counting only its
// total triangles lets geometry newly observed at one side hide geometry that
// vanished at the other side.  Keep a coarse spatial ledger so the persistent
// front buffer can distinguish growth from a local replacement.
uint MatureSpatialBin(int3 coord)
{
    int3 extent = max(_CoreMax - _CoreMin, int3(1, 1, 1));
    int3 rel = clamp(coord - _CoreMin, int3(0, 0, 0), extent - 1);
    int3 bin = min((rel * 4) / extent, int3(3, 3, 3));
    return (uint)(bin.x + 4 * bin.y + 16 * bin.z);
}

// Join the complete emitted triangle population to current geometric evidence,
// red/green confirmation state, immutable admission source and the lifecycle
// risks carried from TSDF integration.  Unlike counters 116..119 this covers
// every emitted triangle, including fully-known self/direct/relay geometry.
uint EmittedTriangleEvidence(uint p0, uint p1, uint p2)
{
    uint e0 = (p0 >> 18u) & 3u;
    uint e1 = (p1 >> 18u) & 3u;
    uint e2 = (p2 >> 18u) & 3u;
    bool anySupport = e0 == 0u || e1 == 0u || e2 == 0u;
    bool allSupport = e0 == 0u && e1 == 0u && e2 == 0u;
    bool anyContradiction = e0 == 2u || e1 == 2u || e2 == 2u;
    bool anyInsufficient = e0 == 3u || e1 == 3u || e2 == 3u;

    if (allSupport) return 0u;
    // A triangle straddling supported and contradicted samples is an edge or
    // mixed-observation case, not a clean free-space conviction.
    if (anySupport && anyContradiction) return 3u;
    if (anyContradiction) return 2u;
    if (anyInsufficient) return 3u;
    return 1u;
}

void AuditEmittedTriangle(
    uint p0, uint p1, uint p2,
    uint pathClass, uint confirmationClass, uint spatialBin)
{
    uint evidence = EmittedTriangleEvidence(p0, p1, p2);
    pathClass = min(pathClass, 4u);
    confirmationClass = min(confirmationClass, 3u);
    uint riskMask = ((p0 >> 22u) | (p1 >> 22u) | (p2 >> 22u)) & 31u;

    InterlockedAdd(_Counters[330u + evidence], 1u);
    InterlockedAdd(_Counters[334u + confirmationClass * 4u + evidence], 1u);
    InterlockedAdd(_Counters[350u + pathClass * 4u + evidence], 1u);
    [unroll]
    for (uint risk = 0u; risk < 5u; risk++)
    {
        if ((riskMask & (1u << risk)) != 0u)
        {
            InterlockedAdd(_Counters[370u + risk * 4u + evidence], 1u);
            InterlockedAdd(_Counters[390u + risk], 1u);
        }
    }
    InterlockedAdd(_Counters[395u], 1u);
    InterlockedAdd(
        _Counters[396u + spatialBin * 16u + confirmationClass * 4u + evidence],
        1u);
}

// A second, finer read-only fingerprint divides each coarse 4^3 ledger bin
// into another 4^3 occupancy grid.  The resulting 16^3 cell identity lets the
// CPU distinguish same-position survival from an equal-sized surface that
// disappeared here and reappeared elsewhere.  It does not change topology.
void MatureSpatialOccupancy(int3 coord, out uint spatialBin, out uint word, out uint bitMask)
{
    int3 extent = max(_CoreMax - _CoreMin, int3(1, 1, 1));
    int3 rel = clamp(coord - _CoreMin, int3(0, 0, 0), extent - 1);
    int3 fine = min((rel * 16) / extent, int3(15, 15, 15));
    int3 coarse = fine / 4;
    int3 local = fine - coarse * 4;
    spatialBin = (uint)(coarse.x + 4 * coarse.y + 16 * coarse.z);
    uint bit = (uint)(local.x + 4 * local.y + 16 * local.z);
    word = bit >> 5u;
    bitMask = 1u << (bit & 31u);
}

void AuditVisualTriangle(uint index0, uint index1, uint index2, int3 ownerCoord, uint spatialBin)
{
    if (_VisualQualityEnabled == 0u) return;
    GPUVertex v0 = _Vertices[index0];
    GPUVertex v1 = _Vertices[index1];
    GPUVertex v2 = _Vertices[index2];
    float invVoxel = 1.0 / max(_VoxSize, 1e-6);
    float3 p0 = v0.pos * invVoxel;
    float3 p1 = v1.pos * invVoxel;
    float3 p2 = v2.pos * invVoxel;
    float3 edge01 = p1 - p0;
    float3 edge02 = p2 - p0;
    float3 edge12 = p2 - p1;
    float edge01Sq = dot(edge01, edge01);
    float edge02Sq = dot(edge02, edge02);
    float edge12Sq = dot(edge12, edge12);
    float maxEdgeSq = max(edge01Sq, max(edge02Sq, edge12Sq));
    float3 faceCross = cross(edge01, edge02);
    float area2 = length(faceCross);
    bool degenerate = area2 < 0.02;
    bool elongated = maxEdgeSq > 9.0 || maxEdgeSq / max(area2, 1e-5) > 12.0;
    float3 faceNormal = degenerate ? float3(0, 1, 0) : faceCross / area2;

    float l0 = dot(v0.norm, v0.norm);
    float l1 = dot(v1.norm, v1.norm);
    float l2 = dot(v2.norm, v2.norm);
    bool normalsValid = l0 > 0.25 && l1 > 0.25 && l2 > 0.25;
    float3 n0 = normalsValid ? normalize(v0.norm) : float3(0, 1, 0);
    float3 n1 = normalsValid ? normalize(v1.norm) : float3(0, 1, 0);
    float3 n2 = normalsValid ? normalize(v2.norm) : float3(0, 1, 0);
    float minNormalDot = normalsValid
        ? min(dot(n0, n1), min(dot(n0, n2), dot(n1, n2)))
        : -1.0;
    float3 normalSum = n0 + n1 + n2;
    bool averageNormalValid = normalsValid && dot(normalSum, normalSum) > 1e-6;
    float3 averageNormal = averageNormalValid ? normalize(normalSum) : float3(0, 1, 0);
    float orientationDot = (!degenerate && averageNormalValid)
        ? dot(faceNormal, averageNormal)
        : 1.0;
    bool orientationOpposed = orientationDot < -0.2;
    bool vertexNormalDispersion = !normalsValid || minNormalDot < 0.94;
    bool edgeOrCorner = normalsValid && minNormalDot <= 0.82;

    int3 boundaryDistanceMin = ownerCoord - _CoreMin;
    int3 boundaryDistanceMax = (_CoreMax - 1) - ownerCoord;
    bool boundaryNear = any(boundaryDistanceMin <= 1) || any(boundaryDistanceMax <= 1);

    uint model = VISUAL_PLANE_MODEL_BASE + spatialBin * VISUAL_PLANE_MODEL_STRIDE;
    bool planeCandidate = _Counters[model] != 0u;
    float signedResidual = 0.0;
    float planeFaceDot = 1.0;
    bool normalDeviation = false;
    if (planeCandidate)
    {
        float3 planeNormal = float3((float)asint(_Counters[model + 1u]),
                                    (float)asint(_Counters[model + 2u]),
                                    (float)asint(_Counters[model + 3u])) / 32767.0;
        planeNormal = normalize(planeNormal);
        if (averageNormalValid && dot(planeNormal, averageNormal) < 0.0)
            planeNormal = -planeNormal;
        int3 binMin;
        int3 binMax;
        VisualBinBounds(spatialBin, binMin, binMax);
        float3 binCenter = 0.5 * ((float3)binMin + (float3)binMax) - (float3)_VoxCount * 0.5;
        uint accum = VISUAL_PLANE_ACCUM_BASE + spatialBin * VISUAL_PLANE_ACCUM_STRIDE;
        float count = max((float)_Counters[accum], 1.0);
        float3 meanQ = float3((float)asint(_Counters[accum + 1u]),
                              (float)asint(_Counters[accum + 2u]),
                              (float)asint(_Counters[accum + 3u])) / count;
        float3 planePoint = binCenter + meanQ * 0.25;
        float3 triangleCenter = (p0 + p1 + p2) / 3.0;
        signedResidual = dot(triangleCenter - planePoint, planeNormal);
        planeFaceDot = degenerate ? 0.0 : abs(dot(faceNormal, planeNormal));
        normalDeviation = planeFaceDot < 0.9659258; // >15 degrees

        float absResidual = abs(signedResidual);
        uint residualBin = absResidual < 0.05 ? 0u :
                           (absResidual < 0.10 ? 1u :
                           (absResidual < 0.20 ? 2u :
                           (absResidual < 0.40 ? 3u :
                           (absResidual < 0.80 ? 4u : 5u))));
        InterlockedAdd(_Counters[VISUAL_RESIDUAL_HIST_BASE + residualBin], 1u);
        uint normalBin = planeFaceDot >= 0.9986295 ? 0u :
                         (planeFaceDot >= 0.9925462 ? 1u :
                         (planeFaceDot >= 0.9659258 ? 2u :
                         (planeFaceDot >= 0.8660254 ? 3u : 4u)));
        InterlockedAdd(_Counters[VISUAL_NORMAL_HIST_BASE + normalBin], 1u);
    }

    bool flags[11];
    flags[0] = planeCandidate && abs(signedResidual) >= 0.10;
    flags[1] = planeCandidate && abs(signedResidual) >= 0.20;
    flags[2] = planeCandidate && signedResidual >= 0.20;
    flags[3] = planeCandidate && signedResidual <= -0.20;
    flags[4] = planeCandidate && normalDeviation;
    flags[5] = vertexNormalDispersion;
    flags[6] = orientationOpposed;
    flags[7] = degenerate;
    flags[8] = elongated;
    flags[9] = boundaryNear;
    flags[10] = !planeCandidate;

    uint primaryClass;
    if (degenerate || elongated) primaryClass = 3u;             // spike/degenerate
    else if (orientationOpposed) primaryClass = 5u;             // winding/normal opposed
    else if (edgeOrCorner) primaryClass = 4u;                   // legitimate edge candidate
    else if (!planeCandidate) primaryClass = boundaryNear ? 6u : 7u;
    else if (normalDeviation || vertexNormalDispersion) primaryClass = 2u;
    else if (abs(signedResidual) >= 0.20) primaryClass = 1u;
    else primaryClass = 0u;

    InterlockedAdd(_Counters[VISUAL_PRIMARY_BASE + primaryClass], 1u);
    InterlockedAdd(_Counters[VISUAL_SPATIAL_PRIMARY_BASE +
        spatialBin * VISUAL_PRIMARY_COUNT + primaryClass], 1u);
    [unroll]
    for (uint flag = 0u; flag < VISUAL_FLAG_COUNT; flag++)
    {
        if (!flags[flag]) continue;
        InterlockedAdd(_Counters[VISUAL_FLAGS_BASE + flag], 1u);
        InterlockedAdd(_Counters[VISUAL_SPATIAL_FLAGS_BASE +
            spatialBin * VISUAL_FLAG_COUNT + flag], 1u);
    }
    InterlockedAdd(_Counters[VISUAL_TOTAL_INDEX], 1u);
}

void TryEmitQuad(int3 coord, int3 axis, int3 d1, int3 d2, uint axisSlot)
{
    // Halo cells are read-only witnesses. Every global cell has exactly one
    // core owner, and only that owner may publish its quad.
    if (_GlobalCellOwnershipEnabled != 0u && !OwnsGlobalCell(coord))
        return;

    int topologyStride = _FoundationTopologyMode != 0u
        ? max((int)_FoundationCellStride, 1)
        : 1;
    int3 topologyAxis = axis * topologyStride;
    int3 topologyD1 = d1 * topologyStride;
    int3 topologyD2 = d2 * topologyStride;

    if (any(coord - topologyD1 < 0)) return;
    if (any(coord - topologyD2 < 0)) return;
    if (any(coord + topologyAxis >= (int3)_VoxCount)) return;

    float va;
    float vb;
    bool strictTopologyEdge = _StrictObservedEdges > 0.5 ||
                              (_FoundationTopologyMode != 0u && topologyStride > 1);
    if (strictTopologyEdge)
    {
        bool observedA = TrySampleObservedSDF(coord, va);
        bool observedB = TrySampleObservedSDF(coord + topologyAxis, vb);
        if (!observedA || !observedB)
        {
            InterlockedAdd(_Counters[4], 1);
            return;
        }

        // Match the vertex classifier: a visible 10 cm edge is backed by all
        // three native 5 cm samples and exactly one fine zero crossing. Missing
        // support is a hole; two crossings are multiple layers, not one edge.
        if (_FoundationTopologyMode != 0u && topologyStride == 2)
        {
            float vm;
            bool observedMid = TrySampleObservedSDF(coord + axis, vm);
            if (!observedMid)
            {
                InterlockedAdd(_Counters[4], 1);
                return;
            }

            bool crossesFirst = (va < 0.0) != (vm < 0.0);
            bool crossesSecond = (vm < 0.0) != (vb < 0.0);
            if (crossesFirst == crossesSecond)
                return;
        }
    }
    else
    {
        va = SampleSDF(coord);
        vb = SampleSDF(coord + topologyAxis);
    }
    if ((va < 0) == (vb < 0)) return;

    // A chunk may inspect the halo but must never dereference a neighbour
    // outside its regional coordinate map.
    int3 cb = coord - topologyD1;
    int3 cc = coord - (topologyD1 + topologyD2);
    int3 cd = coord - topologyD2;
    if (!InsideMap(coord) || !InsideMap(cb) || !InsideMap(cc) || !InsideMap(cd))
        return;

    int a = _CoordVertMap[MapFlatten(coord)];
    int b = _CoordVertMap[MapFlatten(cb)];
    int c = _CoordVertMap[MapFlatten(cc)];
    int d = _CoordVertMap[MapFlatten(cd)];
    if (a < 0 || b < 0 || c < 0 || d < 0 ||
        a >= (int)_MaxVertices || b >= (int)_MaxVertices ||
        c >= (int)_MaxVertices || d >= (int)_MaxVertices)
        return;

    if (_LayerSeparationEnabled != 0u)
    {
        float3 normalA = normalize(_Vertices[(uint)a].norm);
        float3 normalB = normalize(_Vertices[(uint)b].norm);
        float3 normalC = normalize(_Vertices[(uint)c].norm);
        float3 normalD = normalize(_Vertices[(uint)d].norm);
        float alignmentB = abs(dot(normalA, normalB));
        float alignmentC = abs(dot(normalA, normalC));
        float alignmentD = abs(dot(normalA, normalD));

        // Only judge sheet continuity when all four representatives describe
        // one nearly planar family. Corners and real curvature keep the
        // ordinary Surface-Nets connection rule.
        if (alignmentB >= _LayerSeparationNormalDotMin &&
            alignmentC >= _LayerSeparationNormalDotMin &&
            alignmentD >= _LayerSeparationNormalDotMin)
        {
            normalB = dot(normalA, normalB) < 0.0 ? -normalB : normalB;
            normalC = dot(normalA, normalC) < 0.0 ? -normalC : normalC;
            normalD = dot(normalA, normalD) < 0.0 ? -normalD : normalD;
            float3 sharedNormal = normalize(normalA + normalB + normalC + normalD);
            float offsetA = dot(_Vertices[(uint)a].pos, sharedNormal);
            float offsetB = dot(_Vertices[(uint)b].pos, sharedNormal);
            float offsetC = dot(_Vertices[(uint)c].pos, sharedNormal);
            float offsetD = dot(_Vertices[(uint)d].pos, sharedNormal);
            float minOffset = min(min(offsetA, offsetB), min(offsetC, offsetD));
            float maxOffset = max(max(offsetA, offsetB), max(offsetC, offsetD));
            float layerDistanceMeters =
                _LayerSeparationDistanceVoxels * _VoxSize;
            if (maxOffset - minOffset > layerDistanceMeters)
                return;

            // The sign-changing TSDF edge owns this quad. It must cross the
            // same plane selected by the four representatives; otherwise the
            // edge belongs to the discarded parallel sheet and would recreate
            // the very bridge the per-cell resolver removed.
            float edgeT = va / (va - vb);
            float3 edgeCrossingWorld = VoxelCoordToWorld(
                (float3)coord + edgeT * (float3)topologyAxis);
            float representativeOffset =
                0.25 * (offsetA + offsetB + offsetC + offsetD);
            if (abs(dot(edgeCrossingWorld, sharedNormal) -
                    representativeOffset) > layerDistanceMeters)
                return;
        }
    }

    uint pa = _VertexAdmissionClass[(uint)a];
    uint pb = _VertexAdmissionClass[(uint)b];
    uint pc = _VertexAdmissionClass[(uint)c];
    uint pd = _VertexAdmissionClass[(uint)d];

    uint pathA = pa & 7u;
    uint pathB = pb & 7u;
    uint pathC = pc & 7u;
    uint pathD = pd & 7u;
    uint pathQuadClass = (pathA == pathB && pathA == pathC && pathA == pathD)
        ? min(pathA, 4u)
        : 4u;

    uint confirmationA = (pa >> 3u) & 3u;
    uint confirmationB = (pb >> 3u) & 3u;
    uint confirmationC = (pc >> 3u) & 3u;
    uint confirmationD = (pd >> 3u) & 3u;
    uint confirmationQuadClass = (confirmationA == confirmationB &&
                                  confirmationA == confirmationC &&
                                  confirmationA == confirmationD)
        ? min(confirmationA, 3u)
        : 3u;

    // The foundation is a uniform 10 cm topology consumer whose depth remains
    // bracketed by native 5 cm TSDF samples. It does not inherit the old
    // per-triangle candidate archive or diagnostic colours.
    if (_FoundationTopologyMode != 0u)
    {
        float3 posA = _Vertices[(uint)a].pos;
        float3 posB = _Vertices[(uint)b].pos;
        float3 posC = _Vertices[(uint)c].pos;
        float3 posD = _Vertices[(uint)d].pos;
        float diagAC = dot(posA - posC, posA - posC);
        float diagBD = dot(posB - posD, posB - posD);
        // A planar coarse cell normally has two almost-equal diagonals. Always
        // choosing AC in that tie creates a directional comb across the whole
        // wall. Alternate only near-equal ties using global coarse-cell parity;
        // a materially shorter diagonal still wins to suppress needle faces.
        float diagonalTolerance = max(diagAC, diagBD) * 0.05;
        bool nearTie = abs(diagAC - diagBD) <= diagonalTolerance;
        uint coarseParity = (uint)(coord.x / topologyStride +
                                   coord.y / topologyStride +
                                   coord.z / topologyStride) + axisSlot;
        bool useAC = nearTie ? ((coarseParity & 1u) == 0u) : (diagAC < diagBD);
        const uint foundationClass = 2u;
        uint3 triangle0;
        uint3 triangle1;
        if (va < 0 && useAC)
        {
            triangle0 = uint3((uint)c, (uint)b, (uint)a);
            triangle1 = uint3((uint)d, (uint)c, (uint)a);
        }
        else if (va < 0)
        {
            triangle0 = uint3((uint)d, (uint)b, (uint)a);
            triangle1 = uint3((uint)d, (uint)c, (uint)b);
        }
        else if (useAC)
        {
            triangle0 = uint3((uint)a, (uint)c, (uint)d);
            triangle1 = uint3((uint)a, (uint)b, (uint)c);
        }
        else
        {
            triangle0 = uint3((uint)a, (uint)b, (uint)d);
            triangle1 = uint3((uint)b, (uint)c, (uint)d);
        }

        bool valid0 = triangle0.x != triangle0.y &&
                      triangle0.y != triangle0.z &&
                      triangle0.z != triangle0.x;
        bool valid1 = triangle1.x != triangle1.y &&
                      triangle1.y != triangle1.z &&
                      triangle1.z != triangle1.x;
        if (valid0)
        {
            float3 edge01 = _Vertices[triangle0.y].pos - _Vertices[triangle0.x].pos;
            float3 edge02 = _Vertices[triangle0.z].pos - _Vertices[triangle0.x].pos;
            float3 faceCross0 = cross(edge01, edge02);
            valid0 = dot(faceCross0, faceCross0) > 1e-10;
        }
        if (valid1)
        {
            float3 edge11 = _Vertices[triangle1.y].pos - _Vertices[triangle1.x].pos;
            float3 edge12 = _Vertices[triangle1.z].pos - _Vertices[triangle1.x].pos;
            float3 faceCross1 = cross(edge11, edge12);
            valid1 = dot(faceCross1, faceCross1) > 1e-10;
        }

        uint emittedIndexCount = (valid0 ? 3u : 0u) + (valid1 ? 3u : 0u);
        if (emittedIndexCount == 0u)
            return;
        uint baseIdx;
        InterlockedAdd(_Counters[1], emittedIndexCount, baseIdx);
        // The native production paper exits this branch before the legacy
        // admission/candidate ledgers below.  Audit the exact triangles it is
        // about to publish here, otherwise a healthy committed paper reports
        // triangles while every within-page visual-quality counter stays zero.
        // This is read-only accounting: no vertex, index or admission decision
        // is changed by AuditVisualTriangle.
        uint visualSpatialBin = MatureSpatialBin(coord);
        if (valid0)
            AuditVisualTriangle(triangle0.x, triangle0.y, triangle0.z,
                                coord, visualSpatialBin);
        if (valid1)
            AuditVisualTriangle(triangle1.x, triangle1.y, triangle1.z,
                                coord, visualSpatialBin);
        uint writeIndex = baseIdx;
        if (valid0)
        {
            _Indices[writeIndex    ] = EncodeCandidateIndex(triangle0.x, foundationClass);
            _Indices[writeIndex + 1] = EncodeCandidateIndex(triangle0.y, foundationClass);
            _Indices[writeIndex + 2] = EncodeCandidateIndex(triangle0.z, foundationClass);
            writeIndex += 3u;
        }
        if (valid1)
        {
            _Indices[writeIndex    ] = EncodeCandidateIndex(triangle1.x, foundationClass);
            _Indices[writeIndex + 1] = EncodeCandidateIndex(triangle1.y, foundationClass);
            _Indices[writeIndex + 2] = EncodeCandidateIndex(triangle1.z, foundationClass);
        }
        return;
    }

    // One quad produces two triangles. Both ledgers are audit-only and never
    // change topology, winding, vertex positions, or production admission.
    InterlockedAdd(_Counters[15u + (pathQuadClass == 0u ? 4u : pathQuadClass - 1u)], 2u);
    InterlockedAdd(_Counters[20u + (confirmationQuadClass == 0u ? 3u : confirmationQuadClass - 1u)], 2u);
    // 44..63 are emitted *triangles* in the same 5 x 4 joint ledger.
    // Count the two real output triangles separately.  A quad-wide class can
    // be mixed because of its fourth corner even when one emitted triangle is
    // homogeneous; using the actual three vertices keeps this ledger exactly
    // aligned with the diagnostic colour drawn for that triangle.
    uint pathTriABC = (pathA == pathB && pathA == pathC) ? min(pathA, 4u) : 4u;
    uint confirmTriABC = (confirmationA == confirmationB && confirmationA == confirmationC)
        ? min(confirmationA, 3u)
        : 3u;
    uint pathTriACD = (pathA == pathC && pathA == pathD) ? min(pathA, 4u) : 4u;
    uint confirmTriACD = (confirmationA == confirmationC && confirmationA == confirmationD)
        ? min(confirmationA, 3u)
        : 3u;
    InterlockedAdd(_Counters[44u + pathTriABC * 4u + confirmTriABC], 1u);
    InterlockedAdd(_Counters[44u + pathTriACD * 4u + confirmTriACD], 1u);

    // White in the joint view used to be one opaque bucket.  Split it without
    // changing admission or topology:
    //   64 boundary: the vertices are individually classified but disagree;
    //   65 pending: at least one vertex still awaits real confirmation;
    //   66 internal: at least one vertex is already internally mixed.
    // Counters 67..69 split counter 66 into three disjoint causes:
    //   67 admission source only, 68 real confirmation only, 69 both ledgers.
    // Counters 70..71 partition counter 69 by whether both mixed states occur
    // on the same vertex or only on different vertices.  Counters 72..74 then
    // partition counter 70 by the number (1/2/3) of double-mixed vertices.
    // Internal mixed wins over pending so the three buckets are disjoint.
    bool whiteABC = pathTriABC == 4u && confirmTriABC == 3u;
    if (whiteABC)
    {
        bool admissionInternalABC = pathA == 4u || pathB == 4u || pathC == 4u;
        bool confirmationInternalABC = confirmationA == 3u || confirmationB == 3u || confirmationC == 3u;
        bool internalABC = admissionInternalABC || confirmationInternalABC;
        bool pendingABC = confirmationA == 1u || confirmationB == 1u || confirmationC == 1u;
        uint bucketABC = internalABC ? 66u : (pendingABC ? 65u : 64u);
        InterlockedAdd(_Counters[bucketABC], 1u);
        if (internalABC)
        {
            uint internalBucketABC = admissionInternalABC
                ? (confirmationInternalABC ? 69u : 67u)
                : 68u;
            InterlockedAdd(_Counters[internalBucketABC], 1u);
            if (internalBucketABC == 69u)
            {
                uint doubleMixedCountABC =
                    ((pathA == 4u && confirmationA == 3u) ? 1u : 0u) +
                    ((pathB == 4u && confirmationB == 3u) ? 1u : 0u) +
                    ((pathC == 4u && confirmationC == 3u) ? 1u : 0u);
                if (doubleMixedCountABC == 0u)
                    InterlockedAdd(_Counters[71u], 1u);
                else
                {
                    InterlockedAdd(_Counters[70u], 1u);
                    InterlockedAdd(_Counters[71u + doubleMixedCountABC], 1u);
                }
            }
        }
    }

    bool whiteACD = pathTriACD == 4u && confirmTriACD == 3u;
    if (whiteACD)
    {
        bool admissionInternalACD = pathA == 4u || pathC == 4u || pathD == 4u;
        bool confirmationInternalACD = confirmationA == 3u || confirmationC == 3u || confirmationD == 3u;
        bool internalACD = admissionInternalACD || confirmationInternalACD;
        bool pendingACD = confirmationA == 1u || confirmationC == 1u || confirmationD == 1u;
        uint bucketACD = internalACD ? 66u : (pendingACD ? 65u : 64u);
        InterlockedAdd(_Counters[bucketACD], 1u);
        if (internalACD)
        {
            uint internalBucketACD = admissionInternalACD
                ? (confirmationInternalACD ? 69u : 67u)
                : 68u;
            InterlockedAdd(_Counters[internalBucketACD], 1u);
            if (internalBucketACD == 69u)
            {
                uint doubleMixedCountACD =
                    ((pathA == 4u && confirmationA == 3u) ? 1u : 0u) +
                    ((pathC == 4u && confirmationC == 3u) ? 1u : 0u) +
                    ((pathD == 4u && confirmationD == 3u) ? 1u : 0u);
                if (doubleMixedCountACD == 0u)
                    InterlockedAdd(_Counters[71u], 1u);
                else
                {
                    InterlockedAdd(_Counters[70u], 1u);
                    InterlockedAdd(_Counters[71u + doubleMixedCountACD], 1u);
                }
            }
        }
    }

    uint faceBaseKey = (uint)Flatten(coord) * 6u + axisSlot * 2u + 1u;
    uint candidateABC = CandidateTriangleClass(faceBaseKey, pa, pb, pc);
    uint candidateACD = CandidateTriangleClass(faceBaseKey + 1u, pa, pc, pd);

    // Only triangles that passed the mature three-point gate enter the spatial
    // persistence ledger. Pending/diagnostic geometry must not pin a region.
    uint spatialBin = MatureSpatialBin(coord);
    AuditEmittedTriangle(pa, pb, pc, pathTriABC, confirmTriABC, spatialBin);
    AuditEmittedTriangle(pa, pc, pd, pathTriACD, confirmTriACD, spatialBin);
    if (candidateABC == 2u)
        InterlockedAdd(_Counters[138u + spatialBin], 1u);
    if (candidateACD == 2u)
        InterlockedAdd(_Counters[138u + spatialBin], 1u);

    if (candidateABC == 2u || candidateACD == 2u)
    {
        uint occupancyBin;
        uint occupancyWord;
        uint occupancyMask;
        MatureSpatialOccupancy(coord, occupancyBin, occupancyWord, occupancyMask);
        InterlockedOr(_Counters[202u + occupancyBin * 2u + occupancyWord], occupancyMask);
    }

    uint baseIdx;
    InterlockedAdd(_Counters[1], 6, baseIdx);

    if (va < 0)
    {
        AuditVisualTriangle((uint)c, (uint)b, (uint)a, coord, spatialBin);
        AuditVisualTriangle((uint)d, (uint)c, (uint)a, coord, spatialBin);
        _Indices[baseIdx    ] = EncodeCandidateIndex((uint)c, candidateABC);
        _Indices[baseIdx + 1] = EncodeCandidateIndex((uint)b, candidateABC);
        _Indices[baseIdx + 2] = EncodeCandidateIndex((uint)a, candidateABC);
        _Indices[baseIdx + 3] = EncodeCandidateIndex((uint)d, candidateACD);
        _Indices[baseIdx + 4] = EncodeCandidateIndex((uint)c, candidateACD);
        _Indices[baseIdx + 5] = EncodeCandidateIndex((uint)a, candidateACD);
    }
    else
    {
        AuditVisualTriangle((uint)a, (uint)c, (uint)d, coord, spatialBin);
        AuditVisualTriangle((uint)a, (uint)b, (uint)c, coord, spatialBin);
        _Indices[baseIdx    ] = EncodeCandidateIndex((uint)a, candidateACD);
        _Indices[baseIdx + 1] = EncodeCandidateIndex((uint)c, candidateACD);
        _Indices[baseIdx + 2] = EncodeCandidateIndex((uint)d, candidateACD);
        _Indices[baseIdx + 3] = EncodeCandidateIndex((uint)a, candidateABC);
        _Indices[baseIdx + 4] = EncodeCandidateIndex((uint)b, candidateABC);
        _Indices[baseIdx + 5] = EncodeCandidateIndex((uint)c, candidateABC);
    }
}

[numthreads(64, 1, 1)]
void GenerateIndices(uint3 id : SV_DispatchThreadID)
{
    uint vertCount = min(_Counters[0], _MaxVertices);
    if (id.x >= vertCount) return;

    int3 coord = Unflatten((int)_Vertices[id.x].voxelFlatIdx);

    if (_GlobalCellOwnershipEnabled != 0u)
    {
        // A halo may reproduce the owner's representative for local
        // connectivity, but it must never publish topology.
        if (!OwnsGlobalCell(coord)) return;
    }
    else
    {
        // Preserve the legacy/fallback skirt contract outside the InfiniTAM
        // product route.
        int skirt = (int)min(_FoundationVisibleSkirtVoxels, 1u);
        int3 emitMin = max(_CoreMin - skirt, _MapMin);
        int3 emitMax = min(_CoreMax + skirt, _MapMin + (int3)_MapCount);
        if (any(coord < emitMin) || any(coord >= emitMax)) return;
    }

    TryEmitQuad(coord, int3(1,0,0), int3(0,0,1), int3(0,1,0), 0u);
    TryEmitQuad(coord, int3(0,1,0), int3(1,0,0), int3(0,0,1), 1u);
    TryEmitQuad(coord, int3(0,0,1), int3(0,1,0), int3(1,0,0), 2u);
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 8 : BuildIndirectArgs
//  Packs index count into DrawProceduralIndirect args
// ══════════════════════════════════════════════════════════════════
[numthreads(1, 1, 1)]
void BuildIndirectArgs(uint3 id : SV_DispatchThreadID)
{
    _DrawIndirectArgs[0] = _Counters[1]; // indexCount
    _DrawIndirectArgs[1] = 1;            // instanceCount
    _DrawIndirectArgs[2] = 0;            // startIndex
    _DrawIndirectArgs[3] = 0;            // baseVertex
    _DrawIndirectArgs[4] = 0;            // startInstance

    // Display-only derivative of the same authoritative index count.  The
    // source indices and all extraction/admission decisions remain untouched.
    _LineDrawIndirectArgs[0] = _Counters[1] * 2u;
    _LineDrawIndirectArgs[1] = 1;
    _LineDrawIndirectArgs[2] = 0;
    _LineDrawIndirectArgs[3] = 0;
    _LineDrawIndirectArgs[4] = 0;
}

// Copies only the committed payload into the immutable front-buffer.  The
// extraction buffers are capacity-sized working storage and must not be kept
// alive merely to render a much smaller accepted mesh.
[numthreads(64, 1, 1)]
void CopyMeshSnapshot(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _SnapshotVertexCount)
    {
        GPUVertex vertex = _Vertices[id.x];
        _SnapshotVertices[id.x] = vertex;
        uint snapshotClass = _VertexAdmissionClass[id.x] &
                             ~(kBoundaryCandidateBit | kBoundaryCanonicalBit);
        if (_SnapshotMarkBoundaryVertices != 0u)
        {
            int3 coord = Unflatten((int)vertex.voxelFlatIdx);
            bool haloDuplicate = any(coord < _CoreMin) || any(coord >= _CoreMax);
            if (haloDuplicate)
                snapshotClass |= kBoundaryCandidateBit;
        }
        _SnapshotAdmissionClass[id.x] = snapshotClass;
    }
    if (id.x < _SnapshotIndexCount)
        _SnapshotIndices[id.x] = _Indices[id.x];
}

[numthreads(64, 1, 1)]
void CopyCoordinateVertexMap(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _SnapshotCoordMapCount)
        _SnapshotCoordVertMap[id.x] = _CoordVertMap[id.x];
}

int BoundaryMapFlatten(int3 coord, int3 mapMin, uint3 mapCount)
{
    int3 local = coord - mapMin;
    return local.x + local.y * (int)mapCount.x +
           local.z * (int)mapCount.x * (int)mapCount.y;
}

// Copies the canonical owner's already-extracted representative into the
// publishing candidate's halo duplicate. Core vertices are never overwritten:
// each global cell still has exactly one positional authority.
[numthreads(64, 1, 1)]
void CanonicalizeBoundarySnapshot(uint3 id : SV_DispatchThreadID)
{
    uint copyCount = _BoundaryCopyCount.x * _BoundaryCopyCount.y *
                     _BoundaryCopyCount.z;
    if (id.x >= copyCount || copyCount == 0u)
        return;

    uint slice = _BoundaryCopyCount.x * _BoundaryCopyCount.y;
    uint z = id.x / slice;
    uint rem = id.x - z * slice;
    uint y = rem / _BoundaryCopyCount.x;
    uint x = rem - y * _BoundaryCopyCount.x;
    int3 coord = _BoundaryCopyMin + int3((int)x, (int)y, (int)z);

    int ownerMapIndex = BoundaryMapFlatten(coord,
        _BoundaryOwnerMapMin, _BoundaryOwnerMapCount);
    int targetMapIndex = BoundaryMapFlatten(coord,
        _BoundaryTargetMapMin, _BoundaryTargetMapCount);
    int ownerVertex = _BoundaryOwnerCoordVertMap[ownerMapIndex];
    int targetVertex = _BoundaryTargetCoordVertMap[targetMapIndex];
    if (ownerVertex < 0 || targetVertex < 0 ||
        (uint)ownerVertex >= _BoundaryOwnerVertexCount ||
        (uint)targetVertex >= _BoundaryTargetVertexCount)
        return;

    _BoundaryTargetVertices[targetVertex] =
        _BoundaryOwnerVertices[ownerVertex];
    uint ownerClass = _BoundaryOwnerAdmissionClass[ownerVertex] &
                      ~(kBoundaryCandidateBit | kBoundaryCanonicalBit);
    _BoundaryTargetAdmissionClass[targetVertex] = ownerClass |
        kBoundaryCandidateBit | kBoundaryCanonicalBit;
}

// Copies the immutable accepted mesh and the current candidate into disjoint
// vertex ranges.  Candidate vertices are harmless until an admitted triangle
// references them.
[numthreads(64, 1, 1)]
void CopyAdditiveMergePayload(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _PreviousVertexCount)
    {
        _MergeVertices[id.x] = _PreviousVertices[id.x];
        _MergeAdmissionClass[id.x] = _PreviousAdmissionClass[id.x];
    }
    if (id.x < _CandidateVertexCount)
    {
        uint dst = _PreviousVertexCount + id.x;
        _MergeVertices[dst] = _Vertices[id.x];
        _MergeAdmissionClass[dst] = _VertexAdmissionClass[id.x];
    }
    if (id.x < _PreviousIndexCount)
        _MergeIndices[id.x] = _PreviousIndices[id.x];
}

// Appends only three-point-mature candidate triangles in exact fine cells that
// the accepted snapshot did not already own.  It cannot delete, move, or
// overwrite an accepted triangle.
[numthreads(64, 1, 1)]
void AppendNovelMatureTriangles(uint3 id : SV_DispatchThreadID)
{
    uint triangleBase = id.x * 3u;
    if (triangleBase + 2u >= _CandidateIndexCount)
        return;

    uint encoded0 = _Indices[triangleBase];
    uint encoded1 = _Indices[triangleBase + 1u];
    uint encoded2 = _Indices[triangleBase + 2u];
    uint candidateClass = encoded0 >> 30u;
    if (candidateClass != 2u)
    {
        InterlockedAdd(_MergeCounters[4], 1u);
        return;
    }

    uint raw0 = encoded0 & kCandidateIndexMask;
    uint raw1 = encoded1 & kCandidateIndexMask;
    uint raw2 = encoded2 & kCandidateIndexMask;
    if (raw0 >= _CandidateVertexCount || raw1 >= _CandidateVertexCount ||
        raw2 >= _CandidateVertexCount)
        return;

    int3 owner = max(Unflatten((int)_Vertices[raw0].voxelFlatIdx),
                     max(Unflatten((int)_Vertices[raw1].voxelFlatIdx),
                         Unflatten((int)_Vertices[raw2].voxelFlatIdx)));
    uint spatialBin;
    uint occupancyWord;
    uint occupancyMask;
    MatureSpatialOccupancy(owner, spatialBin, occupancyWord, occupancyMask);
    uint occupancyIndex = spatialBin * 2u + occupancyWord;
    if ((_AcceptedSpatialOccupancy[occupancyIndex] & occupancyMask) != 0u)
    {
        InterlockedAdd(_MergeCounters[3], 1u);
        return;
    }

    uint dst;
    InterlockedAdd(_MergeCounters[1], 3u, dst);
    uint vertexOffset = _PreviousVertexCount;
    _MergeIndices[dst] = EncodeCandidateIndex(raw0 + vertexOffset, candidateClass);
    _MergeIndices[dst + 1u] = EncodeCandidateIndex(raw1 + vertexOffset, candidateClass);
    _MergeIndices[dst + 2u] = EncodeCandidateIndex(raw2 + vertexOffset, candidateClass);
    InterlockedAdd(_MergeCounters[2], 1u);
}

[numthreads(1, 1, 1)]
void BuildAdditiveMergeArgs(uint3 id : SV_DispatchThreadID)
{
    _MergeDrawIndirectArgs[0] = _MergeCounters[1];
    _MergeDrawIndirectArgs[1] = 1u;
    _MergeDrawIndirectArgs[2] = 0u;
    _MergeDrawIndirectArgs[3] = 0u;
    _MergeDrawIndirectArgs[4] = 0u;
}

// HERA phase 1: copy the page vertex payload once.  The filtered index stream
// can then be built without touching the authoritative TSDF or source page.
[numthreads(64, 1, 1)]
void CopyHeraVertexPayload(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _SnapshotVertexCount)
        return;
    _SnapshotVertices[id.x] = _Vertices[id.x];
    _SnapshotAdmissionClass[id.x] = _VertexAdmissionClass[id.x];
}

// HERA phase 2: preserve the complete parent triangle stream.  The historical
// A/B experiment proved that rejecting a whole 32^3 page because it contains a
// small mixed subset discards mostly valid geometry.  A triangle that is mixed
// in BOTH ledgers therefore requests 16^3 refinement in addition to retaining
// its resident parent representation.
[numthreads(64, 1, 1)]
void FilterHeraCleanTriangles(uint3 id : SV_DispatchThreadID)
{
    uint triangleBase = id.x * 3u;
    if (triangleBase + 2u >= _HeraSourceIndexCount)
        return;

    uint encoded0 = _Indices[triangleBase];
    uint encoded1 = _Indices[triangleBase + 1u];
    uint encoded2 = _Indices[triangleBase + 2u];
    // A live 32^3 page is a sheet of paper that may be written in spatial
    // installments.  Its first front-buffer contains only temporally mature
    // triangles; pending claims remain in the worker and may become a later
    // additive installment.  Frozen/final HERA pages deliberately keep the
    // complete historical stream.
    if (_HeraMatureOnly != 0u && (encoded0 >> 30u) != 2u)
        return;
    uint raw0 = encoded0 & kCandidateIndexMask;
    uint raw1 = encoded1 & kCandidateIndexMask;
    uint raw2 = encoded2 & kCandidateIndexMask;
    if (raw0 >= _SnapshotVertexCount || raw1 >= _SnapshotVertexCount || raw2 >= _SnapshotVertexCount)
        return;

    uint state0 = _VertexAdmissionClass[raw0];
    uint state1 = _VertexAdmissionClass[raw1];
    uint state2 = _VertexAdmissionClass[raw2];
    uint path0 = min(state0 & 7u, 4u);
    uint path1 = min(state1 & 7u, 4u);
    uint path2 = min(state2 & 7u, 4u);
    uint confirm0 = min((state0 >> 3u) & 3u, 3u);
    uint confirm1 = min((state1 >> 3u) & 3u, 3u);
    uint confirm2 = min((state2 >> 3u) & 3u, 3u);
    uint pathTri = (path0 == path1 && path0 == path2) ? path0 : 4u;
    uint confirmTri = (confirm0 == confirm1 && confirm0 == confirm2) ? confirm0 : 3u;
    bool requestFineTierReview = pathTri == 4u && confirmTri == 3u;
    // Display trust and 16-tier delegation are deliberately independent:
    // source mixing is diagnostic provenance, not proof of bad geometry.
    // A uniformly receiver-confirmed triangle is green even if its immutable
    // birth sources differ. Unknown, pending or mixed confirmation stays red.
    // Fine-tier review remains the narrower historic double-mixed request, so
    // this semantic correction does not broaden child16 authority.
    bool displayRed = confirmTri != 2u;
    if (requestFineTierReview)
        InterlockedAdd(_HeraFilterCounters[2], 1u);
    if (displayRed)
        InterlockedAdd(_HeraFilterCounters[21], 1u);
    InterlockedAdd(_HeraFilterCounters[22u + confirmTri], 1u);

    uint heraClass = displayRed ? 3u : 2u;
    uint dst;
    InterlockedAdd(_HeraFilterCounters[0], 3u, dst);
    _SnapshotIndices[dst] = raw0 | (heraClass << 30u);
    _SnapshotIndices[dst + 1u] = raw1 | (heraClass << 30u);
    _SnapshotIndices[dst + 2u] = raw2 | (heraClass << 30u);
    InterlockedAdd(_HeraFilterCounters[1], 1u);
}


// Read-only HERA rescue classification is isolated from the resident parent
// index router above.  A missing TSDF binding or a diagnostic shader failure
// must never zero the visible HERA draw stream on device.
[numthreads(64, 1, 1)]
void ClassifyHeraInternalMixed(uint3 id : SV_DispatchThreadID)
{
    uint triangleBase = id.x * 3u;
    if (triangleBase + 2u >= _HeraSourceIndexCount)
        return;

    uint encodedSource0 = _Indices[triangleBase];
    if (_HeraMatureOnly != 0u && (encodedSource0 >> 30u) != 2u)
        return;
    uint raw0 = encodedSource0 & kCandidateIndexMask;
    uint raw1 = _Indices[triangleBase + 1u] & kCandidateIndexMask;
    uint raw2 = _Indices[triangleBase + 2u] & kCandidateIndexMask;
    if (raw0 >= _SnapshotVertexCount || raw1 >= _SnapshotVertexCount || raw2 >= _SnapshotVertexCount)
        return;

    uint state0 = _VertexAdmissionClass[raw0];
    uint state1 = _VertexAdmissionClass[raw1];
    uint state2 = _VertexAdmissionClass[raw2];
    uint path0 = min(state0 & 7u, 4u);
    uint path1 = min(state1 & 7u, 4u);
    uint path2 = min(state2 & 7u, 4u);
    uint confirm0 = min((state0 >> 3u) & 3u, 3u);
    uint confirm1 = min((state1 >> 3u) & 3u, 3u);
    uint confirm2 = min((state2 >> 3u) & 3u, 3u);
    uint pathTri = (path0 == path1 && path0 == path2) ? path0 : 4u;
    uint confirmTri = (confirm0 == confirm1 && confirm0 == confirm2) ? confirm0 : 3u;
    bool delegateToFineTier = pathTri == 4u && confirmTri == 3u;
    bool hasInternalMixed = path0 == 4u || path1 == 4u || path2 == 4u ||
                            confirm0 == 3u || confirm1 == 3u || confirm2 == 3u;

    if (!hasInternalMixed)
    {
        if (delegateToFineTier)
            InterlockedAdd(_HeraFilterCounters[9], 1u);
        return;
    }

    float3 n0 = _Vertices[raw0].norm;
    float3 n1 = _Vertices[raw1].norm;
    float3 n2 = _Vertices[raw2].norm;
    float l0 = dot(n0, n0);
    float l1 = dot(n1, n1);
    float l2 = dot(n2, n2);
    bool normalsValid = l0 > 0.25 && l1 > 0.25 && l2 > 0.25;
    float minNormalDot = -1.0;
    if (normalsValid)
    {
        n0 *= rsqrt(l0);
        n1 *= rsqrt(l1);
        n2 *= rsqrt(l2);
        minNormalDot = min(dot(n0, n1), min(dot(n1, n2), dot(n2, n0)));
    }

    int3 c0 = Unflatten((int)_Vertices[raw0].voxelFlatIdx);
    int3 c1 = Unflatten((int)_Vertices[raw1].voxelFlatIdx);
    int3 c2 = Unflatten((int)_Vertices[raw2].voxelFlatIdx);
    float supportFloor = max(_MinWeight, 0.08);
    bool fullyObserved = _TsdfVolume[c0].g >= supportFloor &&
                         _TsdfVolume[c1].g >= supportFloor &&
                         _TsdfVolume[c2].g >= supportFloor;
    int3 safeMin = _CoreMin + int3(2, 2, 2);
    int3 safeMax = _CoreMax - int3(2, 2, 2);
    bool pageInterior = all(c0 >= safeMin) && all(c0 < safeMax) &&
                        all(c1 >= safeMin) && all(c1 < safeMax) &&
                        all(c2 >= safeMin) && all(c2 < safeMax);

    uint splitClass = normalsValid && minNormalDot <= 0.82
        ? 0u
        : normalsValid && minNormalDot >= 0.94 && fullyObserved && pageInterior
            ? 1u
            : 2u;
    InterlockedAdd(_HeraFilterCounters[10], 1u);
    InterlockedAdd(_HeraFilterCounters[3u + splitClass], 1u);
    if (delegateToFineTier)
        InterlockedAdd(_HeraFilterCounters[6u + splitClass], 1u);

    // A child16 rescue is a committed local addition, not a full-page
    // delegated replacement. Route class 2 keeps it green and visible.
    uint committedPatchBits = 2u << 30u;
    uint encoded0 = raw0 | committedPatchBits;
    uint encoded1 = raw1 | committedPatchBits;
    uint encoded2 = raw2 | committedPatchBits;

    // Counter 19 and this index stream are a strictly read-only replay of the
    // fine-tier triangles that look like false centre conflicts.  Unlike the
    // old count-only experiment, this preserves the exact triangle identity;
    // it cannot accidentally resurrect the rest of the 16^3 page.
    if (delegateToFineTier && splitClass == 1u)
    {
        uint shadowDst;
        InterlockedAdd(_HeraFilterCounters[19], 3u, shadowDst);
        _HeraInteriorShadowIndices[shadowDst] = encoded0;
        _HeraInteriorShadowIndices[shadowDst + 1u] = encoded1;
        _HeraInteriorShadowIndices[shadowDst + 2u] = encoded2;
    }

    // Exhaustive, mutually-exclusive split of the old "ambiguous" bucket.
    // These counters are diagnostic only. They deliberately do not alter the
    // HERA route or the immutable replay snapshot above.
    if (splitClass == 2u)
    {
        bool normalFailure = !normalsValid || (minNormalDot > 0.82 && minNormalDot < 0.94);
        bool weightFailure = !fullyObserved;
        bool boundaryFailure = !pageInterior;
        uint failureCount = (normalFailure ? 1u : 0u) +
                            (weightFailure ? 1u : 0u) +
                            (boundaryFailure ? 1u : 0u);
        uint reason = failureCount > 1u
            ? 3u // several independent gates failed
            : normalFailure
                ? 0u
                : weightFailure
                    ? 1u
                    : boundaryFailure
                        ? 2u
                        : 3u; // defensive residual: never silently disappears
        InterlockedAdd(_HeraFilterCounters[11u + reason], 1u);
        if (delegateToFineTier)
            InterlockedAdd(_HeraFilterCounters[15u + reason], 1u);

        // Exact page-boundary stream. GenerateIndices already enforces the
        // half-open core ownership rule, so this triangle has one canonical
        // emitting page even when its vertices consume neighbour halo data.
        // Copy the original indices verbatim: never re-triangulate a seam.
        if (delegateToFineTier && failureCount == 1u && boundaryFailure)
        {
            uint boundaryDst;
            InterlockedAdd(_HeraFilterCounters[20], 3u, boundaryDst);
            _HeraBoundaryShadowIndices[boundaryDst] = encoded0;
            _HeraBoundaryShadowIndices[boundaryDst + 1u] = encoded1;
            _HeraBoundaryShadowIndices[boundaryDst + 2u] = encoded2;
        }
    }
}

[numthreads(1, 1, 1)]
void BuildHeraFilteredArgs(uint3 id : SV_DispatchThreadID)
{
    _HeraDrawIndirectArgs[0] = _HeraFilterCounters[0];
    _HeraDrawIndirectArgs[1] = 1u;
    _HeraDrawIndirectArgs[2] = 0u;
    _HeraDrawIndirectArgs[3] = 0u;
    _HeraDrawIndirectArgs[4] = 0u;
}

[numthreads(1, 1, 1)]
void BuildHeraInteriorShadowArgs(uint3 id : SV_DispatchThreadID)
{
    _HeraInteriorShadowDrawIndirectArgs[0] = _HeraFilterCounters[19];
    _HeraInteriorShadowDrawIndirectArgs[1] = 1u;
    _HeraInteriorShadowDrawIndirectArgs[2] = 0u;
    _HeraInteriorShadowDrawIndirectArgs[3] = 0u;
    _HeraInteriorShadowDrawIndirectArgs[4] = 0u;
}

[numthreads(1, 1, 1)]
void BuildHeraBoundaryShadowArgs(uint3 id : SV_DispatchThreadID)
{
    _HeraBoundaryShadowDrawIndirectArgs[0] = _HeraFilterCounters[20];
    _HeraBoundaryShadowDrawIndirectArgs[1] = 1u;
    _HeraBoundaryShadowDrawIndirectArgs[2] = 0u;
    _HeraBoundaryShadowDrawIndirectArgs[3] = 0u;
    _HeraBoundaryShadowDrawIndirectArgs[4] = 0u;
}

// ══════════════════════════════════════════════════════════════════
//  Kernel 9 : InitTemporal
//  Sets all voxels in _TemporalState to (0,0,0,-1) (uninitialized)
// ══════════════════════════════════════════════════════════════════
[numthreads(4, 4, 4)]
void InitTemporal(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_MapCount)) return;
    _TemporalState[id] = float4(0, 0, 0, -1);
}
